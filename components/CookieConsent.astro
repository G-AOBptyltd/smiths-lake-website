---
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
  aria-modal="false"
  hidden
>
  <div class="cookie-content">
    <div class="cookie-text">
      <h3 id="cookie-title" class="cookie-title">Cookie Notice</h3>
      <p id="cookie-description" class="cookie-description">
        We use cookies to analyse website traffic and improve your experience.
        By clicking "Accept", you consent to our use of analytics cookies.
        <a href="/privacy/" class="cookie-link">Learn more in our Privacy Policy</a>
      </p>
    </div>

    <div class="cookie-actions">
      <button type="button" class="cookie-btn cookie-btn--decline" id="cookie-decline">
        Decline
      </button>
      <button type="button" class="cookie-btn cookie-btn--accept" id="cookie-accept">
        Accept
      </button>
    </div>
  </div>
</div>

<style>
  /* Your existing CSS — unchanged */
  .cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-4);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
    z-index: var(--z-modal);
    transform: translateY(100%);
    transition: transform var(--transition-normal);
  }

  .cookie-consent.is-visible { transform: translateY(0); }
  .cookie-consent[hidden] { display: none; }

  .cookie-content {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .cookie-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cookie-text { flex: 1; }

  .cookie-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .cookie-description {
    font-size: var(--text-sm);
    color: var(--color-gray-200);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .cookie-link {
    color: var(--color-sky-light);
    text-decoration: underline;
  }

  .cookie-link:hover { color: var(--color-white); }

  .cookie-actions {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .cookie-btn {
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    border: 2px solid transparent;
    min-height: 44px;
  }

  .cookie-btn:focus-visible {
    outline: 3px solid var(--color-golden);
    outline-offset: 2px;
  }

  .cookie-btn--decline {
    background-color: transparent;
    color: var(--color-white);
    border-color: var(--color-gray-400);
  }

  .cookie-btn--decline:hover {
    background-color: var(--color-navy-light);
    border-color: var(--color-white);
  }

  .cookie-btn--accept {
    background-color: var(--color-golden);
    color: var(--color-navy);
    border-color: var(--color-golden);
  }

  .cookie-btn--accept:hover {
    background-color: var(--color-golden-dark);
    border-color: var(--color-golden-dark);
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById("cookie-consent");
    var acceptBtn = document.getElementById("cookie-accept");
    var declineBtn = document.getElementById("cookie-decline");

    var CONSENT_KEY = "cookieConsent";
    var consent = localStorage.getItem(CONSENT_KEY);

    if (!consent && banner) {
      setTimeout(function () {
        banner.hidden = false;
        requestAnimationFrame(function () {
          banner.classList.add("is-visible");
        });
      }, 1000);
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.remove("is-visible");
      setTimeout(function () {
        banner.hidden = true;
      }, 300);
    }

    if (acceptBtn) {
      acceptBtn.addEventListener("click", function () {
        localStorage.setItem(CONSENT_KEY, "accepted");
        hideBanner();
        window.dispatchEvent(new Event("cookie-consent-accepted"));
      });
    }

    if (declineBtn) {
      declineBtn.addEventListener("click", function () {
        localStorage.setItem(CONSENT_KEY, "declined");
        hideBanner();
        window.dispatchEvent(new Event("cookie-consent-declined"));
      });
    }
  })();
</script>
