---
/**
 * DetailPage - Universal Detail Page Component
 * 
 * Renders a full detail page for any community content item.
 * Adapts layout based on section type and available data.
 * Inspired by the Project Hub detail page but generalised.
 * 
 * Sections rendered:
 * - Hero with angled design (accent colour from section settings)
 * - Breadcrumb navigation
 * - Main content area with description
 * - Sidebar with metadata, contact info, documents, links
 * - Back to section link
 * 
 * @version 1.0
 * @created February 2026
 */

import { getSmartIcon } from '../lib/icon-matcher.js';

interface MetadataItem {
  label: string;
  value: string;
  icon: string;
  type: string;
}

interface Props {
  item: any;
  accentHex?: string;
}

const { item, accentHex } = Astro.props;

// Use section colour, prop override, or default navy
const heroAccent = accentHex || item.sectionColour?.hex || '#1B365D';

// Smart icon for this item
const itemIcon = getSmartIcon(item);

// Build document list
const documents = [];
if (item.documentUrl) {
  documents.push({
    title: item.documentTitle || item.title || 'View Document',
    url: item.documentUrl,
  });
}
if (item.groupInfoDocumentUrl && item.groupInfoDocumentUrl !== item.documentUrl) {
  documents.push({
    title: 'Group Information',
    url: item.groupInfoDocumentUrl,
  });
}

// Contact info (only if allowed publicly)
const showContact = item.showContactPublicly !== 'FALSE';
const contactPerson = showContact ? (item.contactPerson || item.relatedPeople) : null;
const contactEmail = showContact ? item.contactEmail : null;
const contactPhone = showContact ? item.contactPhone : null;

// External links
const websiteUrl = item.websiteUrl || null;
const facebookUrl = item.facebookUrl || null;

// Emergency phone (always shown for emergency section)
const emergencyPhone = item.emergencyPhone || null;

// Notes / extended content
const hasNotes = item.notes && item.notes.trim().length > 0;

// Meeting schedule summary
function formatSchedule(item) {
  const parts = [];
  if (item.eventFrequency) {
    const freq = Array.isArray(item.eventFrequency) ? item.eventFrequency.join(', ') : item.eventFrequency;
    parts.push(freq);
  }
  if (item.meetingDay) parts.push(item.meetingDay);
  if (item.operatingHours) parts.push(item.operatingHours);
  return parts.join(' · ');
}

const schedule = formatSchedule(item);

// Hex to RGBA helper
function hexToRgba(hex, alpha) {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

// Page metadata
const pageTitle = `${item.title} | ${item.sectionDisplay}`;
const pageDescription = item.description || `${item.title} - ${item.sectionDisplay} at Smiths Lake Village.`;
---

<main class="detail-page" id="main-content">
  
  <!-- Hero Section -->
  <section class="detail-hero" style={`background: linear-gradient(135deg, ${heroAccent} 0%, ${hexToRgba(heroAccent, 0.85)} 100%);`} aria-labelledby="detail-title">
    <div class="hero-content">
      <div class="hero-icon" aria-hidden="true">{itemIcon}</div>
      <div class="hero-text">
        {item.category && (
          <span class="hero-category">{item.category}</span>
        )}
        <h1 id="detail-title" class="hero-title">{item.title}</h1>
        {item.description && (
          <p class="hero-description">{item.description}</p>
        )}
        {Array.isArray(item.status) && item.status.length > 0 && (
          <div class="hero-badges">
            {item.status.map(s => (
              <span class={`hero-badge ${s.toLowerCase().replace(/\s+/g, '-')}`}>{s}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb navigation">
    <div class="breadcrumb-container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li><a href={`/${item.sectionPath}/`}>{item.sectionDisplay}</a></li>
        <li aria-current="page">{item.title}</li>
      </ol>
    </div>
  </nav>

  <!-- Main Content Area -->
  <div class={`content-wrapper ${item.hasSidebar ? 'has-sidebar' : 'full-width'}`}>
    
    <article class="main-content">
      
      <!-- Description Section -->
      {item.description && (
        <section class="content-section" aria-labelledby="about-heading">
          <h2 id="about-heading">About</h2>
          <div class="content-text">
            {item.description.split('\n\n').map(para => (
              <p>{para}</p>
            ))}
          </div>
        </section>
      )}

      <!-- Notes / Extended Content -->
      {hasNotes && (
        <section class="content-section" aria-labelledby="details-heading">
          <h2 id="details-heading">Details</h2>
          <div class="content-text">
            {item.notes.split('\n\n').map(para => (
              <p set:html={para.replace(/\n/g, '<br>')} />
            ))}
          </div>
        </section>
      )}

      <!-- Schedule & Meeting Info (Groups, Services) -->
      {(item.meetingDay || item.meetingLocation || item.operatingHours) && (
        <section class="content-section" aria-labelledby="schedule-heading">
          <h2 id="schedule-heading">
            {item.section === 'Groups & Activities' ? 'Meeting Schedule' : 'Schedule & Location'}
          </h2>
          <div class="info-grid">
            {item.meetingDay && (
              <div class="info-card">
                <span class="info-icon">📅</span>
                <div>
                  <strong>Day</strong>
                  <span>{item.meetingDay}</span>
                </div>
              </div>
            )}
            {schedule && (
              <div class="info-card">
                <span class="info-icon">🔄</span>
                <div>
                  <strong>Frequency</strong>
                  <span>{schedule}</span>
                </div>
              </div>
            )}
            {item.meetingLocation && (
              <div class="info-card">
                <span class="info-icon">📍</span>
                <div>
                  <strong>Location</strong>
                  <span>{item.meetingLocation}</span>
                </div>
              </div>
            )}
            {item.operatingHours && (
              <div class="info-card">
                <span class="info-icon">🕐</span>
                <div>
                  <strong>Hours</strong>
                  <span>{item.operatingHours}</span>
                </div>
              </div>
            )}
            {item.address && (
              <div class="info-card">
                <span class="info-icon">🏠</span>
                <div>
                  <strong>Address</strong>
                  <span>{item.address}</span>
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Emergency Alert Banner (Emergency section only) -->
      {item.alertLevel && item.alertLevel !== 'Normal' && (
        <div class={`alert-banner alert-${item.alertLevel.toLowerCase()}`} role="alert">
          <strong>⚠️ {item.alertLevel}</strong>
          {item.description && <p>{item.description}</p>}
          {emergencyPhone && (
            <p class="alert-phone">Emergency: <a href={`tel:${emergencyPhone}`}>{emergencyPhone}</a></p>
          )}
        </div>
      )}

      <!-- CTA Section -->
      <section class="cta-section">
        <a href={`/${item.sectionPath}/`} class="btn btn-outline">
          ← Back to {item.sectionDisplay}
        </a>
        {(websiteUrl || facebookUrl) && (
          <a href={websiteUrl || facebookUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            {websiteUrl ? 'Visit Website' : 'Visit Facebook Page'} ↗
          </a>
        )}
      </section>

    </article>

    <!-- Sidebar -->
    {item.hasSidebar && (
      <aside class="sidebar" aria-label={`${item.title} information`}>
        
        <!-- Item Info -->
        {item.metadata && item.metadata.length > 0 && (
          <div class="sidebar-section">
            <h3>Information</h3>
            <dl class="info-list">
              {item.metadata.map((meta: MetadataItem) => (
                <div class="info-row">
                  <dt>
                    <span class="meta-icon" aria-hidden="true">{meta.icon}</span>
                    {meta.label}:
                  </dt>
                  <dd>
                    {meta.type === 'phone' ? (
                      <a href={`tel:${meta.value}`}>{meta.value}</a>
                    ) : meta.type === 'alert' ? (
                      <span class={`alert-badge alert-${meta.value.toLowerCase()}`}>{meta.value}</span>
                    ) : meta.type === 'badges' ? (
                      <div class="badge-group">
                        {meta.value.split(', ').map(badge => (
                          <span class="sidebar-badge">{badge}</span>
                        ))}
                      </div>
                    ) : (
                      <span>{meta.value}</span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <!-- Contact Information -->
        {(contactPerson || contactEmail || contactPhone) && (
          <div class="sidebar-section">
            <h3>Contact</h3>
            <dl class="info-list">
              {contactPerson && (
                <div class="info-row">
                  <dt><span class="meta-icon" aria-hidden="true">👤</span> Name:</dt>
                  <dd>{contactPerson}</dd>
                </div>
              )}
              {contactEmail && (
                <div class="info-row">
                  <dt><span class="meta-icon" aria-hidden="true">✉️</span> Email:</dt>
                  <dd><a href={`mailto:${contactEmail}`}>{contactEmail}</a></dd>
                </div>
              )}
              {contactPhone && (
                <div class="info-row">
                  <dt><span class="meta-icon" aria-hidden="true">📞</span> Phone:</dt>
                  <dd><a href={`tel:${contactPhone}`}>{contactPhone}</a></dd>
                </div>
              )}
            </dl>
          </div>
        )}

        <!-- Document Library -->
        {documents.length > 0 && (
          <div class="sidebar-section">
            <h3>Documents</h3>
            <ul class="document-list">
              {documents.map(doc => (
                <li class="document-item">
                  <div class="document-icon" aria-hidden="true">📄</div>
                  <div class="document-info">
                    <span class="document-title">{doc.title}</span>
                  </div>
                  <a href={doc.url} class="document-link" target="_blank" rel="noopener noreferrer" aria-label={`Open ${doc.title}`}>
                    <span class="download-icon">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- External Links -->
        {(websiteUrl || facebookUrl) && (
          <div class="sidebar-section">
            <h3>Links</h3>
            <div class="sidebar-links">
              {websiteUrl && (
                <a href={websiteUrl} class="sidebar-link" target="_blank" rel="noopener noreferrer">
                  🌐 Website ↗
                </a>
              )}
              {facebookUrl && (
                <a href={facebookUrl} class="sidebar-link" target="_blank" rel="noopener noreferrer">
                  📘 Facebook ↗
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Back Link -->
        <div class="sidebar-back">
          <a href={`/${item.sectionPath}/`} class="back-link">← Back to {item.sectionDisplay}</a>
        </div>

      </aside>
    )}
  </div>

</main>

<style define:vars={{ accentHex: heroAccent }}>
  /* ========================================
     CSS VARIABLES
     ======================================== */
  :root {
    --accent: var(--accentHex);
    --navy-blue: #1B365D;
    --navy-blue-light: #2B4A7D;
    --sky-blue: #5B9BD5;
    --golden-orange: #F5A623;
    --white: #FFFFFF;
    --off-white: #F7F9FC;
    --light-gray: #E8EDF3;
    --medium-gray: #6B7280;
    --dark-gray: #374151;
    --black: #1F2937;
    --success-green: #2ecc71;
    --warning-orange: #f39c12;
    --error-red: #e74c3c;
  }

  /* ========================================
     HERO SECTION
     ======================================== */
  .detail-hero {
    position: relative;
    min-height: 220px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: var(--white);
    padding: 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-icon {
    font-size: 3rem;
    flex-shrink: 0;
    opacity: 0.9;
    margin-top: 0.25rem;
  }

  .hero-text {
    flex: 1;
  }

  .hero-category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.75rem;
    background: rgba(255, 255, 255, 0.2);
    color: var(--white);
  }

  .hero-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--white);
    margin: 0 0 0.75rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .hero-description {
    font-size: 1rem;
    opacity: 0.95;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 700px;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.2);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .hero-badge.active { background: var(--success-green); border-color: var(--success-green); }
  .hero-badge.open-to-new-participants { background: var(--success-green); border-color: var(--success-green); }

  /* ========================================
     BREADCRUMB
     ======================================== */
  .breadcrumb {
    background: var(--off-white);
    border-bottom: 1px solid var(--light-gray);
    padding: 0.75rem 2rem;
  }

  .breadcrumb-container { max-width: 1200px; margin: 0 auto; }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .breadcrumb-list li { display: flex; align-items: center; }
  .breadcrumb-list li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--medium-gray);
  }

  .breadcrumb-list a { color: var(--accentHex); text-decoration: none; }
  .breadcrumb-list a:hover { text-decoration: underline; }
  .breadcrumb-list [aria-current="page"] { color: var(--dark-gray); font-weight: 500; }

  /* ========================================
     CONTENT LAYOUT
     ======================================== */
  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    gap: 3rem;
  }

  .content-wrapper.has-sidebar {
    grid-template-columns: 1fr 320px;
  }

  .content-wrapper.full-width {
    grid-template-columns: 1fr;
    max-width: 860px;
  }

  .main-content { min-width: 0; }

  /* ========================================
     CONTENT SECTIONS
     ======================================== */
  .content-section {
    margin-bottom: 2.5rem;
  }

  .content-section h2 {
    font-size: 1.25rem;
    color: var(--navy-blue);
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--accentHex);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .content-text p {
    color: var(--dark-gray);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* ========================================
     INFO GRID (Schedule, Location, etc.)
     ======================================== */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--off-white);
    border-radius: 8px;
    border: 1px solid var(--light-gray);
  }

  .info-card .info-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .info-card strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--medium-gray);
    margin-bottom: 0.25rem;
  }

  .info-card span {
    color: var(--dark-gray);
    font-size: 0.95rem;
  }

  /* ========================================
     ALERT BANNER
     ======================================== */
  .alert-banner {
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    border-left: 4px solid;
  }

  .alert-emergency { background: #fef2f2; border-color: var(--error-red); color: #991b1b; }
  .alert-warning { background: #fffbeb; border-color: var(--warning-orange); color: #92400e; }
  .alert-watch { background: #eff6ff; border-color: #3b82f6; color: #1e40af; }

  .alert-phone a {
    font-weight: 700;
    color: inherit;
  }

  /* ========================================
     CTA SECTION
     ======================================== */
  .cta-section {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--light-gray);
    margin-top: 2rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 150ms ease;
    text-align: center;
  }

  .btn-primary {
    background: var(--accentHex);
    color: var(--white);
    border-color: var(--accentHex);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    color: var(--navy-blue);
    border-color: var(--navy-blue);
  }

  .btn-outline:hover {
    background: var(--navy-blue);
    color: var(--white);
  }

  /* ========================================
     SIDEBAR
     ======================================== */
  .sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .sidebar-section {
    background: var(--white);
    border: 1px solid var(--light-gray);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-section h3 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--navy-blue);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accentHex);
  }

  .info-list {
    margin: 0;
    padding: 0;
  }

  .info-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--light-gray);
  }

  .info-row:last-child { border-bottom: none; }

  .info-row dt {
    font-size: 0.8rem;
    color: var(--medium-gray);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .info-row dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--dark-gray);
  }

  .info-row dd a {
    color: var(--accentHex);
    text-decoration: none;
  }

  .info-row dd a:hover { text-decoration: underline; }

  .meta-icon { font-size: 0.9rem; }

  .badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sidebar-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--off-white);
    color: var(--dark-gray);
    border: 1px solid var(--light-gray);
  }

  .alert-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .alert-badge.alert-emergency { background: var(--error-red); color: var(--white); }
  .alert-badge.alert-warning { background: var(--warning-orange); color: var(--white); }
  .alert-badge.alert-watch { background: #3b82f6; color: var(--white); }

  /* Document List */
  .document-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .document-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--light-gray);
  }

  .document-item:last-child { border-bottom: none; }

  .document-icon { font-size: 1.25rem; }
  .document-title { font-size: 0.9rem; color: var(--dark-gray); flex: 1; }

  .document-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accentHex);
    color: var(--white);
    text-decoration: none;
    font-size: 1rem;
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .document-link:hover { transform: scale(1.1); }

  /* External Links */
  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.6rem 1rem;
    background: var(--off-white);
    border: 1px solid var(--light-gray);
    border-radius: 8px;
    color: var(--navy-blue);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 150ms ease;
  }

  .sidebar-link:hover {
    background: var(--light-gray);
    transform: translateX(2px);
  }

  /* Back Link */
  .sidebar-back {
    text-align: center;
    margin-top: 0.5rem;
  }

  .back-link {
    color: var(--medium-gray);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 150ms ease;
  }

  .back-link:hover { color: var(--navy-blue); }

  /* ========================================
     FOCUS STYLES (ACCESSIBILITY)
     ======================================== */
  a:focus-visible, button:focus-visible {
    outline: 3px solid var(--golden-orange);
    outline-offset: 2px;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 900px) {
    .content-wrapper.has-sidebar {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
    }

    .hero-content {
      padding: 2rem 1.5rem;
    }

    .hero-icon {
      font-size: 2.5rem;
    }

    .hero-title {
      font-size: 1.5rem;
    }

    .breadcrumb {
      padding: 0.75rem 1.5rem;
    }

    .content-wrapper {
      padding: 1.5rem;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .detail-hero {
      min-height: 180px;
    }

    .hero-content {
      flex-direction: column;
      padding: 1.5rem 1rem;
      gap: 0.75rem;
    }

    .hero-icon {
      font-size: 2rem;
    }

    .cta-section {
