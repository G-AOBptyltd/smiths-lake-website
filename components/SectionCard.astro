---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  variant?: 'default' | 'emergency';
}

const { title, description, href, icon, variant = 'default' } = Astro.props;

// Icon mapping
const icons: Record<string, string> = {
  about: `<path d="M24 4L4 20h6v20h28V20h6L24 4z" stroke="currentColor" stroke-width="2" fill="none"/>
          <rect x="18" y="28" width="12" height="12" stroke="currentColor" stroke-width="2"/>`,
  emergency: `<path d="M24 4L4 44h40L24 4z" stroke="currentColor" stroke-width="2" fill="none"/>
              <line x1="24" y1="18" x2="24" y2="30" stroke="currentColor" stroke-width="3"/>
              <circle cx="24" cy="36" r="2" fill="currentColor"/>`,
  services: `<circle cx="24" cy="14" r="8" stroke="currentColor" stroke-width="2" fill="none"/>
             <path d="M10 40c0-8 6-14 14-14s14 6 14 14" stroke="currentColor" stroke-width="2" fill="none"/>
             <circle cx="36" cy="32" r="6" stroke="currentColor" stroke-width="2" fill="none"/>
             <line x1="36" y1="29" x2="36" y2="35" stroke="currentColor" stroke-width="2"/>
             <line x1="33" y1="32" x2="39" y2="32" stroke="currentColor" stroke-width="2"/>`,
  groups: `<circle cx="16" cy="14" r="6" stroke="currentColor" stroke-width="2" fill="none"/>
           <circle cx="32" cy="14" r="6" stroke="currentColor" stroke-width="2" fill="none"/>
           <path d="M4 36c0-6 5-11 12-11s12 5 12 11" stroke="currentColor" stroke-width="2" fill="none"/>
           <path d="M20 36c0-6 5-11 12-11s12 5 12 11" stroke="currentColor" stroke-width="2" fill="none"/>`,
  environment: `<path d="M24 44V24" stroke="currentColor" stroke-width="2"/>
                <path d="M24 24c-8-8-8-16 0-20 8 4 8 12 0 20z" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M16 36c-4 0-8-4-8-8 0-6 8-8 16-8" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M32 36c4 0 8-4 8-8 0-6-8-8-16-8" stroke="currentColor" stroke-width="2" fill="none"/>`,
  history: `<circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2" fill="none"/>
            <line x1="24" y1="12" x2="24" y2="24" stroke="currentColor" stroke-width="2"/>
            <line x1="24" y1="24" x2="32" y2="28" stroke="currentColor" stroke-width="2"/>
            <circle cx="24" cy="24" r="3" fill="currentColor"/>`,
};
---

<article class={`section-card ${variant === 'emergency' ? 'section-card--emergency' : ''}`}>
  <div class="section-card__icon">
    <svg viewBox="0 0 48 48" fill="none" aria-hidden="true" set:html={icons[icon] || icons.about} />
  </div>
  <div class="section-card__content">
    <h3 class="section-card__title">{title}</h3>
    <p class="section-card__description">{description}</p>
    <a href={href} class="section-card__link">
      Learn more
      <span class="sr-only"> about {title}</span>
    </a>
  </div>
</article>

<style>
  .section-card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    border-top: 4px solid var(--color-sky);
  }
  
  .section-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .section-card--emergency {
    border-top-color: var(--color-error);
  }
  
  .section-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    color: var(--color-white);
  }
  
  .section-card--emergency .section-card__icon {
    background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  }
  
  .section-card__icon svg {
    width: 48px;
    height: 48px;
  }
  
  .section-card__content {
    padding: var(--space-6);
  }
  
  .section-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    color: var(--color-navy);
  }
  
  .section-card__description {
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
  }
  
  .section-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-golden-dark);
    font-weight: 600;
    text-decoration: none;
    font-size: var(--text-base);
  }
  
  .section-card__link:hover {
    color: var(--color-golden);
  }
  
  .section-card__link::after {
    content: '→';
    transition: transform var(--transition-fast);
  }
  
  .section-card__link:hover::after {
    transform: translateX(4px);
  }
  
  .section-card__link:focus-visible {
    outline: 2px solid var(--color-golden);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
