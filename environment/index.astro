---
// Environment & Sustainability Index Page - UPDATED 2026-02-24
// Updated: SectionHero component, Notion-managed hero images
import Layout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import { fetchNotionContent } from '../../lib/notion-unified.js';
import { fetchSectionSettingsBySlug } from '../../lib/notion-section-settings.js';
import { getSmartIcon } from '../../lib/icon-matcher.js';
import { generateSlug } from '../../lib/notion-detail-pages.js';

// Fetch section settings (hero image, title, accent colour)
const sectionSettings = await fetchSectionSettingsBySlug('environment');

// Load section hero image manifest (downloaded at build time)
let sectionHeroManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const manifestPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(manifestPath)) {
    sectionHeroManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

const heroImage = sectionHeroManifest['environment'] || null;

// Fetch Environment items
const items = await fetchNotionContent({ 
  section: 'Environment & Sustainability',
  requireShowOnWebsite: true
});
---

<Layout
  title="Environment & Sustainability"
  description="Lake health monitoring, conservation programs, and environmental initiatives"
>
  <style>
    .environment-page {
      background: #f7f9fc;
    }

    /* Content Sections */
    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .section-group {
      margin-bottom: 4rem;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-header h2 {
      color: #1B365D;
      font-size: 1.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #16a34a;
    }

    .section-intro {
      color: #4b5563;
      font-size: 1.0625rem;
      line-height: 1.6;
    }

    /* Programs Grid */
    .programs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    /* Program Card */
    .program-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .program-card.no-icon-header {
      border-top: 4px solid #16a34a;
    }

    .program-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .program-card.featured {
      border: 3px solid #F5A623;
      background: linear-gradient(to bottom, #FFF9E6 0%, white 100%);
    }

    .program-card.highlighted {
      border-left: 4px solid #F5A623;
    }

    /* Icon Header */
    .card-icon-header {
      padding: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
    }
    .card-icon-header.red { background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%); }
    .card-icon-header.blue { background: linear-gradient(135deg, #5B9BD5 0%, #7BB3E0 100%); }
    .card-icon-header.green { background: linear-gradient(135deg, #16A34A 0%, #22C55E 100%); }
    .card-icon-header.orange { background: linear-gradient(135deg, #F5A623 0%, #FB923C 100%); }
    .card-icon-header.purple { background: linear-gradient(135deg, #9333EA 0%, #A855F7 100%); }
    .card-icon-header.gray { background: linear-gradient(135deg, #4B5563 0%, #6B7280 100%); }

    .card-icon-header .icon-display {
      font-size: 1.5rem;
    }

    .card-content {
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1B365D;
      margin: 0 0 0.75rem 0;
      line-height: 1.3;
    }

    .card-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .badge.category { background: #D1FAE5; color: #065F46; }
    
    /* ✅ UPDATED: Generic status badge styling (all statuses shown) */
    .badge.status { background: #DBEAFE; color: #1E40AF; }

    .card-description {
      color: #4b5563;
      line-height: 1.6;
      margin-bottom: 1rem;
      flex: 1;
    }

    .card-metadata {
      border-top: 1px solid #f3f4f6;
      padding-top: 1rem;
      margin-top: auto;
      font-size: 0.875rem;
    }

    .meta-row {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      color: #6B7280;
    }

    .meta-row:last-child {
      margin-bottom: 0;
    }

    .meta-icon {
      font-size: 1rem;
      flex-shrink: 0;
    }

    .meta-label {
      font-weight: 600;
      color: #1B365D;
    }

    .card-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      margin-top: 0.75rem;
      transition: color 0.2s;
    }

    .card-link-detail {
      color: #16a34a;
    }

    .card-link-detail:hover {
      color: #15803d;
    }

    .card-link-external {
      color: #6B7280;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .card-link-external:hover {
      color: #15803d;
    }

    .card-link-detail::after {
      content: '';
    }

    .card-link:hover {
      text-decoration: none;
    }

    .no-items {
      text-align: center;
      padding: 3rem;
      color: #6b7280;
      font-style: italic;
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
      .programs-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="environment-page">
    <!-- Hero Section -->
    <SectionHero
      title={sectionSettings?.heroTitle || 'Environment & Sustainability'}
      subtitle={sectionSettings?.heroSubtitle || 'Lake health monitoring, foreshore management, wildlife conservation, and environmental programs protecting our natural assets.'}
      accentHex={sectionSettings?.accentHex || '#16A34A'}
      backgroundImage={heroImage}
      overlayOpacity={sectionSettings?.overlayOpacity ?? 50}
    />

    <div class="content-section">
      {items.length > 0 ? (
        <div class="section-group">
          <div class="section-header">
            <h2>Active Programs</h2>
            <p class="section-intro">Our ongoing environmental initiatives and conservation efforts to protect and enhance Smiths Lake's natural environment.</p>
          </div>
          <div class="programs-grid">
            {items.map(program => {
              // Determine card template and options
              const template = program.cardTemplate || 'Standard';
              const options = program.cardOptions || [];
              
              // Build configuration
              const config = {
                showIconHeader: options.includes('Show Icon Header'),
                headerColor: options.includes('Red Header') ? 'red' :
                             options.includes('Blue Header') ? 'blue' :
                             options.includes('Green Header') ? 'green' :
                             options.includes('Orange Header') ? 'orange' :
                             options.includes('Purple Header') ? 'purple' :
                             options.includes('Gray Header') ? 'gray' : 'green', // Default to section color
                showSource: template === 'Rich' || template === 'Detailed' || template === 'Featured' || options.includes('Show Source'),
                showPeople: template === 'Detailed' || template === 'Featured' || options.includes('Show People'),
                showUpdated: template === 'Rich' || template === 'Detailed' || template === 'Featured' || options.includes('Show Updated Date'),
                showAllStatuses: template === 'Detailed' || template === 'Featured' || options.includes('Show All Statuses'),
                isHighlighted: options.includes('Highlight Card'),
                isFeatured: template === 'Featured',
                hideDescription: options.includes('Hide Description')
              };

              return (
                <article class={`program-card ${config.isFeatured ? 'featured' : ''} ${config.isHighlighted ? 'highlighted' : ''} ${!config.showIconHeader ? 'no-icon-header' : ''}`}>
                  
                  {config.showIconHeader && (
                    <div class={`card-icon-header ${config.headerColor}`}>
                      <span class="icon-display">{getSmartIcon(program)}</span>
                    </div>
                  )}

                  <div class="card-content">
                    <h3 class="card-title">{program.title}</h3>
                    <div class="card-badges">
                      {program.category && (
                        <span class="badge category">{program.category}</span>
                      )}
                      {/* ✅ UPDATED: Display ALL status values from Status / Stage / Phase array */}
                      {Array.isArray(program.status) && program.status.length > 0 && (
                        config.showAllStatuses ? 
                          program.status.map(s => (
                            <span class="badge status">{s}</span>
                          )) :
                          <span class="badge status">{program.status[0]}</span>
                      )}
                    </div>
                    
                    {!config.hideDescription && program.description && (
                      <p class="card-description">{program.description}</p>
                    )}
                    
                    {(program.locationArea || program.partnerOrganisations || program.meetingDay || config.showSource || config.showPeople || config.showUpdated) && (
                      <div class="card-metadata">
                        {program.locationArea && (
                          <div class="meta-row">
                            <span class="meta-icon">📍</span>
                            <span><span class="meta-label">Location:</span> {program.locationArea}</span>
                          </div>
                        )}
                        
                        {program.partnerOrganisations && (
                          <div class="meta-row">
                            <span class="meta-icon">🤝</span>
                            <span><span class="meta-label">Partners:</span> {program.partnerOrganisations}</span>
                          </div>
                        )}
                        
                        {program.meetingDay && (
                          <div class="meta-row">
                            <span class="meta-icon">{getSmartIcon(program)}</span>
                            <span><span class="meta-label">When:</span> {program.meetingDay}{program.meetingTime && ` at ${program.meetingTime}`}</span>
                          </div>
                        )}

                        {config.showSource && program.sourceAttribution && (
                          <div class="meta-row">
                            <span class="meta-icon">{getSmartIcon(program)}</span>
                            <span><span class="meta-label">Source:</span> {program.sourceAttribution}</span>
                          </div>
                        )}

                        {config.showPeople && program.relatedPeople && (
                          <div class="meta-row">
                            <span class="meta-icon">{getSmartIcon(program)}</span>
                            <span><span class="meta-label">People:</span> {program.relatedPeople}</span>
                          </div>
                        )}

                        {config.showUpdated && program.lastEditedTime && (
                          <div class="meta-row">
                            <span class="meta-icon">{getSmartIcon(program)}</span>
                            <span><span class="meta-label">Updated:</span> {new Date(program.lastEditedTime).toLocaleDateString('en-AU')}</span>
                          </div>
                        )}
                      </div>
                    )}
                    
                    {(program.websiteUrl || program.documentUrl) && (
                      <a 
                        href={program.websiteUrl || program.documentUrl} 
                        class="card-link card-link-external"
                        target="_blank"
                        rel="noopener"
                      >
                        {program.documentUrl ? 'View Document' : 'Learn More'} ↗
                      </a>
                    )}
                    <a 
                      href={`/environment/${program.slug || generateSlug(program.title)}/`}
                      class="card-link card-link-detail"
                    >
                      View Details →
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="no-items">
          <p>Environmental information is being updated. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
