---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const initiatives = [
  {
    title: 'Lake Health Monitoring',
    description: 'Regular monitoring of water quality, fish populations, and ecosystem health in Smiths Lake.',
    icon: '💧',
  },
  {
    title: 'Green Space Management',
    description: 'Maintaining and improving our parks, reserves, and natural areas for community enjoyment.',
    icon: '🌳',
  },
  {
    title: 'Conservation Programs',
    description: 'Protecting native flora and fauna, including threatened species in our local area.',
    icon: '🦜',
  },
  {
    title: 'Foreshore Protection',
    description: 'Managing erosion, vegetation, and access along the lake foreshore.',
    icon: '🏖️',
  },
];
---

<BaseLayout 
  title="Environment & Conservation" 
  description="Lake health, conservation initiatives, and environmental programs in Smiths Lake."
>
  <Hero 
    title="Environment & Conservation"
    subtitle="Protecting and preserving our pristine natural environment for future generations."
    size="small"
  />
  
  <section class="section">
    <div class="container">
      <div class="intro">
        <p class="lead text-center">
          Smiths Lake is a remarkable coastal lagoon surrounded by native bushland, 
          wetlands, and the Myall Lakes National Park. Our community is committed to 
          preserving this natural treasure.
        </p>
      </div>
      
      <div class="initiatives-grid">
        {initiatives.map((initiative) => (
          <article class="initiative-card">
            <span class="initiative-icon" aria-hidden="true">{initiative.icon}</span>
            <h3>{initiative.title}</h3>
            <p>{initiative.description}</p>
          </article>
        ))}
      </div>
      
      <div class="lake-info">
        <h2>About Smiths Lake</h2>
        <div class="lake-facts">
          <p>
            Smiths Lake is an Intermittently Closed and Open Lake or Lagoon (ICOLL), 
            meaning it periodically opens to the sea. This unique hydrology creates 
            a diverse ecosystem supporting fish, birds, and marine life.
          </p>
          <p>
            The lake and surrounding areas are part of the traditional lands of the 
            Worimi people, who have cared for this country for thousands of years.
          </p>
        </div>
      </div>
      
      <aside class="action-section">
        <h2>How You Can Help</h2>
        <ul>
          <li>Report pollution or environmental concerns to MidCoast Council</li>
          <li>Join local clean-up events and working bees</li>
          <li>Use eco-friendly products that won't harm waterways</li>
          <li>Respect wildlife and their habitats</li>
          <li>Support native plant regeneration on your property</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 800px;
    margin: 0 auto var(--space-12);
  }
  
  .lead {
    font-size: var(--text-xl);
    color: var(--color-gray-700);
    line-height: var(--leading-relaxed);
  }
  
  .initiatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
  
  .initiative-card {
    background: var(--color-off-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--color-success);
    text-align: center;
  }
  
  .initiative-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-4);
  }
  
  .initiative-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }
  
  .initiative-card p {
    color: var(--color-gray-600);
    margin: 0;
  }
  
  .lake-info {
    background: var(--color-sky-pale);
    padding: var(--space-10);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-12);
  }
  
  .lake-info h2 {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  
  .lake-facts {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .lake-facts p {
    color: var(--color-gray-700);
    line-height: var(--leading-relaxed);
  }
  
  .action-section {
    background: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
  }
  
  .action-section h2 {
    color: var(--color-white);
    margin-bottom: var(--space-6);
    text-align: center;
  }
  
  .action-section ul {
    max-width: 500px;
    margin: 0 auto;
    padding-left: var(--space-6);
  }
  
  .action-section li {
    color: var(--color-gray-200);
    margin-bottom: var(--space-3);
  }
</style>
