---
/**
 * Environment & Sustainability - Detail Page
 * Dynamic route: /environment/[slug]/
 * 
 * @version 1.0
 * @created February 2026
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPage from '../../components/DetailPage.astro';
import { fetchDetailPageItems } from '../../lib/notion-detail-pages.js';
import { fetchSectionSettingsBySlug } from '../../lib/notion-section-settings.js';

const SECTION_NAME = 'Environment & Sustainability';

export async function getStaticPaths() {
  let items = [];
  try {
    items = await fetchDetailPageItems(SECTION_NAME);
  } catch (error) {
    console.error('Error fetching environment items for static paths:', error);
  }

  return items.map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;

if (!item) {
  return Astro.redirect('/environment/');
}

let accentHex = item.sectionColour?.hex || '#16A34A';
try {
  const sectionSettings = await fetchSectionSettingsBySlug('environment');
  if (sectionSettings?.accentHex) {
    accentHex = sectionSettings.accentHex;
  }
} catch (e) {}

const pageTitle = `${item.title} | Environment & Sustainability`;
const pageDescription = item.description || `${item.title} - Environment & Sustainability at Smiths Lake Village.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <DetailPage item={item} accentHex={accentHex} />
</BaseLayout>
