---
// Services Index Page - Simplified
import Layout from '../../layouts/BaseLayout.astro';
import ExpandableCard from '../../components/ExpandableCard.astro';
import ProjectStatusRegister from '../../components/ProjectStatusRegister.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch all Services items
const items = await fetchItemsBySection('Services');

// Group by service type - anything NOT an amenity is a project
const amenities = items.filter(item => 
  item.serviceType === 'Amenity' || item.category === 'Amenities'
);
const projects = items.filter(item => 
  item.serviceType !== 'Amenity' && item.category !== 'Amenities'
);
---

<Layout 
  title="Services"
  description="Community services, amenities, and development projects in Smiths Lake"
>
  <style>
    .services-page {
      background: #f7f9fc;
      padding: 2rem 0;
    }
    .services-hero {
      background: #1B365D;
      color: white;
      padding: 3rem 1rem;
      text-align: center;
      margin-bottom: 2rem;
    }
    .services-hero h1 {
      color: white;
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    .section-group {
      margin-bottom: 3rem;
    }
    .section-group h2 {
      color: #1B365D;
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #1B365D;
    }
    .items-grid {
      display: grid;
      gap: 1.5rem;
    }
    .no-items {
      padding: 2rem;
      background: white;
      border-radius: 8px;
      text-align: center;
      color: #6b7280;
    }
    .contact-box {
      background: #5B9BD5;
      color: white;
      padding: 2rem;
      border-radius: 8px;
      text-align: center;
      margin-top: 3rem;
    }
    .contact-box h3 {
      color: white;
      margin-bottom: 1rem;
    }
    .contact-box a {
      color: white;
      font-weight: bold;
      text-decoration: underline;
    }
  </style>

  <div class="services-page">
    <div class="services-hero">
      <h1>Community Services</h1>
      <p>Facilities, amenities, and community projects in Smiths Lake Village</p>
    </div>
    
    <div class="content-section">
      {amenities.length > 0 && (
        <div class="section-group">
          <h2>Existing Amenities</h2>
          <p style="margin-bottom: 1.5rem;">Smiths Lake Village offers essential services and amenities for residents and visitors.</p>
          <div class="items-grid">
            {amenities.map(item => (
              <ExpandableCard item={item} section="Services" />
            ))}
          </div>
        </div>
      )}
      
      {projects.length > 0 && (
        <div class="section-group">
          <h2>Developing Projects</h2>
          <p style="margin-bottom: 1.5rem;">The community is actively working on several projects to improve our village.</p>
          
          <ProjectStatusRegister projects={projects} />
          
          <details style="margin-top: 2rem;">
            <summary style="cursor: pointer; font-weight: 600; color: #1B365D; padding: 1rem; background: #f3f4f6; border-radius: 8px;">
              View Detailed Project Information
            </summary>
            <div style="margin-top: 1rem;" class="items-grid">
              {projects.map(item => (
                <ExpandableCard item={item} section="Services" />
              ))}
            </div>
          </details>
        </div>
      )}
      
      {items.length === 0 && (
        <div class="no-items">
          <p>Services information is being updated. Check back soon.</p>
        </div>
      )}
      
      <div class="contact-box">
        <h3>Need More Information?</h3>
        <p>Contact PPCA for inquiries about services and facilities.</p>
        <p><a href="mailto:info@pacificpalms.org.au">info@pacificpalms.org.au</a></p>
      </div>
    </div>
  </div>
</Layout>
