---
// Services Index Page
import Layout from '../../layouts/Layout.astro';
import ExpandableCard from '../../components/ExpandableCard.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch all Services items
const items = await fetchItemsBySection('Services');

// Group by service type
const amenities = items.filter(item => 
  item.serviceType === 'Amenity' || item.category === 'Amenities'
);
const projects = items.filter(item => 
  item.serviceType === 'Developing Project' || 
  item.serviceType === 'Proposed Project' || 
  item.category === 'Projects'
);
---

<Layout 
  title="Community Services | Smiths Lake Village"
  description="Community services, amenities, and development projects in Smiths Lake"
>
  <div class="bg-gray-50 min-h-screen">
    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white py-12">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">Community Services</h1>
        <p class="text-xl text-blue-100 max-w-3xl">
          Local services, amenities, and community development projects serving the Smiths Lake area.
        </p>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="container mx-auto px-4 py-12">
      
      <!-- Amenities Section -->
      {amenities.length > 0 && (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-4xl">🏢</span>
            <div>
              <h2 class="text-2xl font-bold text-gray-900">Community Amenities</h2>
              <p class="text-gray-600">Local facilities and services available to the community</p>
            </div>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            {amenities.map(item => (
              <ExpandableCard item={item} sectionSlug="services" />
            ))}
          </div>
        </section>
      )}
      
      <!-- Projects Section -->
      {projects.length > 0 && (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-4xl">🏗️</span>
            <div>
              <h2 class="text-2xl font-bold text-gray-900">Development Projects</h2>
              <p class="text-gray-600">Current and proposed projects for community improvement</p>
            </div>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            {projects.map(item => (
              <ExpandableCard item={item} sectionSlug="services" />
            ))}
          </div>
        </section>
      )}
      
      <!-- Contact PPCA -->
      <section class="bg-blue-50 border border-blue-200 rounded-lg p-6 mt-12">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h3 class="font-semibold text-blue-900 mb-2">Need a Service Not Listed?</h3>
            <p class="text-blue-800 text-sm mb-3 leading-relaxed">
              If you're looking for a specific service or want to suggest a new community amenity, 
              please get in touch with the Pacific Palms Community Association.
            </p>
            <a 
              href="/contact" 
              class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium"
            >
              Contact PPCA
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </section>
      
      <!-- No Content Message -->
      {items.length === 0 && (
        <div class="text-center py-12">
          <div class="text-gray-400 text-6xl mb-4">🏢</div>
          <p class="text-gray-600 text-lg mb-2">Services information is being updated.</p>
          <p class="text-gray-500">Check back soon for details on community amenities and projects.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
