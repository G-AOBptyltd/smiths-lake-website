---
// ExpandableCard.astro - Simple expandable card
import StatusBadge from './StatusBadge.astro';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  item: any;
  section: string;
}

const { item, section } = Astro.props;

// Generate unique ID for this card
const cardId = `card-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="expandable-card" data-card-id={cardId}>
  <div class="card-header">
    <div class="card-title-row">
      <h3 class="card-title">{item.title}</h3>
      <button class="expand-btn" data-target={cardId} aria-label="Expand details">
        <span class="expand-icon">+</span>
      </button>
    </div>
    <div class="card-badges">
      <CategoryBadge category={item.category} size="sm" />
      {item.status && <StatusBadge status={item.status} />}
    </div>
  </div>
  
  <div class="card-content" id={cardId} style="display: none;">
    {item.description && (
      <div class="content-section">
        <p>{item.description}</p>
      </div>
    )}
    
    {item.meetingDay && (
      <div class="content-section">
        <strong>Meeting Time:</strong> {item.meetingDay}
        {item.meetingTime && ` at ${item.meetingTime}`}
        {item.meetingLocation && ` - ${item.meetingLocation}`}
      </div>
    )}
    
    {item.operatingHours && (
      <div class="content-section">
        <strong>Hours:</strong> {item.operatingHours}
      </div>
    )}
    
    {item.address && (
      <div class="content-section">
        <strong>Address:</strong> {item.address}
      </div>
    )}
    
    {item.contactPerson && item.showContactPublicly && (
      <div class="content-section">
        <strong>Contact:</strong> {item.contactPerson}
        {item.contactEmail && (
          <> - <a href={`mailto:${item.contactEmail}`}>{item.contactEmail}</a></>
        )}
        {item.contactPhone && (
          <> - <a href={`tel:${item.contactPhone}`}>{item.contactPhone}</a></>
        )}
      </div>
    )}
    
    {item.websiteUrl && (
      <div class="content-section">
        <a href={item.websiteUrl} target="_blank" rel="noopener noreferrer" class="external-link">
          Visit Website →
        </a>
      </div>
    )}
    
    {item.emergencyPhone && (
      <div class="content-section emergency-contact">
        <strong>Emergency:</strong> <a href={`tel:${item.emergencyPhone}`}>{item.emergencyPhone}</a>
      </div>
    )}
  </div>
</div>

<style>
  .expandable-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .expandable-card:hover {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  .card-header {
    padding: 1.5rem;
    border-bottom: 1px solid #f3f4f6;
  }
  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .card-title {
    color: #1B365D;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    flex: 1;
  }
  .expand-btn {
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .expand-btn:hover {
    background: #e5e7eb;
  }
  .expand-icon {
    font-size: 1.5rem;
    font-weight: bold;
    color: #1B365D;
    transition: transform 0.2s;
  }
  .expand-btn.expanded .expand-icon {
    transform: rotate(45deg);
  }
  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .card-content {
    padding: 1.5rem;
    background: #f9fafb;
  }
  .content-section {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .content-section:last-child {
    margin-bottom: 0;
  }
  .content-section strong {
    color: #1B365D;
    display: block;
    margin-bottom: 0.25rem;
  }
  .external-link {
    color: #5B9BD5;
    font-weight: 600;
    text-decoration: none;
  }
  .external-link:hover {
    text-decoration: underline;
  }
  .emergency-contact {
    background: #fee2e2;
    padding: 1rem;
    border-radius: 6px;
    border-left: 4px solid #dc2626;
  }
  .emergency-contact strong {
    color: #dc2626;
  }
  .emergency-contact a {
    color: #dc2626;
    font-weight: bold;
    font-size: 1.125rem;
  }
</style>

<script>
  // Simple expand/collapse functionality
  document.querySelectorAll('.expand-btn').forEach(button => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-target');
      const content = document.getElementById(targetId);
      const icon = button.querySelector('.expand-icon');
      
      if (content.style.display === 'none') {
        content.style.display = 'block';
        button.classList.add('expanded');
        button.setAttribute('aria-expanded', 'true');
      } else {
        content.style.display = 'none';
        button.classList.remove('expanded');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
