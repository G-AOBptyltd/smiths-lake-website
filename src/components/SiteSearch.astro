---
// SiteSearch.astro - Client-side search component
// Searches across all published content from search.json
---

<div id="site-search" class="relative">
  <!-- Search Button (triggers modal) -->
  <button 
    id="search-trigger"
    class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-sm"
    aria-label="Search site"
  >
    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <span class="text-gray-700 hidden sm:inline">Search</span>
    <kbd class="hidden md:inline-block px-2 py-0.5 text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-300 rounded">
      ⌘K
    </kbd>
  </button>
  
  <!-- Search Modal -->
  <div 
    id="search-modal" 
    class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-title"
  >
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[80vh] flex flex-col">
      <!-- Search Header -->
      <div class="p-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search community information..."
            class="flex-1 text-lg border-none focus:ring-0 focus:outline-none"
            aria-label="Search input"
          />
          <button 
            id="search-close"
            class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Close search"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search Results -->
      <div id="search-results" class="flex-1 overflow-y-auto p-4">
        <div id="search-empty" class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <p class="text-lg font-medium mb-2">Start typing to search</p>
          <p class="text-sm">Search across all community information, services, and groups</p>
        </div>
        
        <div id="search-no-results" class="hidden text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-lg font-medium mb-2">No results found</p>
          <p class="text-sm">Try different keywords or check spelling</p>
        </div>
        
        <div id="search-results-list"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Search functionality
  let searchIndex: any[] = [];
  let isSearchOpen = false;
  
  // Fetch search index
  async function loadSearchIndex() {
    try {
      const response = await fetch('/search.json');
      searchIndex = await response.json();
    } catch (error) {
      console.error('Failed to load search index:', error);
    }
  }
  
  // Open search modal
  function openSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    input?.focus();
    isSearchOpen = true;
    document.body.style.overflow = 'hidden';
  }
  
  // Close search modal
  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    if (input) input.value = '';
    performSearch('');
    isSearchOpen = false;
    document.body.style.overflow = '';
  }
  
  // Perform search
  function performSearch(query: string) {
    const resultsContainer = document.getElementById('search-results-list');
    const emptyState = document.getElementById('search-empty');
    const noResults = document.getElementById('search-no-results');
    
    if (!resultsContainer || !emptyState || !noResults) return;
    
    // Clear previous results
    resultsContainer.innerHTML = '';
    
    // Show empty state if no query
    if (!query.trim()) {
      emptyState.classList.remove('hidden');
      noResults.classList.add('hidden');
      resultsContainer.classList.add('hidden');
      return;
    }
    
    emptyState.classList.add('hidden');
    resultsContainer.classList.remove('hidden');
    
    // Search logic
    const lowerQuery = query.toLowerCase();
    const results = searchIndex.filter(item => {
      const titleMatch = item.title.toLowerCase().includes(lowerQuery);
      const descMatch = item.description?.toLowerCase().includes(lowerQuery) || false;
      const categoryMatch = item.category?.toLowerCase().includes(lowerQuery) || false;
      return titleMatch || descMatch || categoryMatch;
    });
    
    // Show no results state
    if (results.length === 0) {
      noResults.classList.remove('hidden');
      resultsContainer.classList.add('hidden');
      return;
    }
    
    noResults.classList.add('hidden');
    
    // Group results by section
    const grouped: Record<string, any[]> = {};
    results.forEach(item => {
      if (!grouped[item.section]) {
        grouped[item.section] = [];
      }
      grouped[item.section].push(item);
    });
    
    // Render results
    Object.entries(grouped).forEach(([section, items]) => {
      const sectionDiv = document.createElement('div');
      sectionDiv.className = 'mb-6';
      
      const sectionTitle = document.createElement('h3');
      sectionTitle.className = 'text-sm font-semibold text-gray-600 mb-3 px-2';
      sectionTitle.textContent = section;
      sectionDiv.appendChild(sectionTitle);
      
      items.forEach(item => {
        const resultDiv = document.createElement('a');
        resultDiv.href = item.url;
        resultDiv.className = 'block p-3 rounded-lg hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-200';
        
        resultDiv.innerHTML = `
          <div class="font-medium text-gray-900 mb-1">${highlightMatch(item.title, query)}</div>
          ${item.category ? `<div class="text-xs text-gray-500 mb-1">${item.category}</div>` : ''}
          ${item.description ? `<div class="text-sm text-gray-600 line-clamp-2">${highlightMatch(truncate(item.description, 120), query)}</div>` : ''}
        `;
        
        sectionDiv.appendChild(resultDiv);
      });
      
      resultsContainer.appendChild(sectionDiv);
    });
  }
  
  // Highlight matching text
  function highlightMatch(text: string, query: string): string {
    if (!query.trim()) return text;
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<mark class="bg-yellow-200">$1</mark>');
  }
  
  // Truncate text
  function truncate(text: string, length: number): string {
    if (text.length <= length) return text;
    return text.substring(0, length) + '...';
  }
  
  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    loadSearchIndex();
    
    // Search trigger
    const trigger = document.getElementById('search-trigger');
    trigger?.addEventListener('click', openSearch);
    
    // Close button
    const closeBtn = document.getElementById('search-close');
    closeBtn?.addEventListener('click', closeSearch);
    
    // Click outside modal
    const modal = document.getElementById('search-modal');
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });
    
    // Search input
    const input = document.getElementById('search-input') as HTMLInputElement;
    input?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value);
    });
    
    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // ⌘K or Ctrl+K to open
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
      
      // Escape to close
      if (e.key === 'Escape' && isSearchOpen) {
        closeSearch();
      }
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
