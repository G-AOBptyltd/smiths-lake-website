---
/**
 * DocumentLibrary.astro
 * Reusable Notion-powered document list
 */

import { getDocuments } from "../lib/notionDocuments";

interface Props {
  /** Must exactly match a Notion multi-select value in "Display Locations" */
  displayLocation: string;

  /** Document Audience filter */
  audience?: "Public" | "Members";

  /** Section heading */
  title?: string;

  /** Optional intro text */
  subtitle?: string;

  /** Show document summary text */
  showSummary?: boolean;

  /** Anchor ID for deep links */
  anchorId?: string;
}

const {
  displayLocation,
  audience = "Public",
  title = "Document Library",
  subtitle = "Access official PPCA documents and reference materials.",
  showSummary = true,
  anchorId = "documents",
} = Astro.props as Props;

const documents = await getDocuments(displayLocation, audience);

// Precompute flags outside the template to keep the compiler happy
const docs = (documents || []).map((doc) => ({
  ...doc,
  hasUrl: Boolean(doc?.url && String(doc.url).trim().length > 0),
}));
---

<section id={anchorId} class="doclib">
  <header class="doclib-header">
    <div class="doclib-icon" aria-hidden="true">📚</div>
    <div>
      <h2 class="doclib-title">{title}</h2>
      {subtitle ? <p class="doclib-subtitle">{subtitle}</p> : null}
    </div>
  </header>

  <div class="doclib-list">
    {docs.length > 0 ? (
      docs.map((doc) => (
        <article class="doclib-item">
          <div class="doclib-fileicon" aria-hidden="true">📄</div>

          <div class="doclib-info">
            <h3 class="doclib-name">{doc.title}</h3>

            <div class="doclib-meta">
              {doc.lastEdited ? <span>📅 Last updated: {doc.lastEdited}</span> : null}
              {doc.editedBy ? <span>👤 {doc.editedBy}</span> : null}
              {doc.category ? <span>🏷️ {doc.category}</span> : null}
            </div>

            {showSummary && doc.summary ? (
              <p class="doclib-summary">{doc.summary}</p>
            ) : null}
          </div>

          {doc.hasUrl ? (
            <a class="doclib-btn" href={doc.url} target="_blank" rel="noopener">
              View / Download
            </a>
          ) : (
            <span class="doclib-btn doclib-btn-disabled" aria-disabled="true">
              No link
            </span>
          )}
        </article>
      ))
    ) : (
      <div class="doclib-empty">No documents are currently available.</div>
    )}
  </div>

  <footer class="doclib-footer">
    Documents are managed in Notion using
    <strong> Show on Website</strong>, <strong> Display Locations</strong>, and
    <strong> Document Audience</strong>.
  </footer>
</section>

<style>
  .doclib {
    background: white;
    padding: 3rem;
    border-radius: 12px;
    border-left: 6px solid #5B9BD5;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .doclib-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .doclib-icon {
    font-size: 2.5rem;
  }

  .doclib-title {
    margin: 0 0 0.25rem;
    color: #1B365D;
    font-size: 1.75rem;
  }

  .doclib-subtitle {
    margin: 0;
    color: #6b7280;
    font-size: 1rem;
  }

  .doclib-list {
    display: grid;
    gap: 1rem;
  }

  .doclib-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    padding: 1.25rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .doclib-item:hover {
    background: #f3f4f6;
    border-color: #5B9BD5;
    transform: translateX(4px);
  }

  .doclib-fileicon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #5B9BD5, #1B365D);
    color: white;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .doclib-info {
    min-width: 0;
  }

  .doclib-name {
    margin: 0 0 0.5rem;
    color: #1B365D;
    font-size: 1.05rem;
  }

  .doclib-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .doclib-summary {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.5;
  }

  .doclib-btn {
    padding: 0.5rem 1rem;
    border: 2px solid #5B9BD5;
    border-radius: 6px;
    background: white;
    color: #5B9BD5;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
  }

  .doclib-btn:hover {
    background: #5B9BD5;
    color: white;
  }

  .doclib-btn-disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  .doclib-empty {
    padding: 1.25rem;
    color: #6b7280;
    background: #f9fafb;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
  }

  .doclib-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
    font-size: 0.9375rem;
    color: #6b7280;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .doclib {
      padding: 2rem 1.5rem;
    }

    .doclib-item {
      grid-template-columns: auto 1fr;
    }

    .doclib-btn {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
