---
/**
 * WaterLevelTicker.astro — slim, plain-language Smiths Lake level strip.
 *
 * Leads with the intuitive figure a resident understands at a glance: how far
 * the lake has risen toward the opening trigger (100% = the lake opens), plus a
 * status word. Metres AHD is kept as a small secondary detail for boat owners.
 * Reads the same /api/water-level proxy and links to the full Environment page.
 * Stays tidy in loading / live / unavailable states (never shows jargon).
 *
 * Usage:  <WaterLevelTicker />
 *         <WaterLevelTicker refreshMinutes={60} href="/environment/#lake-level" />
 */
interface Props {
  refreshMinutes?: number;
  href?: string;
}
const { refreshMinutes = 90, href = '/environment/#lake-level' } = Astro.props;
---

<a
  class="wlt"
  data-water-ticker
  data-refresh={refreshMinutes}
  data-status="loading"
  href={href}
  aria-label="Smiths Lake live water level — view full status"
>
  <span class="wlt-ico" aria-hidden="true">🌊</span>
  <span class="wlt-label">Lake level</span>

  <span class="wlt-data">
    <span class="wlt-pct"><span data-wlt-pct>—</span>%</span>
    <span class="wlt-to">to opening</span>
    <span class="wlt-badge" data-wlt-status>Live</span>
    <span class="wlt-metres" data-wlt-metres></span>
  </span>

  <span class="wlt-msg" data-wlt-msg>Checking lake level…</span>
  <span class="wlt-cta">View status →</span>
</a>

<style>
  .wlt {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 680px;
    margin: 0 auto;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-left: 5px solid var(--color-sky);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .wlt:hover { box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12); transform: translateY(-1px); }
  .wlt[data-status='normal'] { border-left-color: var(--color-success); }
  .wlt[data-status='watch'] { border-left-color: var(--color-warning); }
  .wlt[data-status='near-trigger'] { border-left-color: var(--color-error); }
  .wlt[data-status='open'] { border-left-color: var(--color-sky); }

  .wlt-ico { font-size: 1.5rem; line-height: 1; }
  .wlt-label {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
    font-size: var(--text-base);
    white-space: nowrap;
  }

  .wlt-data { display: none; align-items: baseline; gap: var(--space-2) var(--space-3); flex-wrap: wrap; }
  .wlt[data-state='ready'] .wlt-data { display: inline-flex; }
  .wlt[data-state='ready'] .wlt-msg { display: none; }

  .wlt-pct {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
    font-size: var(--text-xl);
    line-height: 1;
    white-space: nowrap;
  }
  .wlt-to { font-size: var(--text-xs); color: var(--color-gray-500); }
  .wlt-badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 3px 12px;
    border-radius: var(--radius-md);
    background: var(--color-gray-100);
    color: var(--color-gray-600);
    white-space: nowrap;
  }
  .wlt[data-status='normal'] .wlt-badge { background: #D1FAE5; color: #065F46; }
  .wlt[data-status='watch'] .wlt-badge { background: #FEF3C7; color: #92400E; }
  .wlt[data-status='near-trigger'] .wlt-badge { background: #FEE2E2; color: #991B1B; }
  .wlt[data-status='open'] .wlt-badge { background: #DBEAFE; color: #1E40AF; }
  .wlt-metres { font-size: var(--text-xs); color: var(--color-gray-400); white-space: nowrap; }

  .wlt-msg { font-size: var(--text-sm); color: var(--color-gray-500); }

  .wlt-cta {
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-sky);
    white-space: nowrap;
  }
  .wlt:hover .wlt-cta { color: var(--color-navy); }

  @media (max-width: 620px) {
    .wlt { flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
    .wlt-metres { display: none; }
    .wlt-cta { margin-left: 0; }
  }
</style>

<script>
  async function loadTicker(el) {
    const pct = el.querySelector('[data-wlt-pct]');
    const st = el.querySelector('[data-wlt-status]');
    const metres = el.querySelector('[data-wlt-metres]');
    const msg = el.querySelector('[data-wlt-msg]');
    try {
      const res = await fetch('/api/water-level', { headers: { Accept: 'application/json' } });
      const d = await res.json();
      if (!d || d.ok === false) {
        el.setAttribute('data-state', 'error');
        el.setAttribute('data-status', 'loading');
        if (msg) msg.textContent = 'See current lake level';
        return;
      }
      el.setAttribute('data-status', d.status || 'normal');
      el.setAttribute('data-state', 'ready');
      if (pct) pct.textContent = String(d.percent != null ? d.percent : '—');
      if (st) st.textContent = d.statusLabel || 'Live';
      if (metres) metres.textContent = d.level != null ? '(' + Number(d.level).toFixed(2) + ' m)' : '';
    } catch (e) {
      el.setAttribute('data-state', 'error');
      el.setAttribute('data-status', 'loading');
      if (msg) msg.textContent = 'See current lake level';
    }
  }

  function initTickers() {
    document.querySelectorAll('[data-water-ticker]').forEach((el) => {
      loadTicker(el);
      const mins = Number(el.getAttribute('data-refresh')) || 90;
      setInterval(() => loadTicker(el), Math.max(15, mins) * 60 * 1000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTickers);
  } else {
    initTickers();
  }
</script>
