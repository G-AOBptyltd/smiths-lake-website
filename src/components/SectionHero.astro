---
/**
 * SectionHero - Shared hero component for all section landing pages
 * 
 * Features:
 * - Background image from Notion Section Settings (with gradient fallback)
 * - Section accent colour theming
 * - Consistent sizing across all section pages
 * - Responsive behaviour
 * - Accessible contrast ratios
 * 
 * @version 1.0
 * @created February 2026
 */

interface Props {
  title: string;
  subtitle?: string;
  accentHex?: string;
  backgroundImage?: string;
  overlayOpacity?: number; // 0-100: 0 = no overlay, 100 = solid colour. Default 50.
  size?: 'default' | 'large' | 'small';
}

const {
  title,
  subtitle,
  accentHex = '#1B365D',
  backgroundImage,
  overlayOpacity = 50,
  size = 'default',
} = Astro.props;

// Generate gradient colours from the accent hex
// We create a lighter variant for the gradient endpoint
function hexToRgba(hex: string, alpha: number): string {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

// Create a lighter shade for gradient endpoint
function lightenHexColour(hex: string, amount: number): string {
  const r = Math.min(255, parseInt(hex.slice(1, 3), 16) + amount);
  const g = Math.min(255, parseInt(hex.slice(3, 5), 16) + amount);
  const b = Math.min(255, parseInt(hex.slice(5, 7), 16) + amount);
  return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
}

// Convert 0-100 opacity scale to alpha values for the gradient
// Peak alpha = overlayOpacity / 100 (e.g., 50 → 0.5)
// Mid alpha = peak × 0.7 (e.g., 0.5 → 0.35)
// End alpha = peak × 0.45 (e.g., 0.5 → 0.225)
const peakAlpha = Math.max(0, Math.min(1, overlayOpacity / 100));
const midAlpha = peakAlpha * 0.7;
const endAlpha = peakAlpha * 0.45;

const overlayStart = hexToRgba(accentHex, peakAlpha);
const overlayMid = hexToRgba(accentHex, midAlpha);
const overlayEnd = hexToRgba(lightenHexColour(accentHex, 80), endAlpha);

// Fallback gradient when no image is set
const fallbackGradient = `linear-gradient(135deg, ${accentHex} 0%, ${lightenHexColour(accentHex, 40)} 100%)`;

const sizeClasses: Record<string, string> = {
  small: 'section-hero--small',
  default: '',
  large: 'section-hero--large',
};

const hasImage = !!backgroundImage;

// Responsive variants via Netlify Image CDN (local images only)
const isLocalImage = hasImage && backgroundImage.startsWith('/') && !backgroundImage.startsWith('//');
const heroSrcset = isLocalImage
  ? [480, 768, 1280, 1920].map((w) => `/.netlify/images?url=${encodeURIComponent(backgroundImage)}&w=${w}&q=70 ${w}w`).join(', ')
  : undefined;
---

<section class={`section-hero ${sizeClasses[size] || ''}`} data-has-image={hasImage ? 'true' : 'false'}>
  {hasImage ? (
    <div class="section-hero__background">
      <img
        src={backgroundImage}
        srcset={heroSrcset}
        sizes="100vw"
        alt=""
        class="section-hero__image"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div
      class="section-hero__overlay"
      style={`background: linear-gradient(135deg, ${overlayStart} 0%, ${overlayMid} 50%, ${overlayEnd} 100%);`}
    ></div>
    <div class="section-hero__stripes" aria-hidden="true"></div>
  ) : (
    <div
      class="section-hero__gradient"
      style={`background: ${fallbackGradient};`}
    ></div>
  )}

  <div class="section-hero__content">
    <h1 class="section-hero__title">{title}</h1>
    {subtitle && <p class="section-hero__subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .section-hero {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .section-hero--large {
    min-height: 420px;
  }

  .section-hero--small {
    min-height: 240px;
  }

  @media (min-width: 768px) {
    .section-hero {
      min-height: 380px;
    }
    .section-hero--large {
      min-height: 480px;
    }
    .section-hero--small {
      min-height: 280px;
    }
  }

  /* Background image layer */
  .section-hero__background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .section-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  /* Colour overlay on top of image */
  .section-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
  }

  /* Diagonal stripe pattern (matches site branding) */
  .section-hero__stripes {
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: repeating-linear-gradient(
      -60deg,
      transparent,
      transparent 8px,
      rgba(255, 255, 255, 0.05) 8px,
      rgba(255, 255, 255, 0.05) 10px
    );
    z-index: 3;
  }

  /* Fallback gradient when no image */
  .section-hero__gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  /* Content layer */
  .section-hero__content {
    position: relative;
    z-index: 4;
    text-align: center;
    color: white;
    padding: 3rem 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .section-hero__title {
    color: white;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem 0;
    font-weight: 700;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    line-height: 1.2;
  }

  .section-hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    opacity: 0.95;
    margin: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    line-height: 1.6;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .section-hero__content {
      padding: 2.5rem 1rem;
    }

    .section-hero__stripes {
      width: 30%;
    }
  }
</style>
