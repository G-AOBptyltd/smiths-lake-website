---
// StatusBadge.astro - Displays colored status badge
// Props: status (string), section (string for context-specific colors)

interface Props {
  status: string;
  section?: string;
}

const { status, section } = Astro.props;

// Color mapping based on status
const colorMap: Record<string, string> = {
  // Groups & Activities
  'Active': 'bg-green-100 text-green-800 border-green-300',
  'Looking for Members': 'bg-yellow-100 text-yellow-800 border-yellow-300',
  'Full': 'bg-blue-100 text-blue-800 border-blue-300',
  'On Break': 'bg-gray-100 text-gray-800 border-gray-300',
  'Inactive': 'bg-red-100 text-red-800 border-red-300',
  
  // Services/Projects
  'In Progress': 'bg-yellow-100 text-yellow-800 border-yellow-300',
  'Planning': 'bg-blue-100 text-blue-800 border-blue-300',
  'Proposed': 'bg-gray-100 text-gray-800 border-gray-300',
  'Advocating': 'bg-green-100 text-green-800 border-green-300',
  'Not Started': 'bg-gray-100 text-gray-600 border-gray-300',
  'Completed': 'bg-green-100 text-green-800 border-green-300',
  'On Hold': 'bg-red-100 text-red-800 border-red-300',
  
  // Emergency
  'Normal': 'bg-green-100 text-green-800 border-green-300',
  'Watch': 'bg-yellow-100 text-yellow-800 border-yellow-300',
  'Warning': 'bg-orange-100 text-orange-800 border-orange-300',
  'Emergency': 'bg-red-100 text-red-800 border-red-300',
  
  // Environment
  'Active Project': 'bg-green-100 text-green-800 border-green-300',
  'Monitoring': 'bg-blue-100 text-blue-800 border-blue-300',
  
  // History
  'Published': 'bg-green-100 text-green-800 border-green-300',
  'Draft': 'bg-yellow-100 text-yellow-800 border-yellow-300',
  'Needs Research': 'bg-orange-100 text-orange-800 border-orange-300',
};

const colorClass = colorMap[status] || 'bg-gray-100 text-gray-800 border-gray-300';
---

{status && (
  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${colorClass}`}>
    {status}
  </span>
)}
