---
const currentYear = new Date().getFullYear();

type FooterDocument = {
  id: string;
  title: string;
  url: string;
  category?: string;
  lastEdited?: string;
  editedBy?: string;
  summary?: string;
};

interface Props {
  documents?: FooterDocument[];
}

const { documents = [] } = Astro.props;

const footerSections = [
  {
    title: 'Quick Links',
    links: [
      { href: '/about/', label: 'About Smiths Lake' },
      { href: '/services/', label: 'Services & Amenities' },
      { href: '/groups/', label: 'Groups & Activities' },
      { href: '/contact/', label: 'Contact Us' },
    ]
  },
  {
    title: 'Emergency Info',
    links: [
      { href: '/emergency/', label: 'Emergency Contacts' },
      { href: '/environment/#lake-level', label: 'Live Lake Level' },
      { href: '/emergency/#evacuation', label: 'Evacuation Plans' },
      { href: '/emergency/#bushfire', label: 'Bushfire Information' },
      { href: '/emergency/#flood', label: 'Flood Preparedness' },
    ]
  },
  // Step 2: Replace the static "Resources" section with Notion-driven "Key Documents"
  {
    title: 'Key Documents',
    links: documents
      .filter((d) => d?.url && d.url !== '#')
      .slice(0, 6)
      .map((d) => ({
        href: d.url,
        label: d.title || 'Untitled',
        external: true
      }))
  },
  {
    title: 'Connect',
    links: [
      { href: '/news/', label: 'News' },
      { href: '/contribute/', label: 'Support Us' },
      { href: '/supporters/', label: 'Our Supporters' },
      { href: '/newsletter/', label: 'Stay Connected' },
      { href: '/feedback/', label: 'Submit Feedback' },
      { href: 'https://www.midcoast.nsw.gov.au/', label: 'MidCoast Council', external: true },
    ]
  }
];

// If there are no Notion docs yet, show sensible defaults so the footer doesn't look empty
const hasKeyDocs = footerSections[2].links.length > 0;

if (!hasKeyDocs) {
  footerSections[2] = {
    title: 'Key Documents',
    links: [
      { href: '/about/#documents', label: 'Document Library' },
      { href: '/about/#maps', label: 'Maps & Demographics' },
      { href: '/privacy/', label: 'Privacy Policy' },
    ]
  };
}
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-grid">
      {footerSections.map((section) => (
        <div class="footer-section">
          <h4 class="footer-heading">{section.title}</h4>

          <ul class="footer-links">
            {section.links.map((link) => (
              <li>
                <a 
                  href={link.href}
                  class="footer-link"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                  {link.external && (
                    <span class="external-icon" aria-hidden="true">↗</span>
                  )}
                </a>
              </li>
            ))}
          </ul>

          {section.title === 'Key Documents' && documents.length > 0 && (
            <p class="footer-hint">
              Managed in Notion via <strong>Display Locations</strong>.
            </p>
          )}
        </div>
      ))}
    </div>
    
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} Pacific Palms Community Association (PPCA). All rights reserved.
      </p>
      <nav class="footer-legal" aria-label="Legal links">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/accessibility/">Accessibility</a>
        <a href="/sitemap/">Site Map</a>
      </nav>
    </div>
    
    <!-- Agility Ops Sponsorship Credit -->
    <div class="footer-sponsor">
      <p>
        Proudly built on <a href="https://village1st.com.au/" target="_blank" rel="noopener noreferrer" class="sponsor-link">Village1st</a> — the platform empowering local communities · created by <a href="https://agilityops.com.au/" target="_blank" rel="noopener noreferrer" class="sponsor-link">Agility Ops Business Pty Ltd</a>
      </p>
    </div>
    
    <div class="footer-acknowledgement">
      <p>
        We acknowledge the Worimi people as the traditional custodians of the land on which 
        Smiths Lake Village is located. We pay our respects to Elders past, present and emerging.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-12) 0 var(--space-8);
  }
  
  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }
  
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .footer-heading {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-golden);
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-links li {
    margin-bottom: var(--space-3);
  }
  
  .footer-links li:last-child {
    margin-bottom: 0;
  }
  
  .footer-link {
    color: var(--color-sky-light);
    text-decoration: none;
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: color var(--transition-fast);
  }
  
  .footer-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
  
  .footer-link:focus-visible {
    outline: 2px solid var(--color-golden);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  
  .external-icon {
    font-size: 0.75em;
  }

  .footer-hint {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-sky-light);
    opacity: 0.95;
    line-height: var(--leading-relaxed);
  }
  
  .footer-bottom {
    border-top: 1px solid var(--color-navy-light);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  
  .copyright {
    font-size: var(--text-sm);
    color: var(--color-sky-light);
    margin: 0;
  }
  
  .footer-legal {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  
  .footer-legal a {
    color: var(--color-sky-light);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }
  
  .footer-legal a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
  
  .footer-legal a:focus-visible {
    outline: 2px solid var(--color-golden);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  
  /* Sponsor Credit Section */
  .footer-sponsor {
    border-top: 1px solid var(--color-navy-light);
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
    text-align: center;
  }
  
  .footer-sponsor p {
    font-size: var(--text-sm);
    color: var(--color-sky-light);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
  
  .sponsor-link {
    color: var(--color-golden);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }
  
  .sponsor-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
  
  .sponsor-link:focus-visible {
    outline: 2px solid var(--color-golden);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  
  .footer-acknowledgement {
    border-top: 1px solid var(--color-navy-light);
    padding-top: var(--space-6);
  }
  
  .footer-acknowledgement p {
    font-size: var(--text-sm);
    color: var(--color-sky-light);
    font-style: italic;
    margin: 0;
    line-height: var(--leading-relaxed);
  }
</style>

