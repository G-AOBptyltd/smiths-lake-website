---
interface Props {
  title: string;
  subtitle?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  backgroundImage?: string;
  overlayOpacity?: number; // 0-100: 0 = no overlay, 100 = solid colour. Default 50.
  videoSrc?: string;
  size?: 'default' | 'large' | 'small';
}
const { 
  title, 
  subtitle, 
  primaryCta, 
  secondaryCta,
  backgroundImage = '/images/hero-smiths-lake.jpg',
  overlayOpacity = 50,
  videoSrc,
  size = 'default'
} = Astro.props;
// Convert 0-100 scale to alpha values for the gradient
const peakAlpha = Math.max(0, Math.min(1, overlayOpacity / 100));
const midAlpha = peakAlpha * 0.7;
const endAlpha = peakAlpha * 0.45;
const sizeClasses = {
  small: 'hero--small',
  default: '',
  large: 'hero--large'
};
---
<section class={`hero ${sizeClasses[size]}`}>
  <div class="hero-background">
    {videoSrc ? (
      <video 
        class="hero-video" 
        autoplay 
        muted 
        loop 
        playsinline
        poster={backgroundImage}
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    ) : (
      <img 
        src={backgroundImage} 
        alt="" 
        class="hero-image"
        loading="eager"
      />
    )}
  </div>
  <div class="hero-overlay" style={`background: linear-gradient(135deg, rgba(27, 54, 93, ${peakAlpha}) 0%, rgba(27, 54, 93, ${midAlpha}) 50%, rgba(91, 155, 213, ${endAlpha}) 100%);`}></div>
  
  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    
    {(primaryCta || secondaryCta) && (
      <div class="hero-cta">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn--primary btn--lg">
            {primaryCta.text}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn--outline-white btn--lg">
            {secondaryCta.text}
          </a>
        )}
      </div>
    )}
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hero--large {
    min-height: 600px;
  }
  
  .hero--small {
    min-height: 300px;
  }
  
  @media (min-width: 768px) {
    .hero {
      min-height: 550px;
    }
    
    .hero--large {
      min-height: 700px;
    }
    
    .hero--small {
      min-height: 350px;
    }
  }
  
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }
  
  .hero-image,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
  }
  
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: var(--color-white);
    padding: var(--space-8) var(--space-4);
    max-width: 900px;
  }
  
  .hero-title {
    color: var(--color-white);
    margin-bottom: var(--space-4);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
  }
  
  .hero-subtitle {
    font-size: clamp(var(--text-lg), 2.5vw, var(--text-xl));
    opacity: 0.95;
    margin-bottom: var(--space-8);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    line-height: var(--leading-relaxed);
  }
  
  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
