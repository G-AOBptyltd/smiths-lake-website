---
interface Props {
  title: string;
  subtitle?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  backgroundImage?: string;
  overlayOpacity?: number; // 0-100: 0 = no overlay, 100 = solid colour. Default 50.
  videoSrc?: string;
  size?: 'default' | 'large' | 'small';
}
const { 
  title, 
  subtitle, 
  primaryCta, 
  secondaryCta,
  backgroundImage = '/images/hero-smiths-lake.jpg',
  overlayOpacity = 50,
  videoSrc,
  size = 'default'
} = Astro.props;
// Convert 0-100 scale to alpha values for the gradient
const peakAlpha = Math.max(0, Math.min(1, overlayOpacity / 100));
const midAlpha = peakAlpha * 0.7;
const endAlpha = peakAlpha * 0.45;

// Per-village treatment. Inline env reads (NOT a village.js import): adding any
// new static import to this component reshuffles Vite CSS chunk ordering across
// every page that uses it and breaks the byte-parity invariant (same hazard
// documented in contact.astro and SectionHero.astro).
//
// 'gradient' hero style: only replaces the BUILT-IN Smiths Lake photo — a
// caller-supplied image (e.g. the homepage's PUBLIC_HERO_IMAGE village photo or
// a Notion Section Settings hero) is the village's own and is kept.
const useGradient =
  (import.meta.env.PUBLIC_SECTION_HERO || 'photos') === 'gradient' &&
  backgroundImage === '/images/hero-smiths-lake.jpg';

// Overlay tint: historical literals are navy #1B365D → sky #5B9BD5. When a
// theme primary is set, tint with the village palette instead (primary →
// primary-light, mirroring SectionHero's lighten fallback). Default build
// emits the exact historical rgba() strings byte-for-byte.
function hexChannels(hex: string): [number, number, number] {
  return [
    parseInt(hex.slice(1, 3), 16),
    parseInt(hex.slice(3, 5), 16),
    parseInt(hex.slice(5, 7), 16),
  ];
}
const themePrimary = import.meta.env.PUBLIC_THEME_PRIMARY || '';
const themePrimaryLight = import.meta.env.PUBLIC_THEME_PRIMARY_LIGHT || '';
const [tintR, tintG, tintB] = themePrimary ? hexChannels(themePrimary) : [27, 54, 93];
const [endR, endG, endB] = themePrimary
  ? (themePrimaryLight
      ? hexChannels(themePrimaryLight)
      : hexChannels(themePrimary).map((c) => Math.min(255, c + 80)) as [number, number, number])
  : [91, 155, 213];
const sizeClasses = {
  small: 'hero--small',
  default: '',
  large: 'hero--large'
};

// Responsive image variants via Netlify Image CDN (local images only).
// Phones download ~480px wide files instead of the full-size original.
const isLocalImage = backgroundImage && backgroundImage.startsWith('/') && !backgroundImage.startsWith('//');
const cdnSrc = (w: number) => `/.netlify/images?url=${encodeURIComponent(backgroundImage)}&w=${w}&q=70`;
const heroSrcset = isLocalImage
  ? [480, 768, 1280, 1920].map((w) => `${cdnSrc(w)} ${w}w`).join(', ')
  : undefined;

// BYTE-PARITY NOTE: in the template below, `</div> <div class="hero-overlay"…`
// must stay on ONE line joined by a single space. Inside a ternary branch Astro
// preserves literal whitespace (a newline+indent leaks into the output), while
// the historical static markup collapsed this gap to exactly one space —
// verified byte-for-byte against live villagefirst.org.au.
---
<section class={`hero ${sizeClasses[size]}`}>
  {useGradient ? (
    <div
      class="hero-background"
      style="background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);"
    ></div>
    <div
      class="hero-overlay"
      aria-hidden="true"
      style="left: auto; width: 40%; background: repeating-linear-gradient(-60deg, transparent, transparent 8px, rgba(255, 255, 255, 0.05) 8px, rgba(255, 255, 255, 0.05) 10px);"
    ></div>
  ) : (
  <div class="hero-background">
    {videoSrc ? (
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        poster={backgroundImage}
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    ) : (
      <img
        src={backgroundImage}
        srcset={heroSrcset}
        sizes="100vw"
        alt=""
        class="hero-image"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div> <div class="hero-overlay" style={`background: linear-gradient(135deg, rgba(${tintR}, ${tintG}, ${tintB}, ${peakAlpha}) 0%, rgba(${tintR}, ${tintG}, ${tintB}, ${midAlpha}) 50%, rgba(${endR}, ${endG}, ${endB}, ${endAlpha}) 100%);`}></div>
  )}

  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    
    {(primaryCta || secondaryCta) && (
      <div class="hero-cta">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn--primary btn--lg">
            {primaryCta.text}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn--outline-white btn--lg">
            {secondaryCta.text}
          </a>
        )}
      </div>
    )}
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero--large {
    min-height: 345px;
  }

  .hero--small {
    min-height: 195px;
  }
  
  @media (min-width: 768px) {
    .hero {
      min-height: 415px;
    }
    
    .hero--large {
      min-height: 525px;
    }
    
    .hero--small {
      min-height: 260px;
    }
  }
  
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }
  
  .hero-image,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
  }
  
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: var(--color-white);
    padding: var(--space-8) var(--space-4);
    max-width: 900px;
  }
  
  .hero-title {
    color: var(--color-white);
    margin-bottom: var(--space-4);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
  }
  
  .hero-subtitle {
    font-size: clamp(var(--text-lg), 2.5vw, var(--text-xl));
    opacity: 0.95;
    margin-bottom: var(--space-8);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    line-height: var(--leading-relaxed);
  }
  
  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
