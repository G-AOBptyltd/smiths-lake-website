---
/**
 * SponsorStrip — "Our community sponsors", fed live from /api/ad-list.
 *
 * Renders NOTHING (removes itself, zero space) when the village has no
 * placements that are Active and inside their run dates — so mounting it
 * costs nothing until the committee sells a placement, and expiring the
 * last placement makes it vanish without a deploy.
 *
 * variants: "band" (full-width strip, homepage) · "sidebar" (compact card).
 * Tier order: Major Sponsor (highlighted) → Sponsor → Supporter.
 */
interface Props {
  village?: string;
  variant?: 'band' | 'sidebar';
}
const { village = 'Smiths Lake', variant = 'band' } = Astro.props;
const stripId = `sponsor-strip-${variant}`;
---

<div id={stripId} class={`sponsor-strip is-${variant}`} data-village={village} hidden></div>

<style is:global>
  /* Content is JS-created — global styles required. */
  .sponsor-strip.is-band { background: #f7faf8; border-top: 1px solid #e5ece8; padding: 2.2rem 1rem 2.5rem; }
  .sponsor-strip .ss-inner { max-width: 1100px; margin: 0 auto; }
  .sponsor-strip .ss-head { text-align: center; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #6b7280; margin-bottom: 1.1rem; }
  .sponsor-strip .ss-grid { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
  .sponsor-strip .ss-card { display: block; background: white; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 0.8rem 1.3rem; text-align: center; text-decoration: none; transition: transform 0.12s ease, box-shadow 0.12s ease; }
  .sponsor-strip a.ss-card:hover { transform: translateY(-2px); box-shadow: 0 5px 14px rgba(0,0,0,0.08); }
  .sponsor-strip .ss-card.t-major { border-color: #b45309; }
  .sponsor-strip .ss-tag { font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #b45309; }
  .sponsor-strip .ss-name { font-weight: 800; color: #143d2e; font-size: 1rem; }
  .sponsor-strip .ss-blurb { font-size: 0.78rem; color: #6b7280; max-width: 230px; line-height: 1.45; }

  .sponsor-strip.is-sidebar { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.2rem; }
  .sponsor-strip.is-sidebar .ss-head { text-align: left; margin-bottom: 0.7rem; }
  .sponsor-strip.is-sidebar .ss-grid { flex-direction: column; gap: 0.6rem; }
  .sponsor-strip.is-sidebar .ss-card { text-align: left; padding: 0.65rem 0.9rem; }
  .sponsor-strip.is-sidebar .ss-name { font-size: 0.92rem; }
  .sponsor-strip.is-sidebar .ss-blurb { max-width: none; }
</style>

<script define:vars={{ stripId }}>
  (async () => {
    const el = document.getElementById(stripId);
    if (!el) return;
    const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    try {
      const r = await fetch('/api/ad-list?village=' + encodeURIComponent(el.dataset.village));
      const data = await r.json();
      const ads = (data && data.ads) || [];
      if (!ads.length) { el.remove(); return; } // no sponsors → no strip, zero space
      el.innerHTML = '<div class="ss-inner"><div class="ss-head">Our community sponsors</div><div class="ss-grid">' +
        ads.map((a) => {
          const inner = (a.tier === 'Major Sponsor' ? '<div class="ss-tag">Major sponsor</div>' : '') +
            '<div class="ss-name">' + esc(a.business) + '</div>' +
            (a.blurb ? '<div class="ss-blurb">' + esc(a.blurb) + '</div>' : '');
          return a.website
            ? '<a class="ss-card' + (a.tier === 'Major Sponsor' ? ' t-major' : '') + '" href="' + esc(a.website) + '" target="_blank" rel="noopener sponsored">' + inner + '</a>'
            : '<div class="ss-card' + (a.tier === 'Major Sponsor' ? ' t-major' : '') + '" style="cursor:default;">' + inner + '</div>';
        }).join('') + '</div></div>';
      el.hidden = false;
    } catch (e) { el.remove(); } // any hiccup → invisible, never broken
  })();
</script>
