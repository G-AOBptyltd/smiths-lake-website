---
// SearchBar.astro — site-wide search entry point.
// Reuses the existing sitemap search: this bar simply routes the query to
// /sitemap/?q=… (a native GET form, works without JS), where the sitemap page
// pre-fills its own search, filters the content directory, and scrolls to the
// results. Rendered at the top of every page via BaseLayout, so search is
// available site-wide, per village (the sitemap lists that village's content).
import { village } from '../config/village.js';

// Pre-fill from ?q= so the bar echoes the active query on the results page.
const q = Astro.url.searchParams.get('q') || '';
---

<div class="site-search-bar">
  <form class="site-search-form" role="search" action="/sitemap/" method="get">
    <div class="site-search-field">
      <span class="site-search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M21 21l-4.3-4.3"></path>
        </svg>
      </span>
      <input
        id="site-search-input"
        class="site-search-input"
        type="search"
        name="q"
        value={q}
        placeholder={`Search ${village.name}…`}
        aria-label={`Search ${village.displayName}`}
        autocomplete="off"
      />
    </div>
    <button type="submit" class="site-search-submit">Search</button>
  </form>
</div>

<style>
  .site-search-bar {
    background: var(--color-sky-pale, #E8F4FC);
    border-bottom: 1px solid var(--color-light-gray, #E8EDF3);
  }

  .site-search-form {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    padding: 0.6rem var(--space-4, 1rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Left-aligned: the field sits at the top-left of the page content. */
    justify-content: flex-start;
  }

  .site-search-field {
    position: relative;
    flex: 0 1 460px;
  }

  .site-search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    color: var(--color-medium-gray, #6B7280);
    pointer-events: none;
  }

  .site-search-input {
    width: 100%;
    padding: 0.6rem 0.9rem 0.6rem 2.5rem;
    border: 2px solid var(--color-light-gray, #E8EDF3);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    background: #fff;
    color: var(--color-navy, #1B365D);
  }

  .site-search-input::placeholder {
    color: var(--color-medium-gray, #6B7280);
  }

  .site-search-input:focus {
    outline: none;
    border-color: var(--color-sky, #5B9BD5);
    box-shadow: 0 0 0 3px rgba(91, 155, 213, 0.2);
  }

  .site-search-submit {
    flex-shrink: 0;
    background: var(--color-navy, #1B365D);
    color: #fff;
    border: none;
    padding: 0.62rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .site-search-submit:hover {
    background: var(--color-navy-light, #2B4A7D);
  }

  .site-search-submit:focus-visible {
    outline: 3px solid var(--color-golden, #F5A623);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .site-search-field {
      flex: 1 1 auto;
    }
    .site-search-submit {
      padding: 0.62rem 0.9rem;
    }
  }
</style>
