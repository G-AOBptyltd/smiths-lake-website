---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getPublicDocuments } from '../lib/notionDocuments';
import { village, themeOverrideCss } from '../config/village.js';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

const {
  title,
  description = village.siteDescription,
  ogImage = "/images/og-default.jpg",
  canonicalUrl,
  noIndex = false
} = Astro.props;

const siteTitle = village.siteTitle;
const fullTitle = title === "Home" ? siteTitle : `${title} | ${siteTitle}`;
const canonical = canonicalUrl || Astro.url.href;

// Village config: theme override CSS ('' by default → nothing emitted),
// preview mode (noindex + banner), env-gated GA.
const themeCss = themeOverrideCss();
const hideFromRobots = noIndex || village.preview;
const gaEnabled = village.gaId !== 'off';
// Keep this script byte-identical to the historical inline block when the
// default GA id is in play (build verifier diffs default builds against main).
const gaScript = `
    // Only load GA if cookie consent given
    if (localStorage.getItem('cookieConsent') === 'accepted') {
      (function() {
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=${village.gaId}';
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${village.gaId}', {
          'anonymize_ip': true,
          'cookie_flags': 'SameSite=None;Secure'
        });
        window.gtag = gtag;
      })();
    }
  `;

// STEP 2: Pull footer documents from Notion (safe fallback so builds don't fail)
let footerDocuments: Array<{
  id: string;
  title: string;
  url: string;
  category?: string;
  lastEdited?: string;
  editedBy?: string;
  summary?: string;
}> = [];

try {
  // NOTE THE DASH. This string must byte-match the Notion multi_select option
  // exactly. It previously used an EN DASH (U+2013) while Notion has a plain
  // HYPHEN-MINUS (U+002D), so Notion rejected every request with
  // "multi_select option ... not found" — on all 118 pages, every build. It
  // failed open to [], so the footer silently showed hardcoded fallback links
  // and the Notion-managed Key Documents list never worked at all.
  footerDocuments = await getPublicDocuments("Footer - Key Documents");
} catch (err) {
  console.warn("Notion footer documents fetch failed:", err);
  footerDocuments = [];
}
---

<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonical}>
  
  <!-- Robots -->
  {hideFromRobots && <meta name="robots" content="noindex, nofollow">}
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="en_AU">
  <meta property="og:site_name" content={siteTitle}>
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content={village.theme.primary || '#1B365D'}>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">
  
  <title>{fullTitle}</title>

  {themeCss && <style is:inline set:html={themeCss}></style>}

  <!-- Google Analytics 4 (env-gated: PUBLIC_GA_MEASUREMENT_ID="off" disables entirely) -->
  {gaEnabled && <script is:inline set:html={gaScript}></script>}
</head>
<body>
  <!-- Identity invite/recovery handler: Netlify Identity links land on the site root with
       a #invite_token / #recovery_token hash. Bounce those to the /admin/ hub, which loads the
       Identity widget to complete set-password and then routes each person (steward, admin) to
       the right place. Any page already under /admin/ or /survey-admin/ has its own widget, so
       leave those alone. Inline so it runs synchronously before anything else. -->
  <script is:inline>
    (function () {
      var h = window.location.hash || '';
      var p = window.location.pathname || '';
      if ((h.indexOf('invite_token=') > -1 || h.indexOf('recovery_token=') > -1)
          && p.indexOf('/admin') !== 0 && p.indexOf('/survey-admin') !== 0) {
        window.location.replace('/admin/' + h);
      }
    })();
  </script>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <Header />
  
  <main id="main-content" role="main">
    <slot />
  </main>
  
  <Footer documents={footerDocuments} />

  <CookieConsent />

  {village.preview && (
    <div
      id="preview-banner"
      role="note"
      style="position:fixed;bottom:0;left:0;right:0;z-index:2000;background:#1F2937;color:#F9FAFB;font-size:0.8rem;line-height:1.4;padding:0.5rem 2.5rem 0.5rem 1rem;text-align:center;box-shadow:0 -2px 8px rgba(0,0,0,0.25);"
    >
      Concept preview — not affiliated with any local organisation. Part of the Village1st platform pilot.
      <button
        id="preview-banner-close"
        aria-label="Dismiss preview notice"
        style="position:absolute;right:0.5rem;top:50%;transform:translateY(-50%);background:transparent;border:none;color:#F9FAFB;font-size:1.1rem;cursor:pointer;padding:0.25rem 0.5rem;"
      >&times;</button>
    </div>
  )}
  {village.preview && (
    <script is:inline>
      (function () {
        var b = document.getElementById('preview-banner');
        var x = document.getElementById('preview-banner-close');
        if (!b || !x) return;
        if (sessionStorage.getItem('previewBannerDismissed') === '1') { b.style.display = 'none'; return; }
        x.addEventListener('click', function () {
          b.style.display = 'none';
          try { sessionStorage.setItem('previewBannerDismissed', '1'); } catch (e) {}
        });
      })();
    </script>
  )}
</body>
</html>
