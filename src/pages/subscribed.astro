---
/**
 * /subscribed/ — the landing page for the double opt-in confirmation link.
 *
 * The confirmation email points here with ?token=<uuid>; the page calls
 * /api/subscribe-confirm and reports what happened. Three honest outcomes:
 * confirmed, already confirmed (a second click is fine), or an invalid link.
 *
 * noIndex — a one-time, token-bearing URL has no business in a search index.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Subscription confirmed" noIndex={true}>
  <main class="confirm-page">
    <div class="container">
      <div class="confirm-card" id="card">
        <div class="confirm-icon" id="icon" aria-hidden="true">⏳</div>
        <h1 id="heading">Confirming your subscription…</h1>
        <p id="detail">One moment while we tick the box.</p>
        <div class="actions" id="actions" hidden>
          <a href="/" class="btn btn-primary">Return home</a>
          <a href="/news/" class="btn btn-outline">Read the news</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const token = params.get('token') || '';
  const icon = document.getElementById('icon')!;
  const heading = document.getElementById('heading')!;
  const detail = document.getElementById('detail')!;
  const actions = document.getElementById('actions')!;

  function show(ic: string, head: string, text: string) {
    icon.textContent = ic;
    heading.textContent = head;
    detail.textContent = text;
    actions.hidden = false;
  }

  (async () => {
    if (!token) {
      show('🔗', 'That link looks incomplete', 'Open the confirmation link from your email exactly as it was sent — it carries a code this page needs.');
      return;
    }
    try {
      const r = await fetch('/api/subscribe-confirm?token=' + encodeURIComponent(token));
      const data = await r.json().catch(() => ({}));
      if (r.ok && data.alreadyConfirmed) {
        show('✓', "You're already on the list", 'This subscription was confirmed earlier — nothing more to do. Every email we send has an unsubscribe link.');
      } else if (r.ok) {
        show('✓', "You're in — welcome aboard!", 'Your subscription is confirmed. Community updates will land in your inbox, and every one of them carries an unsubscribe link.');
      } else {
        show('🔗', "That link isn't valid", data.error || 'It may have been replaced by a newer confirmation email. Sign up again and use the most recent link.');
      }
    } catch (_) {
      show('⚠️', "We couldn't reach the server", 'Please try the link again in a moment.');
    }
  })();
</script>

<style>
  .confirm-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .confirm-card {
    text-align: center;
    max-width: 560px;
    padding: 3rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  .confirm-icon {
    width: 80px;
    height: 80px;
    background: #16a34a;
    color: white;
    font-size: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
  }
  /* var(--color-navy, …) not the literal hex: token defaults to this exact
     value so default builds render identically, themed villages recolour. */
  h1 { color: var(--color-navy, #1B365D); margin-bottom: 1rem; font-size: 1.6rem; }
  p { color: #6B7280; margin-bottom: 2rem; line-height: 1.6; }
  .actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
  .btn-primary { background: var(--color-navy, #1B365D); color: white; }
  .btn-outline { border: 2px solid var(--color-navy, #1B365D); color: var(--color-navy, #1B365D); }
  [hidden] { display: none !important; }
</style>
