---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// Per-village strings (env override ?? exact historical Smiths Lake strings —
// mirrors src/config/village.js). Read inline instead of importing village.js:
// adding ANY new import to this page reshuffles Vite's CSS chunk merging and
// moves this page's scoped <style> in the built head, breaking the byte-parity
// invariant for default (Smiths Lake) builds.
const entityName = import.meta.env.PUBLIC_ENTITY_NAME || 'Pacific Palms Community Association';
const entityShort = import.meta.env.PUBLIC_ENTITY_SHORT || 'PPCA';

// Village-driven contact copy (PUBLIC_ABOUT_SOURCE="notion"): the content DB's
// Administration & Reference "contact" row supplies the intro paragraphs and
// public contact email. Default 'builtin' (or an empty fetch) keeps the
// historical hardcoded copy byte-identical. The lib is loaded via a runtime
// dynamic import that Vite cannot statically analyse — same chunk-parity reason.
let contactContent = null;
if ((import.meta.env.PUBLIC_ABOUT_SOURCE || 'builtin') === 'notion') {
  try {
    const path = await import('node:path');
    const { pathToFileURL } = await import('node:url');
    const libUrl = pathToFileURL(path.resolve(process.cwd(), 'src/lib/notion-about.js')).href;
    const mod = await import(/* @vite-ignore */ libUrl);
    contactContent = await mod.fetchContactContent();
  } catch (e) {
    console.warn('contact: notion content unavailable, using builtin copy:', e.message);
  }
}
---

<BaseLayout
  title="Contact Us"
  description={`Get in touch with the ${entityName} (${entityShort}).`}
>
  <Hero
    title="Contact Us"
    subtitle={`Get in touch with the ${entityShort} committee.`}
    size="small"
  />
  
  <section class="section">
    <div class="container container--narrow">
      <div class="contact-intro text-center">
        {contactContent ? (
          contactContent.paragraphs.map((text) => <p>{text}</p>)
        ) : (
        <p>
          Have a question, suggestion, or want to get involved? We'd love to hear from you. 
          Fill out the form below and a committee member will respond as soon as possible.
        </p>
        )}
      </div>
      
      <!-- Enquiries post to /api/enquiry-submit → the `enquiries` table in the
           Sydney Supabase project (migration 0020). They used to go to NETLIFY
           FORMS and nowhere else: a US-hosted store outside this site's privacy
           policy, with no retention control and no queue the committee could
           work. Same fields, same honeypot; the honeypot is now named "website"
           to match every other public writer on the platform. -->
      <form class="contact-form" id="contact-form" novalidate>
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </p>
        
        <div class="form-group">
          <label for="name" class="form-label form-label--required">Your Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-input" 
            required 
            autocomplete="name"
          />
        </div>
        
        <div class="form-group">
          <label for="email" class="form-label form-label--required">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            required 
            autocomplete="email"
          />
        </div>
        
        <div class="form-group">
          <label for="phone" class="form-label">Phone Number (optional)</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-input" 
            autocomplete="tel"
          />
        </div>
        
        <div class="form-group">
          <label for="subject" class="form-label form-label--required">Subject</label>
          <select id="subject" name="subject" class="form-select" required>
            <option value="">Please select...</option>
            <option value="general">General Enquiry</option>
            <option value="membership">{entityShort} Membership</option>
            <option value="volunteer">Volunteering</option>
            <option value="website">Website Feedback</option>
            <option value="other">Other</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="message" class="form-label form-label--required">Your Message</label>
          <textarea 
            id="message" 
            name="message" 
            class="form-textarea" 
            rows="6" 
            required
          ></textarea>
        </div>
        
        <div class="form-group">
          <button type="submit" class="btn btn--primary btn--lg" id="contact-submit">Send Message</button>
          <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
        </div>

        <p class="collection-notice">
          We collect your name, email and message so a committee member can reply, and we
          keep it only as long as the enquiry is open. It is stored securely in Australia and
          never sold or shared. <a href="/privacy/">Privacy Policy</a>
        </p>
      </form>

      <div class="contact-sent" id="contact-sent" hidden>
        <div class="sent-tick" aria-hidden="true">✓</div>
        <h2>Message sent — thank you</h2>
        <p>A committee member will be in touch. If it's urgent, please come along to the next meeting.</p>
      </div>
      
      <aside class="contact-info">
        <h2>Other Ways to Reach Us</h2>
        {contactContent ? (
          contactContent.contactEmail ? (
            <p>
              You can also email us directly at{' '}
              <a href={`mailto:${contactContent.contactEmail}`}>{contactContent.contactEmail}</a>.
            </p>
          ) : (
            <p>Use the form above and a member of the community team will get back to you.</p>
          )
        ) : (
        <Fragment><p>
          PPCA holds regular community meetings where residents can raise matters 
          directly. Meeting dates are announced on the website and through our community updates.
        </p>
        <p>
          For urgent community matters, please attend a PPCA meeting or contact 
          MidCoast Council directly.
        </p></Fragment>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro {
    max-width: 600px;
    margin: 0 auto var(--space-10);
  }
  
  .contact-intro p {
    font-size: var(--text-lg);
    color: var(--color-gray-700);
  }
  
  .contact-form {
    background: var(--color-off-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-10);
  }
  
  .hidden {
    display: none;
  }
  
  .contact-info {
    text-align: center;
    padding: var(--space-8);
    background: var(--color-sky-pale);
    border-radius: var(--radius-lg);
  }
  
  .contact-info h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }
  
  .contact-info p {
    color: var(--color-gray-700);
    max-width: 500px;
    margin: 0 auto var(--space-4);
  }
  
  .contact-info p:last-child {
    margin-bottom: 0;
  }

  .collection-notice {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin: var(--space-4) 0 0;
  }

  .form-status {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-gray-600);
    margin: var(--space-2) 0 0;
    min-height: 1.2em;
  }

  .form-status.is-err {
    color: #b91c1c;
  }

  .contact-sent {
    background: var(--color-off-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .sent-tick {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #16a34a;
    color: white;
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  [hidden] { display: none !important; }
</style>

<script>
  /**
   * Contact enquiries → /api/enquiry-submit (Supabase `enquiries`), replacing
   * the Netlify Forms POST. Inline success, so nobody leaves the page to be
   * told "thank you". The <select> sends BOTH halves: its value as `category`
   * (the stable key) and its visible label as `subject` (what a human reads in
   * the notification email).
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const sent = document.getElementById('contact-sent');

  function setStatus(msg: string, isErr: boolean) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = 'form-status' + (isErr ? ' is-err' : '');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const message = String(fd.get('message') || '').trim();
    const select = document.getElementById('subject') as HTMLSelectElement | null;

    if (!name) { setStatus('Please add your name.', true); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setStatus('Please add a valid email address.', true); return; }
    if (!select?.value) { setStatus('Please choose a subject.', true); return; }
    if (!message) { setStatus('Please add your message.', true); return; }

    if (submitBtn) submitBtn.disabled = true;
    setStatus('Sending…', false);

    try {
      const r = await fetch('/api/enquiry-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          village: import.meta.env.PUBLIC_VILLAGE_NAME || 'Smiths Lake',
          kind: 'contact',
          name,
          email,
          phone: String(fd.get('phone') || '').trim(),
          subject: select.options[select.selectedIndex]?.text || select.value,
          category: select.value,
          message,
          sourcePage: '/contact/',
          website: String(fd.get('website') || ''),   // honeypot
        }),
      });
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
      form.hidden = true;
      if (sent) sent.hidden = false;
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Something went wrong. Please try again.', true);
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
