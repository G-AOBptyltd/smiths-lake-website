---
// Village News — hybrid layout (Option 2, July 2026)
// Stories WITH a photo are promoted to a "Featured" band (up to 2, full-bleed
// image tiles); every other story renders as a clean text row (date + section
// chip + headline + excerpt), so the page looks intentional with zero photos
// and grows richer as editors upload images. No empty photo slots, ever.
// Feed rule: only items with "Show in News Feed" ✓ AND a "Publish Date", newest first.
import Layout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import SponsorStrip from '../../components/SponsorStrip.astro';
import { fetchNotionContent } from '../../lib/notion-unified.js';
import { fetchSectionSettingsBySlug } from '../../lib/notion-section-settings.js';
import { generateSlug, resolveItemUrl, getSectionColour, getSectionDisplayName } from '../../lib/notion-detail-pages.js';

// Cross-section links resolve centrally in notion-detail-pages.js so the news
// feed, the homepage strip and the section pages can never disagree about where
// an item lives. resolveItemUrl() returns null for a section with no route —
// the card then renders unlinked rather than pointing at a URL that 404s.
function buildItemUrl(item: any): string | null {
  return resolveItemUrl(item);
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
}
function dateParts(iso: string) {
  const d = new Date(iso);
  return {
    day: d.toLocaleDateString('en-AU', { day: '2-digit' }),
    mon: d.toLocaleDateString('en-AU', { month: 'short' }),
  };
}
function accentFor(section: string) {
  return getSectionColour(section) || '#2d8b8b';
}
function trim(text: string, max: number) {
  if (!text) return '';
  return text.length > max ? text.substring(0, max) + '…' : text;
}

const sectionSettings = await fetchSectionSettingsBySlug('services');

let sectionHeroManifest: Record<string, string> = {};
let cardImageManifest: Record<string, string> = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const heroPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(heroPath)) sectionHeroManifest = JSON.parse(fs.readFileSync(heroPath, 'utf-8'));
  const cardPath = path.resolve(process.cwd(), 'public/images/cards/manifest.json');
  if (fs.existsSync(cardPath)) cardImageManifest = JSON.parse(fs.readFileSync(cardPath, 'utf-8'));
} catch (e) { /* manifests not yet generated */ }
const heroImage = sectionHeroManifest['services'] || null;

// ── The feed: deliberate news only ───────────────────────────────────────────
const allPublished = await fetchNotionContent({ requireShowOnWebsite: true });

const newsItems = allPublished
  .filter((item: any) => item.showInNewsFeed === true && item.publishDate)
  .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .map((item: any) => {
    const slug = item.slug || generateSlug(item.title);
    // Prefer the stable Blobs image URL (News Desk uploader); fall back to the
    // build-time Hero Image File manifest for legacy stories.
    return { ...item, _url: buildItemUrl(item), _img: item.imageUrl || cardImageManifest[slug] || null };
  });

// Hybrid split: photo stories → featured band (max 2); the rest → text list.
const featured = newsItems.filter((i: any) => i._img).slice(0, 2);
const featuredSet = new Set(featured);
const listItems = newsItems.filter((i: any) => !featuredSet.has(i));
---

<Layout
  title="Village News"
  description="The latest news and updates from Smiths Lake Village — published by the community, for the community."
>
<style>
  .page-wrap { background: #f7f9fc; }
  .content-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  .section-block { padding: 2.5rem 0 3.5rem; }

  .news-masthead {
    display: flex; align-items: baseline; justify-content: space-between;
    border-bottom: 3px solid #1B365D; padding-bottom: 0.5rem; margin-bottom: 1.5rem;
  }
  .news-masthead-title { font-size: 1.6rem; font-weight: 800; color: #1B365D; letter-spacing: -0.02em; }
  .news-masthead-date { font-size: 0.75rem; color: #9ca3af; }

  /* shared section chip */
  .chip {
    display: inline-block; padding: 0.18rem 0.6rem; border-radius: 3px;
    font-size: 0.62rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase;
    color: white; margin-bottom: 0.5rem;
  }

  /* ── Featured lane: stories that have a photo ──────────────────── */
  .lane-label { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 0.9rem; }
  .lane-label span {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    color: #2d8b8b; white-space: nowrap;
  }
  .lane-label::after { content: ''; flex: 1; height: 2px; background: #2d8b8b; opacity: 0.25; }

  .featured { display: grid; grid-template-columns: 2fr 1fr; gap: 8px; }
  .featured.single { grid-template-columns: 1fr; }
  .feat {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 380px; border-radius: 6px; overflow: hidden;
    background-size: cover; background-position: center; text-decoration: none;
  }
  .feat::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,15,30,0.92) 0%, rgba(8,15,30,0.35) 46%, rgba(8,15,30,0.02) 72%);
    transition: background 0.25s ease;
  }
  .feat:hover::after {
    background: linear-gradient(to top, rgba(8,15,30,0.96) 0%, rgba(8,15,30,0.45) 50%, rgba(8,15,30,0.08) 76%);
  }
  .feat-body { position: relative; z-index: 1; padding: 1.4rem; }
  .feat h2 {
    color: white; font-family: Georgia, 'Times New Roman', serif; font-weight: 800;
    line-height: 1.16; margin: 0.5rem 0 0.4rem; text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    font-size: clamp(1.35rem, 2.6vw, 1.95rem);
  }
  .feat.secondary h2 { font-size: clamp(1.05rem, 1.8vw, 1.3rem); }
  .feat p { color: rgba(255,255,255,0.88); font-size: 0.9rem; margin: 0 0 0.5rem; max-width: 560px; }
  .feat-date { color: rgba(255,255,255,0.7); font-size: 0.75rem; }

  /* ── Body: story list + sidebar ────────────────────────────────── */
  .news-body { display: grid; grid-template-columns: 1fr 320px; gap: 2.25rem; margin-top: 2.5rem; }

  .more-label { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 0.25rem; }
  .more-label span { font-size: 0.95rem; font-weight: 800; color: #1B365D; white-space: nowrap; }
  .more-label::after { content: ''; flex: 1; height: 2px; background: #1B365D; opacity: 0.85; }

  /* ── Story rows (look finished with no photo) ──────────────────── */
  .story {
    display: grid; grid-template-columns: 96px 1fr; gap: 1.1rem; align-items: start;
    padding: 1.15rem 0; border-bottom: 1px solid #e5e9f0; position: relative; text-decoration: none;
  }
  .story::before {
    content: ''; position: absolute; left: -14px; top: 1.15rem; bottom: 1.15rem; width: 3px;
    border-radius: 2px; background: var(--acc, #2d8b8b);
  }
  .story .when { padding-top: 0.15rem; }
  .story .day { font-size: 1.5rem; font-weight: 800; color: #1B365D; line-height: 1; }
  .story .mon { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #9ca3af; }
  .story .thumb { width: 96px; height: 72px; border-radius: 5px; background-size: cover; background-position: center; }
  .story h3 {
    font-family: Georgia, 'Times New Roman', serif; font-size: 1.18rem; font-weight: 700; color: #1B365D;
    line-height: 1.28; margin: 0 0 0.3rem;
  }
  .story:hover h3 { color: #2d8b8b; }
  .story p { font-size: 0.9rem; color: #6b7280; margin: 0 0 0.45rem; max-width: 60ch; }
  .story .chip { font-size: 0.6rem; }
  .readmore { font-size: 0.78rem; font-weight: 700; color: #2d8b8b; }
  .readmore::after { content: ' →'; }
  /* Story whose section has no detail route: still readable, but must not
     pretend to be clickable. Belt-and-braces — resolveItemUrl() should mean
     this almost never renders. */
  .no-link { cursor: default; }
  .no-link:hover h3, .no-link:hover h2 { color: inherit; }
  .no-link:hover::after { opacity: inherit; }
  .feed-empty { padding: 1.5rem 0; color: #6b7280; font-size: 0.9rem; }

  /* ── Sidebar ───────────────────────────────────────────────────── */
  .sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .side-card {
    background: white; border-radius: 10px; padding: 1.4rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07); border-top: 4px solid #4db8b8;
  }
  .side-card h3 { font-size: 1.05rem; font-weight: 800; color: #1B365D; margin: 0 0 0.4rem; }
  .side-card p { font-size: 0.83rem; color: #6b7280; line-height: 1.6; margin: 0 0 0.9rem; }
  .side-card.navy { background: linear-gradient(135deg, #1B365D 0%, #2d5a9e 100%); border-top-color: #1B365D; }
  .side-card.navy h3 { color: white; }
  .side-card.navy p { color: #93c5fd; }

  .side-form { display: flex; flex-direction: column; gap: 0.6rem; }
  .side-input {
    width: 100%; box-sizing: border-box; padding: 0.6rem 0.75rem; border: 1px solid #d1d5db;
    border-radius: 8px; font-size: 0.85rem; font-family: inherit;
  }
  .side-input:focus { outline: 2px solid #4db8b8; border-color: #4db8b8; }
  .side-consent { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.7rem; color: #6b7280; line-height: 1.45; }
  .side-consent input { margin-top: 0.15rem; }
  .side-consent a { color: #2d8b8b; }
  .side-btn {
    display: inline-block; background: #4db8b8; color: white; border: none; cursor: pointer;
    padding: 0.65rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem;
    text-decoration: none; text-align: center; transition: background 0.2s; font-family: inherit;
  }
  .side-btn:hover { background: #2d8b8b; }
  .side-btn.gold { background: #E8A33D; }
  .side-btn.gold:hover { background: #c98a2b; }
  .hidden-field { display: none; }

  /* ── Responsive ────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .news-body { grid-template-columns: 1fr; }
    .featured { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .story { grid-template-columns: 56px 1fr; gap: 0.8rem; }
    .story .day { font-size: 1.15rem; }
  }
</style>

<div class="page-wrap">
  <SectionHero
    title="Village News"
    subtitle="The latest from Smiths Lake Village — published by the community, for the community."
    accentHex={sectionSettings?.accentHex || '#1B365D'}
    backgroundImage={heroImage}
    overlayOpacity={sectionSettings?.overlayOpacity ?? 50}
  />

  <div class="content-wrap">
    <section class="section-block" aria-labelledby="news-heading">

      <div class="news-masthead">
        <span class="news-masthead-title" id="news-heading">What's happening</span>
        <span class="news-masthead-date">
          {new Date().toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>

      {newsItems.length > 0 ? (
        <>
          {featured.length > 0 && (
            <>
              <div class="lane-label"><span>Featured</span></div>
              <div class={`featured ${featured.length === 1 ? 'single' : ''}`}>
                {featured.map((item: any, i: number) => {
                  const acc = accentFor(item.section);
                  const Tag = item._url ? 'a' : 'div';
                  return (
                    <Tag href={item._url || undefined} class={`feat ${i === 1 ? 'secondary' : ''} ${item._url ? '' : 'no-link'}`}
                       style={`background-image: url('${item._img}');`} aria-label={item._url ? item.title : undefined}>
                      <div class="feat-body">
                        <span class="chip" style={`background: ${acc};`}>{getSectionDisplayName(item.section)}</span>
                        <h2>{item.title}</h2>
                        {i === 0 && item.description && <p>{trim(item.description, 170)}</p>}
                        <span class="feat-date">{formatDate(item.publishDate)}</span>
                      </div>
                    </Tag>
                  );
                })}
              </div>
            </>
          )}

          <div class="news-body">
            <div>
              <div class="more-label"><span>{featured.length > 0 ? 'More stories' : 'Latest stories'}</span></div>
              {listItems.length > 0 ? (
                <div role="list">
                  {listItems.map((item: any) => {
                    const acc = accentFor(item.section);
                    const dp = dateParts(item.publishDate);
                    const hasThumb = !!item._img;
                    const Tag = item._url ? 'a' : 'div';
                    return (
                      <Tag href={item._url || undefined} class={`story ${item._url ? '' : 'no-link'}`} style={`--acc: ${acc};`} role="listitem">
                        {hasThumb
                          ? <div class="thumb" style={`background-image: url('${item._img}');`} aria-hidden="true"></div>
                          : <div class="when"><div class="day">{dp.day}</div><div class="mon">{dp.mon}</div></div>}
                        <div>
                          <span class="chip" style={`background: ${acc};`}>{getSectionDisplayName(item.section)}</span>
                          <h3>{item.title}</h3>
                          {item.description && <p>{trim(item.description, 160)}</p>}
                          {item._url && <span class="readmore">Read more</span>}
                        </div>
                      </Tag>
                    );
                  })}
                </div>
              ) : (
                <p class="feed-empty">That's everything in the feed for now — more stories as the village makes them. Have news to share? <a href="/feedback/" style="color:#2d8b8b; font-weight:600;">Let us know</a>.</p>
              )}
            </div>

            <aside class="sidebar" aria-label="Community links">
              <!-- Newsletter signup (posts to existing Netlify 'newsletter' form) -->
              <div class="side-card">
                <h3>📬 Stay Connected</h3>
                <p>Get community news and updates delivered to your inbox.</p>
                <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/" class="side-form">
                  <input type="hidden" name="form-name" value="newsletter" />
                  <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>
                  <input type="text" name="first-name" class="side-input" placeholder="First name" required autocomplete="given-name" aria-label="First name" />
                  <input type="email" name="email" class="side-input" placeholder="Email address" required autocomplete="email" aria-label="Email address" />
                  <label class="side-consent">
                    <input type="checkbox" name="privacy-consent" required />
                    <span>I agree to receive community updates and can unsubscribe anytime. <a href="/privacy/">Privacy</a></span>
                  </label>
                  <button type="submit" class="side-btn">Subscribe</button>
                </form>
              </div>

              <!-- Have your say -->
              <div class="side-card navy">
                <h3>🗣️ Have Your Say</h3>
                <p>Current projects are open for community feedback — your voice shapes what happens next.</p>
                <a href="/projects/" class="side-btn gold">View open projects</a>
              </div>

              <!-- Local services -->
              <div class="side-card">
                <h3>🏘️ Local Services</h3>
                <p>Facilities, amenities, and services for residents and visitors.</p>
                <a href="/services/" class="side-btn">Browse the directory</a>
              </div>

              <!-- Community sponsors — renders nothing until a placement is live -->
              <SponsorStrip variant="sidebar" />
            </aside>
          </div>
        </>
      ) : (
        <div style="text-align:center; padding:2.5rem 2rem; background:white; border-radius:12px; border:2px dashed #d1d5db; color:#6b7280;" role="note">
          <div style="font-size:2rem;" aria-hidden="true">📰</div>
          <h3 style="font-size:1rem; color:#1B365D; margin:0.5rem 0;">No news just yet</h3>
          <p>Stories appear here when a news item is published in Notion (tick "Show in News Feed" and set a Publish Date).</p>
        </div>
      )}

    </section>
  </div>
</div>
</Layout>
