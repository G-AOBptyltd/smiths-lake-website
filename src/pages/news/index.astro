---
// Village News — local-masthead layout (June 2026 v2)
// Inspired by community mastheads (In The Cove / About Regional): photo splash,
// thumbnail strip, more-stories list, and a live sidebar.
// Feed rule: only items with "Show in News Feed" ✓ AND a "Publish Date", newest first.
import Layout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import { fetchNotionContent } from '../../lib/notion-unified.js';
import { fetchSectionSettingsBySlug } from '../../lib/notion-section-settings.js';
import { generateSlug, getSectionPath, getSectionColour, getSectionDisplayName } from '../../lib/notion-detail-pages.js';

// Section → gradient + icon fallback (used only when a story has no photo)
const SECTION_HERO_STYLES: Record<string, { gradient: string; icon: string }> = {
  'News':                         { gradient: 'linear-gradient(160deg, #0c2d5a 0%, #1B365D 50%, #4db8b8 100%)', icon: '📰' },
  'Groups & Activities':          { gradient: 'linear-gradient(160deg, #1e3a5f 0%, #5B9BD5 70%, #93c5fd 100%)', icon: '🎉' },
  'Services':                     { gradient: 'linear-gradient(160deg, #0c1a2e 0%, #1B365D 70%, #2d5a9e 100%)', icon: '🏘️' },
  'Services & Amenities':         { gradient: 'linear-gradient(160deg, #0c1a2e 0%, #1B365D 70%, #2d5a9e 100%)', icon: '🏘️' },
  'Environment & Sustainability': { gradient: 'linear-gradient(160deg, #064e3b 0%, #16A34A 70%, #4ade80 100%)', icon: '🌿' },
  'Emergency & Safety':           { gradient: 'linear-gradient(160deg, #7f1d1d 0%, #DC2626 70%, #ef4444 100%)', icon: '🔥' },
  'History & Culture':            { gradient: 'linear-gradient(160deg, #451a03 0%, #92400E 70%, #b45309 100%)', icon: '🏛️' },
};

function getHeroStyle(section: string) {
  return SECTION_HERO_STYLES[section] || { gradient: 'linear-gradient(160deg, #0c1a2e 0%, #1B365D 100%)', icon: '📋' };
}

function buildItemUrl(item: any) {
  const slug = item.slug || generateSlug(item.title);
  const section = item.section || '';
  if (section === 'News') return `/news/${slug}/`;
  return `/${getSectionPath(section)}/${slug}/`;
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
}
function formatDateShort(iso: string) {
  return new Date(iso).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
}

const sectionSettings = await fetchSectionSettingsBySlug('services');

let sectionHeroManifest: Record<string, string> = {};
let cardImageManifest: Record<string, string> = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const heroPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(heroPath)) sectionHeroManifest = JSON.parse(fs.readFileSync(heroPath, 'utf-8'));
  const cardPath = path.resolve(process.cwd(), 'public/images/cards/manifest.json');
  if (fs.existsSync(cardPath)) cardImageManifest = JSON.parse(fs.readFileSync(cardPath, 'utf-8'));
} catch (e) { /* manifests not yet generated */ }
const heroImage = sectionHeroManifest['services'] || null;

// ── The feed: deliberate news only ───────────────────────────────────────────
const allPublished = await fetchNotionContent({ requireShowOnWebsite: true });

const newsItems = allPublished
  .filter((item: any) => item.showInNewsFeed === true && item.publishDate)
  .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .map((item: any) => {
    const slug = item.slug || generateSlug(item.title);
    return { ...item, _url: buildItemUrl(item), _img: cardImageManifest[slug] || null };
  });

const leadStory   = newsItems[0] || null;
const secondStory = newsItems[1] || null;
const stripItems  = newsItems.slice(2, 6);
const moreItems   = newsItems.slice(6, 16);
---

<Layout
  title="Village News"
  description="The latest news and updates from Smiths Lake Village — published by the community, for the community."
>
<style>
  .page-wrap { background: #f7f9fc; }
  .content-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  .section-block { padding: 2.5rem 0 3.5rem; }

  .news-masthead {
    display: flex; align-items: baseline; justify-content: space-between;
    border-bottom: 3px solid #1B365D; padding-bottom: 0.5rem; margin-bottom: 1.5rem;
  }
  .news-masthead-title { font-size: 1.6rem; font-weight: 800; color: #1B365D; letter-spacing: -0.02em; }
  .news-masthead-date { font-size: 0.75rem; color: #9ca3af; }

  /* ── Splash: lead + second story, photos edge-to-edge ──────────── */
  .splash { display: grid; grid-template-columns: 2fr 1fr; gap: 6px; }
  .splash.single { grid-template-columns: 1fr; }

  .splash-story {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 420px; overflow: hidden; border-radius: 4px;
    background-size: cover; background-position: center; text-decoration: none;
  }
  .splash-story.secondary { min-height: 420px; }
  .splash-story::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(5,13,26,0.92) 0%, rgba(5,13,26,0.35) 45%, rgba(5,13,26,0.05) 70%);
    transition: background 0.25s ease;
  }
  .splash-story:hover::after {
    background: linear-gradient(to top, rgba(5,13,26,0.96) 0%, rgba(5,13,26,0.45) 50%, rgba(5,13,26,0.1) 75%);
  }
  .splash-icon {
    position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%);
    font-size: 110px; opacity: 0.14; pointer-events: none; user-select: none;
  }
  .splash-content { position: relative; z-index: 1; padding: 1.5rem; }
  .story-chip {
    display: inline-block; padding: 0.22rem 0.7rem; border-radius: 3px;
    font-size: 0.66rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: white; margin-bottom: 0.7rem;
  }
  .splash-hed {
    font-size: clamp(1.35rem, 2.6vw, 1.9rem); font-weight: 800; color: white;
    line-height: 1.18; margin: 0 0 0.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }
  .splash-story.secondary .splash-hed { font-size: clamp(1.05rem, 1.8vw, 1.3rem); }
  .splash-dek {
    font-size: 0.9rem; color: rgba(255,255,255,0.85); line-height: 1.55;
    margin: 0 0 0.5rem; max-width: 600px;
  }
  .story-date { font-size: 0.75rem; color: rgba(255,255,255,0.65); }

  /* ── Thumbnail strip ───────────────────────────────────────────── */
  .thumb-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 6px; }
  .thumb-tile {
    position: relative; min-height: 170px; display: flex; flex-direction: column; justify-content: flex-end;
    overflow: hidden; border-radius: 4px; background-size: cover; background-position: center;
    text-decoration: none;
  }
  .thumb-tile::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(5,13,26,0.92) 0%, rgba(5,13,26,0.25) 55%, transparent 75%);
  }
  .thumb-tile-icon {
    position: absolute; top: 32%; left: 50%; transform: translate(-50%, -50%);
    font-size: 44px; opacity: 0.2; pointer-events: none;
  }
  .thumb-tile-content { position: relative; z-index: 1; padding: 0.8rem; }
  .thumb-tile-hed { font-size: 0.85rem; font-weight: 700; color: white; line-height: 1.3; margin: 0.3rem 0 0; }
  .thumb-tile .story-chip { margin-bottom: 0; font-size: 0.58rem; padding: 0.16rem 0.5rem; }

  /* ── Body: more stories + sidebar ──────────────────────────────── */
  .news-body { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; margin-top: 2.25rem; }

  .more-label { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .more-label-text {
    font-size: 0.95rem; font-weight: 800; color: #1B365D; white-space: nowrap;
  }
  .more-label-line { flex: 1; height: 2px; background: #1B365D; opacity: 0.85; }

  .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; }
  .more-item { display: flex; gap: 0.875rem; text-decoration: none; align-items: flex-start; }
  .more-thumb {
    width: 84px; height: 64px; border-radius: 4px; flex-shrink: 0;
    background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center; font-size: 24px;
  }
  .more-meta { font-size: 0.68rem; color: #9ca3af; margin-bottom: 0.2rem; }
  .more-meta b { font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .more-hed { font-size: 0.9rem; font-weight: 700; color: #1B365D; line-height: 1.35; margin: 0; }
  .more-item:hover .more-hed { color: #2d8b8b; }

  .feed-empty { padding: 1.5rem 0; color: #6b7280; font-size: 0.9rem; }

  /* ── Sidebar ───────────────────────────────────────────────────── */
  .sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
  .side-card {
    background: white; border-radius: 10px; padding: 1.4rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07); border-top: 4px solid #4db8b8;
  }
  .side-card h3 { font-size: 1.05rem; font-weight: 800; color: #1B365D; margin: 0 0 0.4rem; }
  .side-card p { font-size: 0.83rem; color: #6b7280; line-height: 1.6; margin: 0 0 0.9rem; }
  .side-card.navy { background: linear-gradient(135deg, #1B365D 0%, #2d5a9e 100%); border-top-color: #1B365D; }
  .side-card.navy h3 { color: white; }
  .side-card.navy p { color: #93c5fd; }

  .side-form { display: flex; flex-direction: column; gap: 0.6rem; }
  .side-input {
    width: 100%; box-sizing: border-box; padding: 0.6rem 0.75rem; border: 1px solid #d1d5db;
    border-radius: 8px; font-size: 0.85rem; font-family: inherit;
  }
  .side-input:focus { outline: 2px solid #4db8b8; border-color: #4db8b8; }
  .side-consent { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.7rem; color: #6b7280; line-height: 1.45; }
  .side-consent input { margin-top: 0.15rem; }
  .side-consent a { color: #2d8b8b; }
  .side-btn {
    display: inline-block; background: #4db8b8; color: white; border: none; cursor: pointer;
    padding: 0.65rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem;
    text-decoration: none; text-align: center; transition: background 0.2s; font-family: inherit;
  }
  .side-btn:hover { background: #2d8b8b; }
  .side-btn.gold { background: #E8A33D; }
  .side-btn.gold:hover { background: #c98a2b; }
  .hidden-field { display: none; }

  /* ── Responsive ────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .news-body { grid-template-columns: 1fr; }
    .thumb-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .splash { grid-template-columns: 1fr; }
    .splash-story { min-height: 300px; }
    .splash-story.secondary { min-height: 230px; }
    .more-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="page-wrap">
  <SectionHero
    title="Village News"
    subtitle="The latest from Smiths Lake Village — published by the community, for the community."
    accentHex={sectionSettings?.accentHex || '#1B365D'}
    backgroundImage={heroImage}
    overlayOpacity={sectionSettings?.overlayOpacity ?? 50}
  />

  <div class="content-wrap">
    <section class="section-block" aria-labelledby="news-heading">

      <div class="news-masthead">
        <span class="news-masthead-title" id="news-heading">What's happening</span>
        <span class="news-masthead-date">
          {new Date().toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>

      {leadStory ? (
        <>
          <!-- Splash: lead + second story -->
          <div class={`splash ${secondStory ? '' : 'single'}`}>
            {[{ item: leadStory, cls: '' }, ...(secondStory ? [{ item: secondStory, cls: 'secondary' }] : [])].map(({ item, cls }) => {
              const style = getHeroStyle(item.section);
              const bg = item._img ? `background-image: url('${item._img}');` : `background: ${style.gradient};`;
              return (
                <a href={item._url} class={`splash-story ${cls}`} style={bg} aria-label={item.title}>
                  {!item._img && <span class="splash-icon" aria-hidden="true">{style.icon}</span>}
                  <div class="splash-content">
                    <span class="story-chip" style={`background: ${getSectionColour(item.section)};`}>
                      {getSectionDisplayName(item.section)}
                    </span>
                    <h2 class="splash-hed">{item.title}</h2>
                    {!cls && item.description && (
                      <p class="splash-dek">{item.description.substring(0, 170)}{item.description.length > 170 ? '…' : ''}</p>
                    )}
                    <span class="story-date">{formatDate(item.publishDate)}</span>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- Thumbnail strip -->
          {stripItems.length > 0 && (
            <div class="thumb-strip">
              {stripItems.map((item: any) => {
                const style = getHeroStyle(item.section);
                const bg = item._img ? `background-image: url('${item._img}');` : `background: ${style.gradient};`;
                return (
                  <a href={item._url} class="thumb-tile" style={bg} aria-label={item.title}>
                    {!item._img && <span class="thumb-tile-icon" aria-hidden="true">{style.icon}</span>}
                    <div class="thumb-tile-content">
                      <span class="story-chip" style={`background: ${getSectionColour(item.section)};`}>
                        {getSectionDisplayName(item.section)}
                      </span>
                      <p class="thumb-tile-hed">{item.title}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          )}

          <!-- Body: more stories + sidebar -->
          <div class="news-body">
            <div>
              <div class="more-label">
                <span class="more-label-text">More stories</span>
                <span class="more-label-line" aria-hidden="true"></span>
              </div>
              {moreItems.length > 0 ? (
                <div class="more-grid" role="list">
                  {moreItems.map((item: any) => {
                    const style = getHeroStyle(item.section);
                    const thumbStyle = item._img
                      ? `background-image: url('${item._img}');`
                      : `background: ${style.gradient};`;
                    return (
                      <a href={item._url} class="more-item" role="listitem">
                        <div class="more-thumb" style={thumbStyle} aria-hidden="true">{!item._img && style.icon}</div>
                        <div>
                          <div class="more-meta">
                            <b style={`color: ${getSectionColour(item.section)};`}>{getSectionDisplayName(item.section)}</b>
                            &nbsp;·&nbsp;{formatDateShort(item.publishDate)}
                          </div>
                          <p class="more-hed">{item.title}</p>
                        </div>
                      </a>
                    );
                  })}
                </div>
              ) : (
                <p class="feed-empty">That's everything for now — more stories as the village makes them. Have news to share? <a href="/feedback/" style="color:#2d8b8b; font-weight:600;">Let us know</a>.</p>
              )}
            </div>

            <aside class="sidebar" aria-label="Community links">
              <!-- Newsletter signup (posts to existing Netlify 'newsletter' form) -->
              <div class="side-card">
                <h3>📬 Stay Connected</h3>
                <p>Get community news and updates delivered to your inbox.</p>
                <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/" class="side-form">
                  <input type="hidden" name="form-name" value="newsletter" />
                  <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>
                  <input type="text" name="first-name" class="side-input" placeholder="First name" required autocomplete="given-name" aria-label="First name" />
                  <input type="email" name="email" class="side-input" placeholder="Email address" required autocomplete="email" aria-label="Email address" />
                  <label class="side-consent">
                    <input type="checkbox" name="privacy-consent" required />
                    <span>I agree to receive community updates and can unsubscribe anytime. <a href="/privacy/">Privacy</a></span>
                  </label>
                  <button type="submit" class="side-btn">Subscribe</button>
                </form>
              </div>

              <!-- Have your say -->
              <div class="side-card navy">
                <h3>🗣️ Have Your Say</h3>
                <p>Current projects are open for community feedback — your voice shapes what happens next.</p>
                <a href="/projects/" class="side-btn gold">View open projects</a>
              </div>

              <!-- Local services -->
              <div class="side-card">
                <h3>🏘️ Local Services</h3>
                <p>Facilities, amenities, and services for residents and visitors.</p>
                <a href="/services/" class="side-btn">Browse the directory</a>
              </div>
            </aside>
          </div>
        </>
      ) : (
        <div style="text-align:center; padding:2.5rem 2rem; background:white; border-radius:12px; border:2px dashed #d1d5db; color:#6b7280;" role="note">
          <div style="font-size:2rem;" aria-hidden="true">📰</div>
          <h3 style="font-size:1rem; color:#1B365D; margin:0.5rem 0;">No news just yet</h3>
          <p>Stories appear here when a news item is published in Notion (tick "Show in News Feed" and set a Publish Date).</p>
        </div>
      )}

    </section>
  </div>
</div>
</Layout>
