---
// Environment & Sustainability Index Page
import Layout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProjectStatusRegister from '../../components/ProjectStatusRegister.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch ALL Environment items
const items = await fetchItemsBySection('Environment');

// Separate into active programs and projects
const programs = items.filter(item => 
  item.status === 'Active' || item.status === 'Published'
);
const projects = items.filter(item => 
  item.status !== 'Active' && item.status !== 'Published'
);

// Category emoji mapping
const categoryEmojis = {
  'Waterways': '💧',
  'Conservation': '🌿',
  'Sustainability': '♻️',
  'Bushland': '🌳'
};
---

<Layout 
  title="Environment & Sustainability"
  description="Lake health monitoring, conservation programs, and environmental initiatives"
>
  <style>
    .environment-page {
      background: #f7f9fc;
    }
    
    .environment-hero {
      background: linear-gradient(135deg, rgba(22, 163, 74, 0.95), rgba(34, 197, 94, 0.9)),
                  url('/images/smiths-lake-aerial.jpg') center/cover;
      color: white;
      padding: 5rem 1rem;
      text-align: center;
    }
    
    .hero-content {
      max-width: 900px;
      margin: 0 auto;
    }
    
    .environment-hero h1 {
      color: white;
      font-size: 3rem;
      margin-bottom: 1rem;
    }
    
    .environment-hero p {
      font-size: 1.25rem;
      opacity: 0.95;
    }
    
    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1rem;
    }
    
    .section-group {
      margin-bottom: 4rem;
    }
    
    .section-header {
      margin-bottom: 2rem;
    }
    
    .section-header h2 {
      color: #1B365D;
      font-size: 1.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #16a34a;
    }
    
    .items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }
    
    .item-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      border-top: 4px solid #16a34a;
      display: flex;
      flex-direction: column;
    }
    
    .item-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }
    
    .card-header {
      padding: 1.5rem;
      border-bottom: 1px solid #f3f4f6;
    }
    
    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1B365D;
      margin: 0 0 0.75rem 0;
    }
    
    .card-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    
    .card-body {
      padding: 1.5rem;
      flex: 1;
    }
    
    .card-description {
      color: #4b5563;
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    
    .card-details {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.9375rem;
    }
    
    .detail-row {
      display: flex;
      gap: 0.75rem;
    }
    
    .detail-icon {
      flex-shrink: 0;
      width: 20px;
    }
    
    .detail-label {
      font-weight: 600;
      color: #16a34a;
      margin-right: 0.25rem;
    }
    
    .card-footer {
      padding: 1rem 1.5rem;
      background: #f9fafb;
      border-top: 1px solid #e5e7eb;
    }
    
    .external-link {
      color: #16a34a;
      text-decoration: none;
      font-weight: 600;
    }
    
    .external-link:hover {
      color: #15803d;
    }
    
    @media (max-width: 768px) {
      .environment-hero h1 {
        font-size: 2rem;
      }
      
      .items-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="environment-page">
    <div class="environment-hero">
      <div class="hero-content">
        <h1>Environment & Sustainability</h1>
        <p>Lake health monitoring, foreshore management, wildlife conservation, and environmental programs</p>
      </div>
    </div>
    
    <div class="content-section">
      {programs.length > 0 && (
        <div class="section-group">
          <div class="section-header">
            <h2>Active Programs</h2>
            <p>Our ongoing environmental initiatives and conservation efforts</p>
          </div>
          <div class="items-grid">
            {programs.map(item => (
              <div class="item-card">
                <div class="card-header">
                  <h3 class="card-title">{item.title}</h3>
                  <div class="card-badges">
                    <CategoryBadge category={item.category} size="sm" />
                    {item.status && <StatusBadge status={item.status} />}
                  </div>
                </div>
                <div class="card-body">
                  {item.description && (
                    <p class="card-description">{item.description}</p>
                  )}
                  <div class="card-details">
                    {item.locationArea && (
                      <div class="detail-row">
                        <span class="detail-icon">📍</span>
                        <div>
                          <span class="detail-label">Location:</span>
                          {item.locationArea}
                        </div>
                      </div>
                    )}
                    {item.partnerOrganisations && (
                      <div class="detail-row">
                        <span class="detail-icon">🤝</span>
                        <div>
                          <span class="detail-label">Partners:</span>
                          {item.partnerOrganisations}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                {item.websiteUrl && (
                  <div class="card-footer">
                    <a href={item.websiteUrl} target="_blank" rel="noopener" class="external-link">
                      Learn More →
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
      
      {projects.length > 0 && (
        <div class="section-group">
          <div class="section-header">
            <h2>Environmental Projects</h2>
            <p>Initiatives in planning and development stages</p>
          </div>
          
          <ProjectStatusRegister projects={projects} />
        </div>
      )}
      
      {items.length === 0 && (
        <div style="text-align: center; padding: 3rem; color: #6b7280;">
          <p>Environmental information is being updated. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
