---
// Emergency & Safety Index Page - Simplified
import Layout from '../../layouts/BaseLayout.astro';
import ExpandableCard from '../../components/ExpandableCard.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch all Emergency & Safety items
const items = await fetchItemsBySection('Emergency & Safety');

// Group items by category
const categories = {
  'Bushfire': items.filter(item => item.category === 'Bushfire'),
  'Flood': items.filter(item => item.category === 'Flood'),
  'Police': items.filter(item => item.category === 'Police'),
  'Surf Life Saving': items.filter(item => item.category === 'Surf Life Saving'),
  'Evacuation': items.filter(item => item.category === 'Evacuation'),
};
---

<Layout 
  title="Emergency & Safety"
  description="Emergency services, evacuation plans, and safety information for Smiths Lake community"
>
  <style>
    .emergency-page {
      background: #f7f9fc;
      padding: 2rem 0;
    }
    .emergency-hero {
      background: #dc2626;
      color: white;
      padding: 3rem 1rem;
      text-align: center;
      margin-bottom: 2rem;
    }
    .emergency-hero h1 {
      color: white;
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    .emergency-contacts {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-top: 2rem;
      flex-wrap: wrap;
    }
    .emergency-btn {
      background: white;
      color: #dc2626;
      padding: 1rem 1.5rem;
      text-decoration: none;
      font-weight: bold;
      border-radius: 8px;
      display: inline-block;
    }
    .emergency-btn:hover {
      background: #fee2e2;
    }
    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    .category-group {
      margin-bottom: 3rem;
    }
    .category-group h2 {
      color: #1B365D;
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #1B365D;
    }
    .items-grid {
      display: grid;
      gap: 1.5rem;
    }
    .no-items {
      padding: 2rem;
      background: white;
      border-radius: 8px;
      text-align: center;
      color: #6b7280;
    }
  </style>

  <div class="emergency-page">
    <div class="emergency-hero">
      <h1>Emergency & Safety</h1>
      <p>Emergency services, evacuation plans, and safety information for the Smiths Lake community.</p>
      
      <div class="emergency-contacts">
        <a href="tel:000" class="emergency-btn">
          🚨 Emergency: 000
        </a>
        <a href="tel:131444" class="emergency-btn">
          Police (Non-Emergency): 131 444
        </a>
      </div>
    </div>
    
    <div class="content-section">
      {Object.entries(categories).map(([category, categoryItems]) => 
        categoryItems.length > 0 && (
          <div class="category-group">
            <h2>{category}</h2>
            <div class="items-grid">
              {categoryItems.map(item => (
                <ExpandableCard item={item} section="Emergency & Safety" />
              ))}
            </div>
          </div>
        )
      )}
      
      {items.length === 0 && (
        <div class="no-items">
          <p>Emergency information is being updated. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
