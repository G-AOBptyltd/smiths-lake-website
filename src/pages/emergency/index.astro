---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const emergencyContacts = [
  { service: 'Police, Fire, Ambulance', number: '000', type: 'Emergency' },
  { service: 'State Emergency Service (SES)', number: '132 500', type: 'Floods & Storms' },
  { service: 'Rural Fire Service', number: '1800 679 737', type: 'Bush Fire Info' },
  { service: 'Poisons Information', number: '13 11 26', type: '24 Hours' },
  { service: 'Police Assistance Line', number: '131 444', type: 'Non-Emergency' },
];

const safetyResources = [
  {
    id: 'evacuation',
    title: 'Evacuation Plans',
    content: 'Know your evacuation routes and assembly points. In an emergency, follow directions from emergency services.',
  },
  {
    id: 'bushfire',
    title: 'Bushfire Brigade',
    content: 'Our local Rural Fire Service brigade serves the Smiths Lake area. Volunteers are always welcome.',
  },
  {
    id: 'surf',
    title: 'Surf Life Saving',
    content: 'Volunteer surf lifesavers patrol local beaches during summer. Learn about water safety and beach conditions.',
  },
  {
    id: 'police',
    title: 'Police Services',
    content: 'Forster Police Station serves our area. Report suspicious activity to keep our community safe.',
  },
  {
    id: 'flood',
    title: 'Flood Preparedness',
    content: 'Know whether your property is in a flood-prone area and have a plan for protecting your home and family.',
  },
];
---

<BaseLayout 
  title="Emergency & Safety" 
  description="Emergency contacts, evacuation plans, and safety resources for Smiths Lake Village."
>
  <Hero 
    title="Emergency & Safety"
    subtitle="Critical safety information and emergency resources for our community."
    size="small"
  />
  
  <section class="emergency-contacts">
    <div class="container">
      <div class="emergency-banner">
        <h2>Emergency Contacts</h2>
        <p class="emergency-lead">In a life-threatening emergency, always call <strong>000</strong> first.</p>
        
        <div class="contacts-grid">
          {emergencyContacts.map((contact) => (
            <div class="contact-card">
              <span class="contact-type">{contact.type}</span>
              <span class="contact-service">{contact.service}</span>
              <a href={`tel:${contact.number.replace(/\s/g, '')}`} class="contact-number">
                {contact.number}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container container--narrow">
      <h2 class="section-title">Safety Resources</h2>
      
      <div class="resources-list">
        {safetyResources.map((resource) => (
          <article id={resource.id} class="resource-card">
            <div class="resource-content">
              <h3>{resource.title}</h3>
              <p>{resource.content}</p>
              <a href={`#${resource.id}`} class="resource-link">View resources →</a>
            </div>
          </article>
        ))}
      </div>
      
      <aside class="prepare-section">
        <h2>Be Prepared</h2>
        <ul>
          <li>Create a household emergency plan</li>
          <li>Prepare an emergency kit with essentials</li>
          <li>Know your evacuation routes</li>
          <li>Keep important documents in a safe, accessible place</li>
          <li>Stay informed via ABC Radio and official channels</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .emergency-contacts {
    background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
    padding: var(--space-10) 0;
  }
  
  .emergency-banner {
    text-align: center;
    color: var(--color-white);
  }
  
  .emergency-banner h2 {
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }
  
  .emergency-lead {
    font-size: var(--text-xl);
    margin-bottom: var(--space-8);
  }
  
  .emergency-lead strong {
    font-size: var(--text-3xl);
    display: inline-block;
    margin-left: var(--space-2);
  }
  
  .contacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto;
  }
  
  .contact-card {
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }
  
  .contact-type {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
    margin-bottom: var(--space-1);
  }
  
  .contact-service {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  
  .contact-number {
    display: block;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
    text-decoration: none;
  }
  
  .contact-number:hover {
    text-decoration: underline;
  }
  
  .section-title {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  
  .resources-list {
    margin-bottom: var(--space-12);
  }
  
  .resource-card {
    padding: var(--space-6);
    border-left: 4px solid var(--color-error);
    background: var(--color-off-white);
    margin-bottom: var(--space-6);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  
  .resource-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  
  .resource-card p {
    color: var(--color-gray-700);
    margin-bottom: var(--space-3);
  }
  
  .resource-link {
    color: var(--color-golden-dark);
    font-weight: 600;
    text-decoration: none;
  }
  
  .resource-link:hover {
    color: var(--color-golden);
  }
  
  .prepare-section {
    background: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
  }
  
  .prepare-section h2 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .prepare-section ul {
    padding-left: var(--space-6);
  }
  
  .prepare-section li {
    margin-bottom: var(--space-2);
    color: var(--color-gray-200);
  }
</style>
