---
// History & Culture Index Page
import Layout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DocumentLibrary from '../../components/DocumentLibrary.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch ALL History & Culture items
const items = await fetchItemsBySection('History & Culture');

// Group by category
const indigenousHeritage = items.filter(item => item.category === 'Indigenous Heritage');
const earlySettlement = items.filter(item => item.category === 'Early Settlement');
const industryWork = items.filter(item => item.category === 'Industry & Work');
---

<Layout 
  title="History & Culture"
  description="Discover the stories that shaped our community and the culture that defines us"
>
  <style>
    .history-page {
      background: #f7f9fc;
    }

    /* Hero */
    .history-hero {
      background: linear-gradient(135deg, rgba(27,54,93,0.95), rgba(91,155,213,0.85)),
                  url('/images/smiths-lake-aerial.jpg') center/cover;
      color: white;
      padding: 5rem 1rem;
      text-align: center;
    }

    .hero-content {
      max-width: 900px;
      margin: 0 auto;
    }

    .history-hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .history-hero p {
      font-size: 1.25rem;
      opacity: 0.95;
    }

    /* Acknowledgement */
    .acknowledgement-box {
      max-width: 900px;
      margin: 3rem auto;
      padding: 3rem 2rem;
      background: linear-gradient(135deg, #1B365D, #2B4A7D);
      color: white;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 8px 24px rgba(27,54,93,0.2);
    }

    .acknowledgement-box h2 {
      color: #F5A623;
      margin-bottom: 1.5rem;
    }

    .content-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem 3rem;
    }

    .category-section {
      margin-bottom: 4rem;
    }

    .category-header h2 {
      color: #1B365D;
      border-bottom: 3px solid #1B365D;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }

    .category-intro {
      color: #4b5563;
      margin-bottom: 1.5rem;
    }

    .timeline-grid {
      display: grid;
      gap: 2rem;
    }

    .history-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      border-left: 6px solid #F5A623;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .card-timeline {
      background: linear-gradient(135deg, #1B365D, #2B4A7D);
      color: white;
      padding: 1rem;
      min-width: 120px;
      text-align: center;
      border-radius: 8px;
    }

    .timeline-era {
      font-size: 0.75rem;
      opacity: 0.9;
    }

    .timeline-year {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .card-title {
      font-size: 1.25rem;
      color: #1B365D;
      margin-bottom: 0.75rem;
    }

    .card-description {
      color: #4b5563;
      margin-bottom: 1rem;
    }

    .card-link {
      color: #5B9BD5;
      font-weight: 600;
      text-decoration: none;
    }

    .card-link:hover {
      color: #1B365D;
    }

    @media (max-width: 768px) {
      .history-card {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="history-page">
    <!-- Hero -->
    <div class="history-hero">
      <div class="hero-content">
        <h1>History & Culture</h1>
        <p>Discover the stories that shaped our community.</p>
      </div>
    </div>

    <!-- Acknowledgement -->
    <div class="content-section">
      <div class="acknowledgement-box">
        <h2>Acknowledgement of Country</h2>
        <p>
          We acknowledge the Worimi people as the traditional custodians of the land on which Smiths Lake Village is located.
          We pay our respects to Elders past, present and emerging.
        </p>
      </div>
    </div>

    <!-- Indigenous Heritage -->
    {indigenousHeritage.length > 0 && (
      <div class="content-section category-section">
        <div class="category-header">
          <h2>Worimi Country</h2>
          <p class="category-intro">
            Smiths Lake and surrounding lands are the traditional country of the Worimi people.
          </p>
        </div>
        <div class="timeline-grid">
          {indigenousHeritage.map(item => (
            <div class="history-card">
              {item.yearEra && (
                <div class="card-timeline">
                  <div class="timeline-era">Ancient</div>
                  <div class="timeline-year">{item.yearEra}</div>
                </div>
              )}
              <div>
                <h3 class="card-title">{item.title}</h3>
                <div class="card-description">{item.description}</div>
                {item.websiteUrl && (
                  <a href={item.websiteUrl} class="card-link" target="_blank" rel="noopener">
                    Learn more →
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Early Settlement -->
    {earlySettlement.length > 0 && (
      <div class="content-section category-section">
        <div class="category-header">
          <h2>Early Settlement</h2>
        </div>
        <div class="timeline-grid">
          {earlySettlement.map(item => (
            <div class="history-card">
              {item.yearEra && (
                <div class="card-timeline">
                  <div class="timeline-era">Historic</div>
                  <div class="timeline-year">{item.yearEra}</div>
                </div>
              )}
              <div>
                <h3 class="card-title">{item.title}</h3>
                <div class="card-description">{item.description}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Industry -->
    {industryWork.length > 0 && (
      <div class="content-section category-section">
        <div class="category-header">
          <h2>Industry & Work</h2>
        </div>
        <div class="timeline-grid">
          {industryWork.map(item => (
            <div class="history-card">
              {item.yearEra && (
                <div class="card-timeline">
                  <div class="timeline-era">Industrial</div>
                  <div class="timeline-year">{item.yearEra}</div>
                </div>
              )}
              <div>
                <h3 class="card-title">{item.title}</h3>
                <div class="card-description">{item.description}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 📚 Notion Document Library -->
    <div class="content-section">
      <DocumentLibrary
        displayLocation="History"
        title="Historical Documents & References"
        subtitle="Primary sources, maps, reports and reference material"
        showSummary={true}
      />
    </div>
  </div>
</Layout>
