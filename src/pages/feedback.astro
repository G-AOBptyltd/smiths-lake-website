---
/**
 * Feedback Form Page
 * Accepts general community feedback and project-specific feedback
 * 
 * URL Parameters:
 * - project: Pre-fills the project field when linked from Project Hub
 * 
 * Note: Uses client-side JS to read URL params since Astro static builds
 * don't have access to runtime URL parameters
 * 
 * @updated 26 January 2026
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// Per-village strings (env override ?? exact historical Smiths Lake strings —
// mirrors src/config/village.js). Read inline instead of importing village.js:
// adding ANY new import to this page can reshuffle Vite's CSS chunk merging
// and break the byte-parity invariant for default (Smiths Lake) builds — see
// the warning in src/pages/contact.astro.
const villageDisplay = import.meta.env.PUBLIC_VILLAGE_DISPLAY_NAME || 'Smiths Lake Village';
const entityShort = import.meta.env.PUBLIC_ENTITY_SHORT || 'PPCA';
---

<BaseLayout
  title="Share Your Comments"
  description={`Share your ideas and suggestions for improving ${villageDisplay}.`}
>
  <Hero
    title="Share Your Comments"
    subtitle="Your ideas help shape our community's future."
    size="small"
  />
  
  <section class="section">
    <div class="container container--narrow">
      <div class="feedback-intro">
        <!-- Project context - shown via JS when ?project= parameter exists -->
        <div id="project-context" class="project-context" style="display: none;">
          <p class="project-badge">
            📋 Providing feedback on: <strong id="project-name-display"></strong>
          </p>
          <p>
            Your feedback on this project will be reviewed by the {entityShort} committee
            and may influence the final outcomes. All submissions are valued.
          </p>
        </div>
        
        <!-- General intro - hidden via JS when project parameter exists -->
        <div id="general-intro">
          <p>
            We want to hear from you! Share your ideas, suggestions, or concerns about
            our community. Your feedback helps {entityShort} understand what matters most to
            residents and guides our advocacy efforts.
          </p>
          <p>
            <strong>What happens to your feedback?</strong> All submissions are reviewed
            by the {entityShort} committee. Ideas that align with community priorities may be
            developed into formal submissions to MidCoast Council.
          </p>
        </div>
      </div>
      
      <form 
        name="feedback" 
        method="POST" 
        data-netlify="true" 
        netlify-honeypot="bot-field"
        class="feedback-form"
        action="/thank-you/"
        id="feedback-form"
      >
        <input type="hidden" name="form-name" value="feedback" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>
        
        <!-- Project field - shown via JS when ?project= parameter exists -->
        <div id="project-field-group" class="form-group" style="display: none;">
          <label for="project" class="form-label">Related Project</label>
          <input 
            type="text" 
            id="project" 
            name="project" 
            class="form-input form-input--readonly" 
            value="General Feedback"
            readonly
          />
        </div>
        
        <!-- Hidden project field for non-project feedback (default) -->
        <input type="hidden" id="project-hidden" name="project-default" value="General Feedback" />
        
        <div class="form-row">
          <div class="form-group">
            <label for="name" class="form-label form-label--required">Your Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="form-input" 
              autocomplete="name"
              required
            />
            <p class="form-help">Required for project feedback.</p>
          </div>
          
          <div class="form-group">
            <label for="email" class="form-label form-label--required">Email Address</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-input" 
              autocomplete="email"
              required
            />
            <p class="form-help">Required so we can follow up on your feedback.</p>
          </div>
        </div>
        
        <!-- Category dropdown - hidden via JS when project parameter exists -->
        <div id="category-group" class="form-group">
          <label for="category" class="form-label form-label--required">Category</label>
          <select id="category" name="category" class="form-select" required>
            <option value="">Please select...</option>
            <option value="project-hub">Community Project</option>
            <option value="services">Services & Amenities</option>
            <option value="environment">Environment & Conservation</option>
            <option value="safety">Safety & Emergency</option>
            <option value="groups">Groups & Activities</option>
            <option value="infrastructure">Roads & Infrastructure</option>
            <option value="council">Council Submission Idea</option>
            <option value="website">Website Feedback</option>
            <option value="other">Other</option>
          </select>
        </div>
        
        <!-- Hidden category for project feedback -->
        <input type="hidden" id="category-hidden" name="category-default" value="" disabled />
        
        <div class="form-group">
          <label for="title" class="form-label form-label--required">Capture your comments</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            class="form-input" 
            required 
            placeholder="Brief summary of your idea or concern"
          />
        </div>
        
        <div class="form-group">
          <label for="details" class="form-label form-label--required">Details</label>
          <textarea 
            id="details" 
            name="details" 
            class="form-textarea" 
            rows="8" 
            required
            placeholder="Describe your idea, suggestion, or concern in detail..."
          ></textarea>
        </div>
        
        <div class="form-group">
          <label for="priority" class="form-label">How important is this to you?</label>
          <select id="priority" name="priority" class="form-select">
            <option value="">Please select...</option>
            <option value="high">Very Important - Needs urgent attention</option>
            <option value="medium">Important - Should be addressed</option>
            <option value="low">Nice to Have - When resources allow</option>
          </select>
        </div>
        
        <div class="form-group form-group--checkbox">
          <label class="checkbox-label">
            <input type="checkbox" name="subscribe" value="yes" />
            <span id="subscribe-label">Email me updates about community initiatives</span>
          </label>
        </div>
        
        <div class="form-group">
          <button type="submit" class="btn btn--primary btn--lg btn--full">Submit your comments</button>
        </div>
        
        <!-- Back to project link - shown via JS when project parameter exists -->
        <p id="back-link" class="form-back" style="display: none;">
          <a href="/projects/" id="back-link-anchor">← Back to Projects</a>
        </p>
      </form>
      
      <aside class="feedback-note">
        <h2>🔒 Privacy Note</h2>
        <p>
          Your feedback is stored securely and reviewed only by {entityShort} committee members.
          Anonymous submissions are welcome. We will never share your personal
          information without your consent.
        </p>
        <p>
          <a href="/privacy/">Read our full Privacy Policy</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .container--narrow {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  
  .section {
    padding: 3rem 0;
  }
  
  .feedback-intro {
    max-width: 700px;
    margin: 0 auto 2rem;
  }
  
  .feedback-intro p {
    font-size: 1.1rem;
    color: #374151;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  
  .project-context {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border: 2px solid #0ea5e9;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .project-badge {
    font-size: 1.1rem;
    color: #0369a1;
    margin-bottom: 0.75rem;
  }
  
  .project-context p:last-child {
    margin-bottom: 0;
    color: #374151;
  }
  
  .feedback-form {
    background: #f8fafc;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    border: 1px solid #e2e8f0;
  }
  
  .hidden {
    display: none;
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-group--checkbox {
    margin-top: 0.5rem;
  }
  
  .form-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #1f2937;
  }
  
  .form-label--required::after {
    content: ' *';
    color: #dc2626;
  }
  
  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #4db8b8;
    box-shadow: 0 0 0 3px rgba(77, 184, 184, 0.15);
  }
  
  .form-input--readonly {
    background-color: #f1f5f9;
    color: #1B365D;
    font-weight: 600;
    cursor: not-allowed;
  }
  
  .form-textarea {
    resize: vertical;
    min-height: 150px;
  }
  
  .form-help {
    font-size: 0.85rem;
    color: #6b7280;
    margin-top: 0.25rem;
  }
  
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }
  
  .checkbox-label input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
  }
  
  .checkbox-label span {
    color: #374151;
    line-height: 1.5;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    border-radius: 6px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .btn--primary {
    background: #1B365D;
    color: white;
    border-color: #1B365D;
  }
  
  .btn--primary:hover {
    background: #142847;
    border-color: #142847;
  }
  
  .btn--lg {
    padding: 1rem 2rem;
    font-size: 1.1rem;
  }
  
  .btn--full {
    width: 100%;
  }
  
  .form-back {
    text-align: center;
    margin-top: 1rem;
  }
  
  .form-back a {
    color: #4db8b8;
    text-decoration: none;
    font-weight: 500;
  }
  
  .form-back a:hover {
    text-decoration: underline;
  }
  
  .feedback-note {
    background: #1B365D;
    color: white;
    padding: 1.5rem;
    border-radius: 12px;
  }
  
  .feedback-note h2 {
    color: white;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }
  
  .feedback-note p {
    color: #cbd5e1;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }
  
  .feedback-note p:last-child {
    margin-bottom: 0;
  }
  
  .feedback-note a {
    color: #7dd3fc;
  }
  
  .feedback-note a:hover {
    color: white;
  }
</style>

<script>
  // Client-side script to handle URL parameters
  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const projectParam = urlParams.get('project');
    
    if (projectParam && projectParam.trim() !== '') {
      // We have a project parameter - customize the form
      const projectName = decodeURIComponent(projectParam);
      
      // Show project context banner
      const projectContext = document.getElementById('project-context');
      if (projectContext) {
        projectContext.style.display = 'block';
      }
      
      // Set project name in banner
      const projectNameDisplay = document.getElementById('project-name-display');
      if (projectNameDisplay) {
        projectNameDisplay.textContent = projectName;
      }
      
      // Hide general intro
      const generalIntro = document.getElementById('general-intro');
      if (generalIntro) {
        generalIntro.style.display = 'none';
      }
      
      // Show and populate project field
      const projectFieldGroup = document.getElementById('project-field-group');
      const projectInput = document.getElementById('project');
      if (projectFieldGroup && projectInput) {
        projectFieldGroup.style.display = 'block';
        projectInput.value = projectName;
        projectInput.name = 'project'; // Ensure it's named correctly for form submission
      }
      
      // Disable the hidden default project field
      const projectHidden = document.getElementById('project-hidden');
      if (projectHidden) {
        projectHidden.disabled = true;
      }
      
      // Hide category dropdown and set hidden category value
      const categoryGroup = document.getElementById('category-group');
      const categorySelect = document.getElementById('category');
      const categoryHidden = document.getElementById('category-hidden');
      
      if (categoryGroup && categorySelect && categoryHidden) {
        categoryGroup.style.display = 'none';
        categorySelect.removeAttribute('required');
        categorySelect.disabled = true;
        categorySelect.name = 'category-disabled';
        
        categoryHidden.disabled = false;
        categoryHidden.name = 'category';
        categoryHidden.value = 'project-hub';
      }
      
      // Update placeholder text
      const titleInput = document.getElementById('title');
      if (titleInput) {
        titleInput.placeholder = `Your feedback on ${projectName}`;
      }
      
      const detailsTextarea = document.getElementById('details');
      if (detailsTextarea) {
        detailsTextarea.placeholder = 'Share your thoughts, suggestions, concerns, or questions about this project...';
      }
      
      // Update subscribe label
      const subscribeLabel = document.getElementById('subscribe-label');
      if (subscribeLabel) {
        subscribeLabel.textContent = 'Email me updates about this project';
      }
      
      // Show and configure back link
      const backLink = document.getElementById('back-link');
      const backLinkAnchor = document.getElementById('back-link-anchor');
      if (backLink && backLinkAnchor) {
        backLink.style.display = 'block';
        // Create slug from project name
        const slug = projectName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        backLinkAnchor.href = `/projects/${slug}/`;
        backLinkAnchor.textContent = `← Back to ${projectName}`;
      }
      
      // Update page title
      document.title = `Feedback: ${projectName} | ${import.meta.env.PUBLIC_SITE_TITLE || import.meta.env.PUBLIC_VILLAGE_DISPLAY_NAME || 'Smiths Lake Village'}`;
    }
  });
</script>
</BaseLayout>
