---
// News & Local Services Page
// Redesigned May 2026 — combines community news/updates with local services directory.
// News items are static placeholders until a Notion News database is wired up.
// Services section remains Notion-connected (fetchNotionContent 'Services').

import Layout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import { fetchNotionContent } from '../../lib/notion-unified.js';
import { fetchSectionSettingsBySlug } from '../../lib/notion-section-settings.js';
import { generateSlug } from '../../lib/notion-detail-pages.js';

// Fetch section settings (hero image, colours)
const sectionSettings = await fetchSectionSettingsBySlug('services');

// Load section hero image manifest
let sectionHeroManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const manifestPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(manifestPath)) {
    sectionHeroManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }
const heroImage = sectionHeroManifest['services'] || null;

// ── Static news items (placeholder until Notion News DB is connected) ─────────
const newsItems = [
  {
    title: 'Community Website Launched',
    date: new Date('2025-11-15'),
    category: 'Community',
    categoryColour: '#4db8b8',
    excerpt: 'VillageFirst — the new online home for Smiths Lake and Pacific Palms residents — is now live. Find local services, history, groups, and more in one place.',
    href: '/about/',
  },
  {
    title: 'Open Spaces & Recreation Strategy Underway',
    date: new Date('2025-11-01'),
    category: 'Council',
    categoryColour: '#5B9BD5',
    excerpt: 'MidCoast Council is developing an Open Spaces and Recreation Strategy. PPCA is gathering community input to shape a formal submission on behalf of residents.',
    href: '/projects/',
  },
  {
    title: 'Summer Fire Season — Stay Prepared',
    date: new Date('2025-12-01'),
    category: 'Emergency',
    categoryColour: '#DC2626',
    excerpt: 'The NSW Rural Fire Service urges residents to review their Bushfire Survival Plans before the peak fire season. Know your trigger, know your route.',
    href: '/emergency/',
  },
  {
    title: 'Estuary Monitoring Program Continues',
    date: new Date('2026-02-10'),
    category: 'Environment',
    categoryColour: '#16A34A',
    excerpt: 'Volunteers and researchers completed the latest round of Smiths Lake estuary health monitoring. Results continue to show healthy water quality and thriving birdlife.',
    href: '/environment/',
  },
];

// ── Notion Services ────────────────────────────────────────────────────────────
const items = await fetchNotionContent({ section: 'Services' });
const publishedItems = items.filter(item =>
  item.statusOnWeb ? item.statusOnWeb === 'Published' : true
);
---

<Layout
  title="News & Local Services"
  description="Community news, updates, and local services directory for Smiths Lake Village."
>
  <style>
    /* ── Page shell ─────────────────────────────────────────────────── */
    .page-wrap {
      background: #f7f9fc;
    }

    .content-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* ── Section titles ─────────────────────────────────────────────── */
    .section-block {
      padding: 3.5rem 0;
    }

    .section-block + .section-block {
      border-top: 2px solid #e5e9f0;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .section-label-text {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #4db8b8;
    }

    .section-label-line {
      flex: 1;
      height: 1px;
      background: #d1d5db;
    }

    .section-title {
      font-size: 1.75rem;
      font-weight: 800;
      color: #1B365D;
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }

    .section-subtitle {
      color: #6b7280;
      font-size: 1rem;
      margin-bottom: 2rem;
    }

    /* ── News cards ─────────────────────────────────────────────────── */
    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .news-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      text-decoration: none;
      color: inherit;
    }

    .news-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.13);
    }

    .news-card-accent {
      height: 4px;
      width: 100%;
      flex-shrink: 0;
    }

    .news-card-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .news-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.875rem;
    }

    .news-category {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      color: white;
    }

    .news-date {
      font-size: 0.8rem;
      color: #9ca3af;
    }

    .news-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #1B365D;
      margin-bottom: 0.625rem;
      line-height: 1.35;
    }

    .news-excerpt {
      font-size: 0.9rem;
      color: #4b5563;
      line-height: 1.65;
      flex: 1;
      margin-bottom: 1rem;
    }

    .news-read-more {
      font-size: 0.875rem;
      font-weight: 600;
      color: #4db8b8;
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin-top: auto;
    }

    .news-read-more svg {
      transition: transform 0.2s;
    }

    .news-card:hover .news-read-more svg {
      transform: translateX(3px);
    }

    /* ── News placeholder notice ────────────────────────────────────── */
    .news-notice {
      margin-top: 1.5rem;
      padding: 0.875rem 1.25rem;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
      font-size: 0.85rem;
      color: #166534;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ── Services section ───────────────────────────────────────────── */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .service-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      border-top: 4px solid #1B365D;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.14);
    }

    .clickable-card {
      cursor: pointer;
    }

    .service-card-inner {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .service-card-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1B365D;
      margin-bottom: 0.5rem;
    }

    .service-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.875rem;
    }

    .badge {
      display: inline-block;
      padding: 0.2rem 0.65rem;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      background: #DBEAFE;
      color: #1E40AF;
    }

    .service-description {
      font-size: 0.9rem;
      color: #4b5563;
      line-height: 1.65;
      flex: 1;
      margin-bottom: 1rem;
    }

    .service-meta {
      border-top: 1px solid #f3f4f6;
      padding-top: 0.875rem;
      margin-top: auto;
      font-size: 0.85rem;
    }

    .meta-row {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
      color: #6B7280;
    }

    .meta-label {
      font-weight: 600;
      color: #1B365D;
    }

    .service-links {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-top: 0.875rem;
    }

    .card-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s;
    }

    .card-link-detail {
      color: #4db8b8;
    }

    .card-link-detail:hover {
      color: #1B365D;
    }

    .card-link-external {
      color: #9ca3af;
      font-weight: 500;
    }

    .card-link-external:hover {
      color: #1B365D;
    }

    /* ── Empty state ────────────────────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      background: white;
      border-radius: 12px;
      border: 2px dashed #d1d5db;
      color: #6b7280;
    }

    .empty-state-icon {
      font-size: 2.5rem;
      margin-bottom: 0.75rem;
    }

    .empty-state h3 {
      font-size: 1.1rem;
      color: #1B365D;
      margin-bottom: 0.5rem;
    }

    .empty-state p {
      font-size: 0.9rem;
    }

    /* ── Feedback strip ─────────────────────────────────────────────── */
    .feedback-strip {
      background: linear-gradient(135deg, #1B365D 0%, #2d5a9e 100%);
      border-radius: 12px;
      padding: 2rem;
      display: flex;
      align-items: center;
      gap: 2rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .feedback-strip-text {
      flex: 1;
      min-width: 200px;
    }

    .feedback-strip-text h3 {
      color: white;
      font-size: 1.2rem;
      margin-bottom: 0.25rem;
    }

    .feedback-strip-text p {
      color: #93c5fd;
      font-size: 0.9rem;
    }

    .feedback-strip-btn {
      display: inline-block;
      background: #4db8b8;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s;
      white-space: nowrap;
    }

    .feedback-strip-btn:hover {
      background: #2d8b8b;
      transform: translateY(-2px);
    }

    /* ── Mobile ─────────────────────────────────────────────────────── */
    @media (max-width: 640px) {
      .news-grid,
      .services-grid {
        grid-template-columns: 1fr;
      }

      .feedback-strip {
        flex-direction: column;
        text-align: center;
        gap: 1.25rem;
      }
    }
  </style>

  <div class="page-wrap">
    <!-- Hero -->
    <SectionHero
      title="News & Local Services"
      subtitle="Community updates, local services, and everything you need to know about life in Smiths Lake Village."
      accentHex={sectionSettings?.accentHex || '#1B365D'}
      backgroundImage={heroImage}
      overlayOpacity={sectionSettings?.overlayOpacity ?? 50}
    />

    <div class="content-wrap">

      <!-- ── Latest News ─────────────────────────────────────────────── -->
      <section class="section-block" aria-labelledby="news-heading">
        <div class="section-label">
          <span class="section-label-text">Latest Updates</span>
          <span class="section-label-line" aria-hidden="true"></span>
        </div>
        <h2 class="section-title" id="news-heading">What's Happening</h2>
        <p class="section-subtitle">News, notices, and updates from around the village.</p>

        <div class="news-grid">
          {newsItems.map(item => (
            <a href={item.href} class="news-card" aria-label={`Read more: ${item.title}`}>
              <div class="news-card-accent" style={`background: ${item.categoryColour};`}></div>
              <div class="news-card-body">
                <div class="news-meta">
                  <span
                    class="news-category"
                    style={`background: ${item.categoryColour};`}
                  >{item.category}</span>
                  <span class="news-date">
                    {item.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                </div>
                <h3 class="news-title">{item.title}</h3>
                <p class="news-excerpt">{item.excerpt}</p>
                <span class="news-read-more">
                  Read more
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="news-notice" role="note">
          <span aria-hidden="true">🌱</span>
          These are placeholder updates while a Notion-connected news feed is being set up. Content will be managed directly from Notion.
        </div>
      </section>

      <!-- ── Local Services ──────────────────────────────────────────── -->
      <section class="section-block" aria-labelledby="services-heading">
        <div class="section-label">
          <span class="section-label-text">Directory</span>
          <span class="section-label-line" aria-hidden="true"></span>
        </div>
        <h2 class="section-title" id="services-heading">Local Services</h2>
        <p class="section-subtitle">Facilities, amenities, and local services available to residents and visitors.</p>

        {publishedItems.length > 0 ? (
          <div class="services-grid">
            {publishedItems.map(item => (
              <article
                class="service-card clickable-card"
                data-href={`/services/${item.slug || generateSlug(item.title)}/`}
                tabindex="0"
                role="link"
                aria-label={`View ${item.title}`}
              >
                <div class="service-card-inner">
                  <h3 class="service-card-title">{item.title}</h3>

                  {(item.category || (Array.isArray(item.status) && item.status.length > 0)) && (
                    <div class="service-badges">
                      {item.category && <span class="badge">{item.category}</span>}
                      {Array.isArray(item.status) && item.status.length > 0 && (
                        <span class="badge">{item.status[0]}</span>
                      )}
                    </div>
                  )}

                  {item.description && (
                    <p class="service-description">{item.description}</p>
                  )}

                  {(item.operatingHours || item.address || item.accessibilityInfo) && (
                    <div class="service-meta">
                      {item.operatingHours && (
                        <div class="meta-row">
                          <span aria-hidden="true">🕐</span>
                          <span><span class="meta-label">Hours:</span> {item.operatingHours}</span>
                        </div>
                      )}
                      {item.address && (
                        <div class="meta-row">
                          <span aria-hidden="true">📍</span>
                          <span><span class="meta-label">Location:</span> {item.address}</span>
                        </div>
                      )}
                      {item.accessibilityInfo && (
                        <div class="meta-row">
                          <span aria-hidden="true">♿</span>
                          <span><span class="meta-label">Accessibility:</span> {item.accessibilityInfo}</span>
                        </div>
                      )}
                    </div>
                  )}

                  <div class="service-links">
                    <a
                      href={`/services/${item.slug || generateSlug(item.title)}/`}
                      class="card-link card-link-detail"
                    >
                      View Details →
                    </a>
                    {(item.websiteUrl || item.documentUrl) && (
                      <a
                        href={item.websiteUrl || item.documentUrl}
                        class="card-link card-link-external"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.documentUrl ? 'View Document' : 'Visit Website'} ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state" role="note">
            <div class="empty-state-icon" aria-hidden="true">🏘️</div>
            <h3>Services directory coming soon</h3>
            <p>Local services will appear here once they've been added to the community database.</p>
          </div>
        )}

        <!-- Feedback strip -->
        <div class="feedback-strip">
          <div class="feedback-strip-text">
            <h3>Know of a local service we've missed?</h3>
            <p>Help us keep this directory accurate and useful for the whole community.</p>
          </div>
          <a href="/feedback/" class="feedback-strip-btn">Share a suggestion</a>
        </div>
      </section>

    </div>
  </div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.clickable-card').forEach(card => {
      const targetUrl = (card as HTMLElement).dataset.href;
      if (!targetUrl) return;
      card.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a, button, input, select, textarea')) return;
        window.location.href = targetUrl;
      });
      card.addEventListener('keydown', (event) => {
        if ((event as KeyboardEvent).key === 'Enter' && event.target === card) {
          window.location.href = targetUrl;
        }
      });
    });
  });
</script>
</Layout>
