---
// Services Index Page - DEBUG VERSION
import Layout from '../../layouts/BaseLayout.astro';
import { fetchItemsBySection } from '../../lib/notion-unified.js';

// Fetch all Services items
const items = await fetchItemsBySection('Services');

// Log to build output
console.log('=== SERVICES DEBUG ===');
console.log('Total items:', items.length);
items.forEach((item, index) => {
  console.log(`\nItem ${index + 1}:`, {
    title: item.title,
    section: item.section,
    category: item.category,
    status: item.status,
    serviceType: item.serviceType,
    showOnWebsite: item.showOnWebsite
  });
});
---

<Layout title="Services Debug">
  <div style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
    <h1>Services Debug Output</h1>
    <p>Total items fetched: {items.length}</p>
    
    <div style="margin-top: 2rem;">
      {items.map((item, index) => (
        <div style="background: white; padding: 1.5rem; margin-bottom: 1rem; border: 1px solid #ccc; border-radius: 8px;">
          <h3 style="margin: 0 0 1rem 0;">{index + 1}. {item.title}</h3>
          <pre style="background: #f5f5f5; padding: 1rem; overflow-x: auto; font-size: 0.875rem;">
{JSON.stringify(item, null, 2)}
          </pre>
        </div>
      ))}
    </div>
    
    {items.length === 0 && (
      <div style="background: #fee; padding: 2rem; border-radius: 8px; margin-top: 2rem;">
        <h2>No items found!</h2>
        <p>Check that items have:</p>
        <ul>
          <li>Section = "Services" (exact match)</li>
          <li>Show on Website = TRUE</li>
        </ul>
      </div>
    )}
  </div>
</Layout>
