---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const subSections = [
  {
    id: 'ppca',
    title: 'Pacific Palms Community Association (PPCA)',
    content: 'The PPCA is the peak community organisation representing residents of Smiths Lake Village and the surrounding Pacific Palms area. Established to give our community a collective voice, we work with MidCoast Council and other stakeholders on matters affecting our neighbourhood.',
  },
  {
    id: 'community-plan',
    title: 'Community Plan',
    content: 'Our Community Plan outlines the shared vision and priorities for Smiths Lake Village. Developed through extensive community consultation, it guides our advocacy and development efforts.',
  },
  {
    id: 'maps',
    title: 'Maps & Location',
    content: 'Smiths Lake Village is located in the Great Lakes region of NSW, approximately 300km north of Sydney. We\'re part of the MidCoast Council local government area and the Pacific Palms community.',
  },
  {
    id: 'demographics',
    title: 'Demographics',
    content: 'Based on ABS Census data, Smiths Lake has approximately 1,300 permanent residents. Our community includes a mix of families, retirees, and holiday homeowners who contribute to our vibrant village atmosphere.',
  },
];

const driveFolderId = '1cxYAx-Mm-ysdM_UU_0IRThVFUZ4w61bv';
---

<BaseLayout 
  title="About Us" 
  description="Learn about Smiths Lake Village, PPCA, our community plans, and what makes our coastal NSW community special."
>
  <Hero 
    title="About Us"
    subtitle="Discover what makes Smiths Lake Village a special place to live, work and visit."
    size="small"
  />
  
  <section class="section">
    <div class="container container--narrow">
      <div class="intro">
        <p class="lead">
          Smiths Lake Village is a vibrant coastal community nestled on the shores of 
          Smiths Lake in the Pacific Palms region of New South Wales. Our village combines 
          the natural beauty of pristine waterways and native bushland with a welcoming, 
          community-focused atmosphere.
        </p>
      </div>
      
      <div class="content-sections">
        {subSections.map((section) => (
          <article id={section.id} class="content-block">
            <h2>{section.title}</h2>
            <p>{section.content}</p>
          </article>
        ))}
      </div>
      
      <aside id="documents" class="documents-section">
        <h2>📁 Document Library</h2>
        <p>
          Access official PPCA documents, community plans, and reference materials. 
          Click any document to view or download.
        </p>
        
        <div class="drive-embed-container">
          <iframe 
            src={`https://drive.google.com/embeddedfolderview?id=${driveFolderId}#list`}
            class="drive-embed"
            title="About Us Documents"
            loading="lazy"
          ></iframe>
        </div>
        
        <p class="document-note">
          <em>Documents are managed by PPCA committee members. Files added to the Google Drive folder appear here automatically.</em>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-12);
  }
  
  .lead {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--color-gray-700);
  }
  
  .content-sections {
    margin-bottom: var(--space-12);
  }
  
  .content-block {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-gray-200);
  }
  
  .content-block:last-child {
    border-bottom: none;
  }
  
  .content-block h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }
  
  .content-block p {
    color: var(--color-gray-700);
    line-height: var(--leading-relaxed);
  }
  
  .documents-section {
    background-color: var(--color-off-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-sky);
  }
  
  .documents-section h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }
  
  .drive-embed-container {
    margin: var(--space-6) 0;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
  }
  
  .drive-embed {
    width: 100%;
    height: 400px;
    border: none;
  }
  
  .document-note {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-top: var(--space-4);
    margin-bottom: 0;
  }
</style>
