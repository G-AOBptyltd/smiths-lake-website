---
// Home Page - UPDATED 2026-02-24
// Updated: Section Settings integration for hero image management via Notion
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuickInfo from '../components/QuickInfo.astro';
import SectionCard from '../components/SectionCard.astro';
import WaterLevelTicker from '../components/WaterLevelTicker.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import { fetchSectionSettingsBySlug } from '../lib/notion-section-settings.js';
import { fetchNotionContent } from '../lib/notion-unified.js';
import { generateSlug, resolveItemUrl, getSectionColour, getSectionDisplayName } from '../lib/notion-detail-pages.js';
import { village } from '../config/village.js';

// Fetch home section settings (hero image, title, subtitle)
const sectionSettings = await fetchSectionSettingsBySlug('home');

// Load hero image manifest (downloaded at build time)
let sectionHeroManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const manifestPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(manifestPath)) {
    sectionHeroManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

// Card photo manifest (news thumbnails, keyed by slug)
let cardImageManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const cardPath = path.resolve(process.cwd(), 'public/images/cards/manifest.json');
  if (fs.existsSync(cardPath)) {
    cardImageManifest = JSON.parse(fs.readFileSync(cardPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

// Latest news strip — same rule as /news/: deliberate publishing only
let latestNews = [];
try {
  const allPublished = await fetchNotionContent({ requireShowOnWebsite: true });
  latestNews = allPublished
    .filter((item) => item.showInNewsFeed === true && item.publishDate)
    .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
    .map((item) => {
      const slug = item.slug || generateSlug(item.title);
      // Same resolver as the news feed — a Project Hub story shared into the
      // feed must land on /projects/<slug>/, not a fabricated /content/ path.
      return { ...item, _url: resolveItemUrl(item), _img: cardImageManifest[slug] || null };
    })
    // A story with no resolvable route is dropped rather than shown unlinked —
    // the strip has only three slots and a card that goes nowhere wastes one.
    // Filter BEFORE slice so dropping one promotes the next story instead of
    // leaving a gap.
    .filter((item) => !!item._url)
    .slice(0, 3);
} catch (e) { /* news strip is optional — never break the homepage */ }

// The news ticker sits on a dark navy (#1B365D) band. Section accent colours
// that are themselves dark — Project Hub / Services are navy (#1B365D), same as
// the band — render an invisible category label. Lift any too-dark accent toward
// white just for the ticker, so every category stays readable without changing
// the section colours used elsewhere on light backgrounds.
function tickerCatColour(section) {
  const hex = getSectionColour(section);
  const m = /^#?([0-9a-fA-F]{6})$/.exec(hex);
  if (!m) return hex;
  const n = parseInt(m[1], 16);
  const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b; // 0..255
  if (lum >= 90) return hex; // already bright enough on navy
  const lift = (c) => Math.round(c + (255 - c) * 0.55);
  return `rgb(${lift(r)}, ${lift(g)}, ${lift(b)})`;
}

// Use Notion hero image if available, otherwise fall back to existing local image
const heroImage = sectionHeroManifest['home'] || village.heroImage;
const heroTitle = sectionSettings?.heroTitle || village.heroTitle;
const heroSubtitle = sectionSettings?.heroSubtitle || village.heroSubtitle;
const overlayOpacity = sectionSettings?.overlayOpacity ?? 50;

const quickInfoItems = [
  { value: '~1,300', label: 'Permanent Residents' },
  { value: 'Great Lakes', label: 'NSW Region' },
  { value: 'MidCoast', label: 'Local Council' },
  { value: village.entityShort, label: 'Community Association' },
];

// Sections reordered to match new navigation menu
// Order: About Us → Project Hub → Environment → Services → Groups & Activities → History → Emergency & Safety
const sections = [
  {
    title: 'About Us',
    description: 'Learn about Smiths Lake Village, PPCA, our community plans, local demographics, and what makes our coastal community special.',
    href: '/about/',
    icon: 'about',
  },
  {
    title: 'Project Hub',
    description: 'Have your say on community projects. View current consultations, download documents, and submit feedback on initiatives affecting our village.',
    href: '/projects/',
    icon: 'projects',
  },
  {
    title: 'Environment & Conservation',
    description: 'Lake health monitoring, green space management, conservation initiatives, and environmental programs protecting our natural assets.',
    href: '/environment/',
    icon: 'environment',
  },
  {
    title: 'Services & Amenities',
    description: 'Medical services, existing amenities, and current developing projects including the Fire Station and Recreation Reserve.',
    href: '/services/',
    icon: 'services',
  },
  {
    title: 'Groups & Activities',
    description: 'Join our vibrant community groups including arts, fishing, gardening, and sporting clubs. Find volunteering opportunities.',
    href: '/groups/',
    icon: 'groups',
  },
  {
    title: 'History & Culture',
    description: 'Discover the rich history of Smiths Lake Village, the Worimi people\'s connection to country, and our local cultural heritage.',
    href: '/history/',
    icon: 'history',
  },
  {
    title: 'Emergency & Safety',
    description: 'Critical emergency contacts, evacuation plans, Bushfire Brigade, Surf Life Saving, and safety resources for our community.',
    href: '/emergency/',
    icon: 'emergency',
    variant: 'emergency' as const,
  },
];

---

<BaseLayout title="Home">
  <Hero 
    title={heroTitle}
    subtitle={heroSubtitle}
    backgroundImage={heroImage}
    overlayOpacity={overlayOpacity}
    size="large"
  />
  
  <QuickInfo items={quickInfoItems} />

  <!-- Live water level — slim ticker linking to the Environment page (env-gated: PUBLIC_WATER_WIDGET="off" hides it) -->
  {village.waterWidgetEnabled && (
    <section class="lake-ticker-section" aria-label={`${village.name} live water level`} style="padding: 1.75rem 0; background: var(--color-off-white);">
      <div class="container">
        <WaterLevelTicker refreshMinutes={90} />
      </div>
    </section>
  )}

  <!-- Latest from the Village — rolling news ticker (auto-feeds from the news system) -->
  {latestNews.length > 0 && (
    <section class="news-ticker" aria-label="Latest village news">
      <div class="ticker-label">
        <span class="ticker-dot" aria-hidden="true"></span>
        Village News
      </div>
      <div class="ticker-viewport">
        <div class="ticker-track">
          {[0, 1].map((copy) => (
            <div class="ticker-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {latestNews.map((item) => (
                <a href={item._url} class="ticker-item" tabindex={copy === 1 ? -1 : undefined}>
                  <span class="ticker-cat" style={`color: ${tickerCatColour(item.section)};`}>
                    {getSectionDisplayName(item.section)}
                  </span>
                  <span class="ticker-hed">{item.title}</span>
                  <span class="ticker-date">
                    {new Date(item.publishDate).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}
                  </span>
                  <span class="ticker-sep" aria-hidden="true">◆</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
      <a href="/news/" class="ticker-all">All news →</a>
    </section>
  )}

  <!-- News & Services Banner -->
  <section class="news-banner-section">
    <div class="container">
      <div class="news-banner">
        <div class="news-banner-icon" aria-hidden="true">📰</div>
        <div class="news-banner-body">
          <p class="news-banner-label">Stay informed</p>
          <h2 class="news-banner-heading">Village News</h2>
          <p class="news-banner-text">The latest news and updates from across the community — published by the community, for the community.</p>
        </div>
        <div class="news-banner-action">
          <a href="/news/" class="news-banner-btn">See what's happening →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who's supporting us this month — live supporters card -->
  <section class="supporters-banner-section">
    <div class="container">
      <a href="/supporters/" class="supporters-banner" id="supporters-banner" aria-label="See our community supporters">
        <div class="sb-icon" aria-hidden="true">🏆</div>
        <div class="sb-body">
          <p class="sb-label">Community heroes</p>
          <h2 class="sb-heading">Who's supporting us this month</h2>
          <p class="sb-text" id="sb-names">Cheers to the locals and businesses backing {village.name}.</p>
        </div>
        <div class="sb-action"><span class="sb-btn">See the board →</span></div>
      </a>
    </div>
  </section>

  <!-- Main Sections Grid -->
  <section class="section bg-off-white" aria-labelledby="explore-heading">
    <div class="container">
      <h2 id="explore-heading" class="text-center mb-8">Explore Our Community</h2>
      <div class="sections-grid">
        {sections.map((section) => {
          const heroKey = section.href.replace(/\//g, '');
          return (
            <SectionCard
              title={section.title}
              description={section.description}
              href={section.href}
              icon={section.icon}
              variant={section.variant}
              image={sectionHeroManifest[heroKey] || null}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Join Your Community</h2>
        <p class="cta-text">
          Become a {village.entityShort} member, or sign up free for community updates, events, and important announcements.
        </p>
        <a href="/membership/" class="btn btn--primary btn--lg">Membership &amp; Updates</a>
      </div>
    </div>
  </section>

  <!-- Community sponsors — renders nothing until a placement is live -->
  <SponsorStrip variant="band" />
</BaseLayout>

<style>
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }
  
  @media (min-width: 640px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .sections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  /* News & Services Banner */
  /* Latest from the Village — rolling ticker */
  .news-ticker {
    display: flex;
    align-items: stretch;
    background: var(--color-navy);
    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    overflow: hidden;
  }

  .ticker-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #4db8b8;
    color: white;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.8rem 1.1rem;
    white-space: nowrap;
    flex-shrink: 0;
    z-index: 2;
  }

  .ticker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
    animation: ticker-pulse 1.6s ease-in-out infinite;
  }

  @keyframes ticker-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .ticker-viewport {
    flex: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-width: 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 2rem, black calc(100% - 2rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 2rem, black calc(100% - 2rem), transparent 100%);
  }

  .ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: ticker-scroll var(--ticker-duration, 36s) linear infinite;
    will-change: transform;
  }

  .news-ticker:hover .ticker-track,
  .ticker-track:focus-within {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  .ticker-group { display: inline-flex; }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 0;
    text-decoration: none;
  }

  .ticker-cat {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ticker-hed {
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .ticker-item:hover .ticker-hed { color: #4db8b8; text-decoration: underline; }

  .ticker-date { color: rgba(255,255,255,0.55); font-size: 0.75rem; }

  .ticker-sep { color: rgba(255,255,255,0.3); font-size: 0.6rem; margin: 0 1.4rem; }

  .ticker-all {
    display: flex;
    align-items: center;
    padding: 0 1.1rem;
    background: rgba(255,255,255,0.08);
    color: white;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .ticker-all:hover { background: rgba(255,255,255,0.18); }

  @media (max-width: 640px) {
    .ticker-label { padding: 0.7rem 0.8rem; }
    .ticker-all { padding: 0 0.8rem; }
  }

  .news-banner-section {
    padding: var(--space-10) 0;
    background: #f0f7ff;
  }

  .news-banner {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, #1B365D 0%, #0c2d5a 60%, #4db8b8 100%);
    border-radius: 14px;
    padding: 2.5rem 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .news-banner-icon {
    font-size: 3.5rem;
    flex-shrink: 0;
    opacity: 0.9;
    line-height: 1;
  }

  .news-banner-body {
    flex: 1;
  }

  .news-banner-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4db8b8;
    margin-bottom: 0.4rem;
  }

  .news-banner-heading {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .news-banner-text {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0;
  }

  .news-banner-action {
    flex-shrink: 0;
  }

  .news-banner-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #4db8b8;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .news-banner-btn:hover {
    background: #2d8b8b;
  }

  @media (max-width: 640px) {
    .news-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .news-banner-icon { font-size: 2.5rem; }
  }

  /* Who's supporting us this month */
  .supporters-banner-section {
    padding: var(--space-10) 0;
    background: #fffdf5;
  }

  .supporters-banner {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, #b45309 0%, #d97706 45%, #f59e0b 100%);
    border-radius: 14px;
    padding: 2.25rem 2.5rem;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .supporters-banner:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(180,83,9,0.28); }

  .sb-icon { font-size: 3.2rem; flex-shrink: 0; line-height: 1; }
  .sb-body { flex: 1; min-width: 0; }
  .sb-label { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #fff7ed; margin-bottom: 0.35rem; }
  .sb-heading { font-size: clamp(1.2rem, 3vw, 1.65rem); font-weight: 800; color: #fff; margin-bottom: 0.4rem; line-height: 1.2; }
  .sb-text { font-size: 0.92rem; color: rgba(255,255,255,0.92); line-height: 1.5; margin: 0; }
  .sb-action { flex-shrink: 0; }
  .sb-btn { display: inline-block; padding: 0.75rem 1.5rem; background: #fff; color: #b45309; font-size: 0.9rem; font-weight: 800; border-radius: 8px; white-space: nowrap; }

  @media (max-width: 640px) {
    .supporters-banner { flex-direction: column; text-align: center; padding: 2rem 1.5rem; }
    .sb-icon { font-size: 2.6rem; }
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    padding: var(--space-16) 0;
  }
  
  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .cta-title {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .cta-text {
    color: var(--color-gray-200);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
  }
</style>

<script>
  // Live supporters — fill the "who's supporting us" card and sprinkle
  // shout-outs into the news ticker. Opt-in names only (server-enforced).

  // The ticker used a fixed 36s loop no matter how many items it held, so
  // once supporter shout-outs were appended each item's on-screen dwell time
  // shrank — SUPPORTER names scrolled past too fast to read and were only
  // catchable by hovering (hover pauses the scroll). Fix: hold a constant
  // px/sec speed by measuring the track and setting the duration explicitly,
  // recalculated once more after the supporter items are inserted.
  const TICKER_PX_PER_SEC = 45;
  const TICKER_MIN_DURATION = 14;

  function setTickerSpeed() {
    const track = document.querySelector('.ticker-track');
    const group = document.querySelector('.ticker-group');
    if (!track || !group) return;
    const groupWidth = group.getBoundingClientRect().width;
    if (!groupWidth) return;
    const duration = Math.max(groupWidth / TICKER_PX_PER_SEC, TICKER_MIN_DURATION);
    track.style.setProperty('--ticker-duration', duration + 's');
  }

  setTickerSpeed();

  const VILLAGE = import.meta.env.PUBLIC_VILLAGE_NAME || 'Smiths Lake';

  fetch('/api/contrib-supporters?village=' + encodeURIComponent(VILLAGE))
    .then((r) => r.json())
    .then((data) => {
      const supporters = (data && data.thisMonth) || [];

      // 1) Card text
      const names = document.getElementById('sb-names');
      if (names) {
        if (supporters.length) {
          const shown = supporters.slice(0, 3).map((s: any) => s.name);
          const extra = supporters.length - shown.length;
          let txt = shown.join(', ');
          if (extra > 0) txt += ` and ${extra} more`;
          names.textContent = `🎉 ${txt} — thank you!`;
        } else {
          names.textContent = 'Be the first to support ' + VILLAGE + ' this month — tap to find out how.';
        }
      }

      // 2) Ticker shout-outs — prepend to each ticker group if the ticker exists
      if (supporters.length) {
        const groups = document.querySelectorAll('.ticker-group');
        groups.forEach((group) => {
          supporters.slice(0, 5).reverse().forEach((s: any) => {
            const a = document.createElement('a');
            a.href = '/supporters/';
            a.className = 'ticker-item';
            // Astro scopes the <style> block, so its .ticker-* rules never reach
            // these JS-created nodes — inline the visible styles so the shout-out
            // matches the native ticker items (otherwise the headline renders in
            // the same navy as the ticker background and looks blank).
            a.style.cssText = 'display:inline-flex;align-items:center;gap:0.6rem;padding:0.8rem 0;text-decoration:none;';
            a.innerHTML =
              '<span class="ticker-cat" style="color:#f5a623;font-size:0.66rem;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;">SUPPORTER</span>' +
              '<span class="ticker-hed" style="color:#fff;font-size:0.9rem;font-weight:600;">🎉 Thanks ' + String(s.name).replace(/[<>&]/g, '') + '!</span>' +
              '<span class="ticker-sep" aria-hidden="true" style="color:rgba(255,255,255,0.3);font-size:0.6rem;margin:0 1.4rem;">◆</span>';
            group.insertBefore(a, group.firstChild);
          });
        });
        // Re-measure now that supporter items have been added so the ticker
        // doesn't speed up as more items are inserted.
        setTickerSpeed();
      }
    })
    .catch(() => { /* card keeps its default copy; ticker unchanged */ });
</script>

