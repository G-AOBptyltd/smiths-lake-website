---
// Home Page - UPDATED 2026-02-24
// Updated: Section Settings integration for hero image management via Notion
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuickInfo from '../components/QuickInfo.astro';
import SectionCard from '../components/SectionCard.astro';
import { fetchSectionSettingsBySlug } from '../lib/notion-section-settings.js';
import { fetchNotionContent } from '../lib/notion-unified.js';
import { generateSlug, getSectionPath, getSectionColour, getSectionDisplayName } from '../lib/notion-detail-pages.js';

// Fetch home section settings (hero image, title, subtitle)
const sectionSettings = await fetchSectionSettingsBySlug('home');

// Load hero image manifest (downloaded at build time)
let sectionHeroManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const manifestPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(manifestPath)) {
    sectionHeroManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

// Card photo manifest (news thumbnails, keyed by slug)
let cardImageManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const cardPath = path.resolve(process.cwd(), 'public/images/cards/manifest.json');
  if (fs.existsSync(cardPath)) {
    cardImageManifest = JSON.parse(fs.readFileSync(cardPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

// Latest news strip — same rule as /news/: deliberate publishing only
let latestNews = [];
try {
  const allPublished = await fetchNotionContent({ requireShowOnWebsite: true });
  latestNews = allPublished
    .filter((item) => item.showInNewsFeed === true && item.publishDate)
    .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
    .slice(0, 3)
    .map((item) => {
      const slug = item.slug || generateSlug(item.title);
      const url = item.section === 'News' ? `/news/${slug}/` : `/${getSectionPath(item.section)}/${slug}/`;
      return { ...item, _url: url, _img: cardImageManifest[slug] || null };
    });
} catch (e) { /* news strip is optional — never break the homepage */ }

// Use Notion hero image if available, otherwise fall back to existing local image
const heroImage = sectionHeroManifest['home'] || '/images/hero-smiths-lake.jpg';
const heroTitle = sectionSettings?.heroTitle || 'Welcome to Smiths Lake Village';
const heroSubtitle = sectionSettings?.heroSubtitle || 'A vibrant coastal community in the heart of Pacific Palms, NSW. Discover our pristine lake, native bushland, and welcoming neighbourhood.';
const overlayOpacity = sectionSettings?.overlayOpacity ?? 50;

const quickInfoItems = [
  { value: '~1,300', label: 'Permanent Residents' },
  { value: 'Great Lakes', label: 'NSW Region' },
  { value: 'MidCoast', label: 'Local Council' },
  { value: 'PPCA', label: 'Community Association' },
];

// Sections reordered to match new navigation menu
// Order: About Us → Project Hub → Environment → Services → Groups & Activities → History → Emergency & Safety
const sections = [
  {
    title: 'About Us',
    description: 'Learn about Smiths Lake Village, PPCA, our community plans, local demographics, and what makes our coastal community special.',
    href: '/about/',
    icon: 'about',
  },
  {
    title: 'Project Hub',
    description: 'Have your say on community projects. View current consultations, download documents, and submit feedback on initiatives affecting our village.',
    href: '/projects/',
    icon: 'projects',
  },
  {
    title: 'Environment & Conservation',
    description: 'Lake health monitoring, green space management, conservation initiatives, and environmental programs protecting our natural assets.',
    href: '/environment/',
    icon: 'environment',
  },
  {
    title: 'Services & Amenities',
    description: 'Medical services, existing amenities, and current developing projects including the Fire Station and Recreation Reserve.',
    href: '/services/',
    icon: 'services',
  },
  {
    title: 'Groups & Activities',
    description: 'Join our vibrant community groups including arts, fishing, gardening, and sporting clubs. Find volunteering opportunities.',
    href: '/groups/',
    icon: 'groups',
  },
  {
    title: 'History & Culture',
    description: 'Discover the rich history of Smiths Lake Village, the Worimi people\'s connection to country, and our local cultural heritage.',
    href: '/history/',
    icon: 'history',
  },
  {
    title: 'Emergency & Safety',
    description: 'Critical emergency contacts, evacuation plans, Bushfire Brigade, Surf Life Saving, and safety resources for our community.',
    href: '/emergency/',
    icon: 'emergency',
    variant: 'emergency' as const,
  },
];

---

<BaseLayout title="Home">
  <Hero 
    title={heroTitle}
    subtitle={heroSubtitle}
    backgroundImage={heroImage}
    overlayOpacity={overlayOpacity}
    size="large"
  />
  
  <QuickInfo items={quickInfoItems} />

  <!-- Latest from the Village (auto-feeds from the news system) -->
  {latestNews.length > 0 && (
    <section class="home-news-section" aria-labelledby="home-news-heading">
      <div class="container">
        <div class="home-news-header">
          <h2 id="home-news-heading">Latest from the Village</h2>
          <a href="/news/" class="home-news-all">All news →</a>
        </div>
        <div class="home-news-grid">
          {latestNews.map((item) => (
            <a href={item._url} class="home-news-card">
              <div
                class="home-news-photo"
                style={item._img
                  ? `background-image: url('${item._img}');`
                  : 'background: linear-gradient(135deg, #5B9BD5 0%, #1B365D 100%);'}
                aria-hidden="true"
              >
                {!item._img && <span class="home-news-emoji">📰</span>}
                <span class="home-news-chip" style={`background: ${getSectionColour(item.section)};`}>
                  {getSectionDisplayName(item.section)}
                </span>
              </div>
              <div class="home-news-body">
                <span class="home-news-date">
                  {new Date(item.publishDate).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
                </span>
                <h3 class="home-news-hed">{item.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Main Sections Grid -->
  <section class="section bg-off-white" aria-labelledby="explore-heading">
    <div class="container">
      <h2 id="explore-heading" class="text-center mb-8">Explore Our Community</h2>
      <div class="sections-grid">
        {sections.map((section) => {
          const heroKey = section.href.replace(/\//g, '');
          return (
            <SectionCard
              title={section.title}
              description={section.description}
              href={section.href}
              icon={section.icon}
              variant={section.variant}
              image={sectionHeroManifest[heroKey] || null}
            />
          );
        })}
      </div>
    </div>
  </section>
  
  <!-- News & Services Banner -->
  <section class="news-banner-section">
    <div class="container">
      <div class="news-banner">
        <div class="news-banner-icon" aria-hidden="true">📰</div>
        <div class="news-banner-body">
          <p class="news-banner-label">Stay informed</p>
          <h2 class="news-banner-heading">Village News</h2>
          <p class="news-banner-text">The latest news and updates from across the community — published by the community, for the community.</p>
        </div>
        <div class="news-banner-action">
          <a href="/news/" class="news-banner-btn">See what's happening →</a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Call to Action -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Stay Connected</h2>
        <p class="cta-text">
          Stay connected with community updates, events, and important announcements.
        </p>
        <a href="/newsletter/" class="btn btn--primary btn--lg">Stay Connected</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }
  
  @media (min-width: 640px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .sections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  /* News & Services Banner */
  /* Latest from the Village */
  .home-news-section {
    padding: var(--space-12) 0;
    background: var(--color-white);
  }

  .home-news-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 3px solid var(--color-navy);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .home-news-header h2 {
    font-size: var(--text-2xl);
    color: var(--color-navy);
    margin: 0;
  }

  .home-news-all {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-golden-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  .home-news-all:hover { color: var(--color-golden); }

  .home-news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-news-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .home-news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  .home-news-photo {
    position: relative;
    height: 170px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-news-emoji { font-size: 2.5rem; opacity: 0.4; }

  .home-news-chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.22rem 0.65rem;
    border-radius: 3px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: white;
  }

  .home-news-body { padding: 1rem 1.1rem 1.2rem; }

  .home-news-date {
    font-size: 0.72rem;
    color: var(--color-gray-500, #9ca3af);
    display: block;
    margin-bottom: 0.3rem;
  }

  .home-news-hed {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.35;
    margin: 0;
  }

  .home-news-card:hover .home-news-hed { color: #2d8b8b; }

  @media (max-width: 768px) {
    .home-news-grid { grid-template-columns: 1fr; }
  }

  .news-banner-section {
    padding: var(--space-10) 0;
    background: #f0f7ff;
  }

  .news-banner {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, #1B365D 0%, #0c2d5a 60%, #4db8b8 100%);
    border-radius: 14px;
    padding: 2.5rem 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .news-banner-icon {
    font-size: 3.5rem;
    flex-shrink: 0;
    opacity: 0.9;
    line-height: 1;
  }

  .news-banner-body {
    flex: 1;
  }

  .news-banner-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4db8b8;
    margin-bottom: 0.4rem;
  }

  .news-banner-heading {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .news-banner-text {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0;
  }

  .news-banner-action {
    flex-shrink: 0;
  }

  .news-banner-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #4db8b8;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .news-banner-btn:hover {
    background: #2d8b8b;
  }

  @media (max-width: 640px) {
    .news-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .news-banner-icon { font-size: 2.5rem; }
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    padding: var(--space-16) 0;
  }
  
  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .cta-title {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .cta-text {
    color: var(--color-gray-200);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
  }
</style>

