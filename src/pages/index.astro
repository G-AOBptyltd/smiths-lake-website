---
// Home Page - UPDATED 2026-02-24
// Updated: Section Settings integration for hero image management via Notion
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuickInfo from '../components/QuickInfo.astro';
import SectionCard from '../components/SectionCard.astro';
import { fetchSectionSettingsBySlug } from '../lib/notion-section-settings.js';

// Fetch home section settings (hero image, title, subtitle)
const sectionSettings = await fetchSectionSettingsBySlug('home');

// Load hero image manifest (downloaded at build time)
let sectionHeroManifest = {};
try {
  const fs = await import('fs');
  const path = await import('path');
  const manifestPath = path.resolve(process.cwd(), 'public/images/heroes/manifest.json');
  if (fs.existsSync(manifestPath)) {
    sectionHeroManifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  }
} catch (e) { /* manifest not yet generated */ }

// Use Notion hero image if available, otherwise fall back to existing local image
const heroImage = sectionHeroManifest['home'] || '/images/hero-smiths-lake.jpg';
const heroTitle = sectionSettings?.heroTitle || 'Welcome to Smiths Lake Village';
const heroSubtitle = sectionSettings?.heroSubtitle || 'A vibrant coastal community in the heart of Pacific Palms, NSW. Discover our pristine lake, native bushland, and welcoming neighbourhood.';
const overlayOpacity = sectionSettings?.overlayOpacity ?? 50;

const quickInfoItems = [
  { value: '~1,300', label: 'Permanent Residents' },
  { value: 'Great Lakes', label: 'NSW Region' },
  { value: 'MidCoast', label: 'Local Council' },
  { value: 'PPCA', label: 'Community Association' },
];

// Sections reordered to match new navigation menu
// Order: About Us → Project Hub → Environment → Services → Groups & Activities → History → Emergency & Safety
const sections = [
  {
    title: 'About Us',
    description: 'Learn about Smiths Lake Village, PPCA, our community plans, local demographics, and what makes our coastal community special.',
    href: '/about/',
    icon: 'about',
  },
  {
    title: 'Project Hub',
    description: 'Have your say on community projects. View current consultations, download documents, and submit feedback on initiatives affecting our village.',
    href: '/projects/',
    icon: 'projects',
  },
  {
    title: 'Environment & Conservation',
    description: 'Lake health monitoring, green space management, conservation initiatives, and environmental programs protecting our natural assets.',
    href: '/environment/',
    icon: 'environment',
  },
  {
    title: 'Services & Amenities',
    description: 'Medical services, existing amenities, and current developing projects including the Fire Station and Recreation Reserve.',
    href: '/services/',
    icon: 'services',
  },
  {
    title: 'Groups & Activities',
    description: 'Join our vibrant community groups including arts, fishing, gardening, and sporting clubs. Find volunteering opportunities.',
    href: '/groups/',
    icon: 'groups',
  },
  {
    title: 'History & Culture',
    description: 'Discover the rich history of Smiths Lake Village, the Worimi people\'s connection to country, and our local cultural heritage.',
    href: '/history/',
    icon: 'history',
  },
  {
    title: 'Emergency & Safety',
    description: 'Critical emergency contacts, evacuation plans, Bushfire Brigade, Surf Life Saving, and safety resources for our community.',
    href: '/emergency/',
    icon: 'emergency',
    variant: 'emergency' as const,
  },
];

---

<BaseLayout title="Home">
  <Hero 
    title={heroTitle}
    subtitle={heroSubtitle}
    backgroundImage={heroImage}
    overlayOpacity={overlayOpacity}
    size="large"
  />
  
  <QuickInfo items={quickInfoItems} />
  
  <!-- Main Sections Grid -->
  <section class="section bg-off-white" aria-labelledby="explore-heading">
    <div class="container">
      <h2 id="explore-heading" class="text-center mb-8">Explore Our Community</h2>
      <div class="sections-grid">
        {sections.map((section) => (
          <SectionCard 
            title={section.title}
            description={section.description}
            href={section.href}
            icon={section.icon}
            variant={section.variant}
          />
        ))}
      </div>
    </div>
  </section>
  
  <!-- News & Services Banner -->
  <section class="news-banner-section">
    <div class="container">
      <div class="news-banner">
        <div class="news-banner-icon" aria-hidden="true">📰</div>
        <div class="news-banner-body">
          <p class="news-banner-label">Stay informed</p>
          <h2 class="news-banner-heading">Village News</h2>
          <p class="news-banner-text">The latest news and updates from across the community — published by the community, for the community.</p>
        </div>
        <div class="news-banner-action">
          <a href="/news/" class="news-banner-btn">See what's happening →</a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Call to Action -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Stay Connected</h2>
        <p class="cta-text">
          Stay connected with community updates, events, and important announcements.
        </p>
        <a href="/newsletter/" class="btn btn--primary btn--lg">Stay Connected</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }
  
  @media (min-width: 640px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .sections-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  /* News & Services Banner */
  .news-banner-section {
    padding: var(--space-10) 0;
    background: #f0f7ff;
  }

  .news-banner {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, #1B365D 0%, #0c2d5a 60%, #4db8b8 100%);
    border-radius: 14px;
    padding: 2.5rem 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .news-banner-icon {
    font-size: 3.5rem;
    flex-shrink: 0;
    opacity: 0.9;
    line-height: 1;
  }

  .news-banner-body {
    flex: 1;
  }

  .news-banner-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4db8b8;
    margin-bottom: 0.4rem;
  }

  .news-banner-heading {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .news-banner-text {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0;
  }

  .news-banner-action {
    flex-shrink: 0;
  }

  .news-banner-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #4db8b8;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .news-banner-btn:hover {
    background: #2d8b8b;
  }

  @media (max-width: 640px) {
    .news-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .news-banner-icon { font-size: 2.5rem; }
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    padding: var(--space-16) 0;
  }
  
  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .cta-title {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .cta-text {
    color: var(--color-gray-200);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
  }
</style>

